@using School_Management_System.ViewModels.Student
@model List<AttendanceSummary>
@{
    ViewData["Title"] = "My Attendance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="fas fa-clipboard-check text-warning me-2"></i>My Attendance
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active">Attendance</li>
                </ol>
            </nav>
        </div>
        <span class="badge bg-warning fs-6 p-2">
            <i class="fas fa-percent me-1"></i> @ViewBag.OverallAttendance.ToString("F0")% Overall
        </span>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-chart-bar text-warning me-2"></i>
                            Attendance Summary by Class
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var attendance in Model)
                            {
                                var statusClass = attendance.Percentage >= 80 ? "success" :
                                (attendance.Percentage >= 60 ? "warning" : "danger");
                                var statusText = attendance.Percentage >= 80 ? "Good" :
                                (attendance.Percentage >= 60 ? "Fair" : "Poor");
                                <div class="col-md-6 col-lg-4">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h6 class="fw-bold">@attendance.ClassName</h6>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span>Attendance</span>
                                                <span>
                                                    <strong>@attendance.Percentage.ToString("F0")%</strong>
                                                    <span class="text-muted small ms-1">
                                                        (@attendance.PresentDays/@attendance.TotalDays)
                                                    </span>
                                                </span>
                                            </div>
                                            <div class="attendance-bar mt-2">
                                                <div class="fill @statusClass" style="width: @attendance.Percentage%;"></div>
                                            </div>
                                            <div class="mt-2">
                                                <span class="badge bg-@statusClass">@statusText</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Attendance Table -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-list text-warning me-2"></i>
                    Detailed Attendance Records
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="attendanceTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Class</th>
                                <th>Total Days</th>
                                <th>Present</th>
                                <th>Absent</th>
                                <th>Late</th>
                                <th>Excused</th>
                                <th>Percentage</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attendance in Model)
                            {
                                var statusClass = attendance.Percentage >= 80 ? "bg-success" :
                                (attendance.Percentage >= 60 ? "bg-warning" : "bg-danger");
                                var statusText = attendance.Percentage >= 80 ? "Good" :
                                (attendance.Percentage >= 60 ? "Fair" : "Poor");
                                <tr>
                                    <td>@(Model.IndexOf(attendance) + 1)</td>
                                    <td>@attendance.ClassName</td>
                                    <td>@attendance.TotalDays</td>
                                    <td>@attendance.PresentDays</td>
                                    <td>@(attendance.TotalDays - attendance.PresentDays)</td>
                                    <td>0</td>
                                    <td>0</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress" style="width: 80px; height: 6px;">
                                                <div class="progress-bar @statusClass" role="progressbar"
                                                     style="width: @attendance.Percentage%;"
                                                     aria-valuenow="@attendance.Percentage"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <span class="small">@attendance.Percentage.ToString("F0")%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @statusClass">@statusText</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-clipboard-check fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No Attendance Records</h4>
            <p class="text-muted">You have no attendance records available yet.</p>
        </div>
    }
</div>

<style>
    .attendance-bar {
        height: 8px;
        border-radius: 4px;
        background: #e9ecef;
        overflow: hidden;
    }

        .attendance-bar .fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
        }

            .attendance-bar .fill.success {
                background: #28a745;
            }

            .attendance-bar .fill.warning {
                background: #ffc107;
            }

            .attendance-bar .fill.danger {
                background: #dc3545;
            }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#attendanceTable').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search attendance..."
                },
                pageLength: 10,
                order: [[0, 'asc']]
            });
        });
    </script>
}