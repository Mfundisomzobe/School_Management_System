@using School_Management_System.ViewModels.Student
@model List<AttendanceSummary>
@{
    ViewData["Title"] = "My Attendance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ============================================
           MODERN ATTENDANCE STYLES
           ============================================ */

    /* ----- Animations ----- */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes floatOrb {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(30px, -30px) scale(1.1);
        }
    }

    .animate-in {
        animation: fadeInUp 0.6s ease forwards;
        opacity: 0;
    }

        .animate-in.delay-1 {
            animation-delay: 0.1s;
        }

        .animate-in.delay-2 {
            animation-delay: 0.2s;
        }

        .animate-in.delay-3 {
            animation-delay: 0.3s;
        }

        .animate-in.delay-4 {
            animation-delay: 0.4s;
        }

        .animate-in.delay-5 {
            animation-delay: 0.5s;
        }

    /* ----- Modern Header ----- */
    .page-header-modern {
        background: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #2d1b69 100%);
        border-radius: 20px;
        padding: 28px 32px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
    }

        .page-header-modern::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: rgba(245, 158, 11, 0.08);
            animation: floatOrb 8s ease-in-out infinite;
        }

        .page-header-modern::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: 10%;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(236, 72, 153, 0.05);
            animation: floatOrb 10s ease-in-out infinite reverse;
        }

        .page-header-modern .header-content {
            position: relative;
            z-index: 1;
        }

        .page-header-modern .avatar-wrapper {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
            font-weight: 700;
            box-shadow: 0 8px 30px rgba(245, 158, 11, 0.3);
            flex-shrink: 0;
        }

        .page-header-modern h1 {
            color: white;
            font-weight: 700;
            margin: 0;
            font-size: 1.6rem;
        }

        .page-header-modern .subtitle {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            margin: 4px 0 0;
        }

            .page-header-modern .subtitle i {
                margin-right: 4px;
            }

        .page-header-modern .badge-modern {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            padding: 8px 16px;
            border-radius: 12px;
            color: rgba(255,255,255,0.8);
            font-size: 0.8rem;
            border: 1px solid rgba(255,255,255,0.05);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .page-header-modern .badge-modern i {
                font-size: 0.9rem;
                opacity: 0.7;
            }

    /* ----- Stat Cards ----- */
    .stat-card-modern {
        padding: 20px 24px;
        border-radius: 16px;
        color: white;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: default;
        height: 100%;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
    }

        .stat-card-modern:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }

        .stat-card-modern .stat-icon {
            font-size: 2rem;
            opacity: 0.2;
            position: absolute;
            bottom: 12px;
            right: 16px;
            transition: all 0.3s ease;
        }

        .stat-card-modern:hover .stat-icon {
            transform: scale(1.1) rotate(-5deg);
            opacity: 0.3;
        }

        .stat-card-modern .stat-number {
            font-size: 2.4rem;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.5px;
            line-height: 1;
        }

        .stat-card-modern .stat-label {
            font-size: 0.85rem;
            opacity: 0.85;
            margin: 6px 0 0;
            font-weight: 500;
        }

        .stat-card-modern .stat-change {
            font-size: 0.7rem;
            margin-top: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(255,255,255,0.1);
            padding: 2px 12px;
            border-radius: 20px;
        }

            .stat-card-modern .stat-change.up {
                color: #4ade80;
            }

            .stat-card-modern .stat-change.down {
                color: #f87171;
            }

        .stat-card-modern.color-1 {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }

        .stat-card-modern.color-2 {
            background: linear-gradient(135deg, #06b6d4, #22d3ee);
        }

        .stat-card-modern.color-3 {
            background: linear-gradient(135deg, #22c55e, #4ade80);
        }

    /* ----- Attendance Bar ----- */
    .attendance-bar-modern {
        height: 8px;
        border-radius: 4px;
        background: #f0f2f5;
        overflow: hidden;
        margin-top: 6px;
    }

        .attendance-bar-modern .fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.8s ease;
        }

            .attendance-bar-modern .fill.good {
                background: linear-gradient(90deg, #22c55e, #4ade80);
            }

            .attendance-bar-modern .fill.fair {
                background: linear-gradient(90deg, #f59e0b, #fbbf24);
            }

            .attendance-bar-modern .fill.poor {
                background: linear-gradient(90deg, #ef4444, #f87171);
            }

    /* ----- Attendance Cards ----- */
    .attendance-card {
        border: none;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        overflow: hidden;
        background: white;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }

        .attendance-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.08);
        }

        .attendance-card .card-header-custom {
            padding: 14px 18px;
            border-bottom: 1px solid #f3f4f6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .attendance-card .card-header-custom .class-name {
                font-weight: 700;
                font-size: 0.95rem;
                color: #1a1a3e;
                margin: 0;
            }

        .attendance-card .card-body-custom {
            padding: 14px 18px;
        }

            .attendance-card .card-body-custom .stat-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 4px 0;
            }

                .attendance-card .card-body-custom .stat-row .label {
                    font-size: 0.8rem;
                    color: #6c757d;
                }

                .attendance-card .card-body-custom .stat-row .value {
                    font-weight: 600;
                    font-size: 0.85rem;
                }

    /* ----- Empty State ----- */
    .empty-state-modern {
        padding: 50px 20px;
        text-align: center;
    }

        .empty-state-modern .icon {
            font-size: 3.5rem;
            color: #d1d5db;
            margin-bottom: 16px;
        }

        .empty-state-modern h4 {
            color: #374151;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .empty-state-modern p {
            color: #6c757d;
            font-size: 0.85rem;
            max-width: 400px;
            margin: 0 auto;
        }

    /* ----- Responsive ----- */
    @@media (max-width: 991px) {
        .page-header-modern {
            padding: 24px;
        }

            .page-header-modern h1 {
                font-size: 1.4rem;
            }

        .stat-card-modern .stat-number {
            font-size: 2rem;
        }
    }

    @@media (max-width: 768px) {
        .page-header-modern {
            padding: 20px;
            border-radius: 16px;
        }

            .page-header-modern .avatar-wrapper {
                width: 48px;
                height: 48px;
                font-size: 20px;
            }

            .page-header-modern h1 {
                font-size: 1.2rem;
            }

            .page-header-modern .subtitle {
                font-size: 0.8rem;
            }

            .page-header-modern .badge-modern {
                font-size: 0.7rem;
                padding: 6px 12px;
            }

        .stat-card-modern {
            padding: 18px 20px;
        }

            .stat-card-modern .stat-number {
                font-size: 1.8rem;
            }

            .stat-card-modern .stat-label {
                font-size: 0.8rem;
            }

        .attendance-card .card-header-custom {
            padding: 12px 14px;
        }

        .attendance-card .card-body-custom {
            padding: 12px 14px;
        }
    }

    @@media (max-width: 576px) {
        .page-header-modern {
            padding: 16px;
            border-radius: 14px;
        }

            .page-header-modern .avatar-wrapper {
                width: 40px;
                height: 40px;
                font-size: 16px;
            }

            .page-header-modern h1 {
                font-size: 1rem;
            }

            .page-header-modern .subtitle {
                font-size: 0.7rem;
            }

            .page-header-modern .badge-modern {
                font-size: 0.6rem;
                padding: 4px 10px;
            }

        .stat-card-modern {
            padding: 14px 16px;
        }

            .stat-card-modern .stat-number {
                font-size: 1.5rem;
            }

            .stat-card-modern .stat-label {
                font-size: 0.75rem;
            }

            .stat-card-modern .stat-change {
                font-size: 0.6rem;
                padding: 1px 8px;
            }

            .stat-card-modern .stat-icon {
                font-size: 1.5rem;
                bottom: 8px;
                right: 12px;
            }

        .attendance-card .card-header-custom {
            padding: 10px 12px;
        }

            .attendance-card .card-header-custom .class-name {
                font-size: 0.85rem;
            }

        .attendance-card .card-body-custom {
            padding: 10px 12px;
        }

            .attendance-card .card-body-custom .stat-row .label {
                font-size: 0.7rem;
            }

            .attendance-card .card-body-custom .stat-row .value {
                font-size: 0.75rem;
            }

        .empty-state-modern {
            padding: 30px 16px;
        }

            .empty-state-modern .icon {
                font-size: 2.5rem;
            }

            .empty-state-modern h4 {
                font-size: 1rem;
            }

            .empty-state-modern p {
                font-size: 0.75rem;
            }
    }
</style>

<!-- ============================================
     PAGE HEADER
     ============================================ -->
<div class="page-header-modern animate-in">
    <div class="header-content">
        <div class="row align-items-center">
            <div class="col-md-7">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-wrapper">
                        <i class="fas fa-clipboard-check"></i>
                    </div>
                    <div>
                        <h1>My Attendance</h1>
                        <div class="subtitle">
                            <i class="fas fa-user"></i> @ViewBag.StudentName
                            <span class="mx-2">•</span>
                            <i class="fas fa-calendar-alt"></i> @DateTime.Now.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb" style="background: transparent; padding: 0; margin: 8px 0 0;">
                        <li class="breadcrumb-item"><a asp-action="Dashboard" style="color: rgba(255,255,255,0.5); text-decoration: none;">Dashboard</a></li>
                        <li class="breadcrumb-item active" style="color: rgba(255,255,255,0.7);">Attendance</li>
                    </ol>
                </nav>
            </div>
            <div class="col-md-5 mt-3 mt-md-0">
                <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                    <span class="badge-modern">
                        <i class="fas fa-percent"></i> @ViewBag.OverallAttendance.ToString("F0")% Overall
                    </span>
                    <span class="badge-modern">
                        <i class="fas fa-clock"></i> @DateTime.Now.ToString("HH:mm")
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     STATS CARDS
     ============================================ -->
@if (Model.Any())
{
    var totalClasses = Model.Count;
    var averageAttendance = Model.Average(a => a.Percentage);
    var totalDays = Model.Sum(a => a.TotalDays);
    var totalPresent = Model.Sum(a => a.PresentDays);

    <div class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-md-3 animate-in delay-1">
            <div class="stat-card-modern color-1">
                <div class="stat-icon"><i class="fas fa-chalkboard"></i></div>
                <div class="stat-number">@totalClasses</div>
                <div class="stat-label">Total Classes</div>
                <span class="stat-change up"><i class="fas fa-arrow-up"></i> Active</span>
            </div>
        </div>
        <div class="col-6 col-md-3 animate-in delay-2">
            <div class="stat-card-modern color-2">
                <div class="stat-icon"><i class="fas fa-percent"></i></div>
                <div class="stat-number">@averageAttendance.ToString("F0")%</div>
                <div class="stat-label">Average Attendance</div>
                <span class="stat-change up"><i class="fas fa-arrow-up"></i> Overall</span>
            </div>
        </div>
        <div class="col-6 col-md-3 animate-in delay-3">
            <div class="stat-card-modern color-3">
                <div class="stat-icon"><i class="fas fa-calendar-day"></i></div>
                <div class="stat-number">@totalDays</div>
                <div class="stat-label">Total Days</div>
                <span class="stat-change up"><i class="fas fa-arrow-up"></i> Recorded</span>
            </div>
        </div>
        <div class="col-6 col-md-3 animate-in delay-4">
            <div class="stat-card-modern color-1">
                <div class="stat-icon"><i class="fas fa-user-check"></i></div>
                <div class="stat-number">@totalPresent</div>
                <div class="stat-label">Days Present</div>
                <span class="stat-change up"><i class="fas fa-arrow-up"></i> Attended</span>
            </div>
        </div>
    </div>
}

<!-- ============================================
     ATTENDANCE SUMMARY
     ============================================ -->
@if (Model.Any())
{
    <div class="row mb-4 animate-in delay-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-chart-bar text-warning me-2"></i>Attendance Summary by Class
                        <span class="badge bg-secondary ms-2">@Model.Count</span>
                    </h5>
                </div>
                <div class="card-body pt-2 pb-4">
                    <div class="row g-3">
                        @foreach (var attendance in Model)
                        {
                            var statusClass = attendance.Percentage >= 80 ? "good" :
                            (attendance.Percentage >= 60 ? "fair" : "poor");
                            var statusText = attendance.Percentage >= 80 ? "Good" :
                            (attendance.Percentage >= 60 ? "Fair" : "Poor");
                            var statusBadge = attendance.Percentage >= 80 ? "success" :
                            (attendance.Percentage >= 60 ? "warning" : "danger");

                            <div class="col-md-6 col-lg-4">
                                <div class="attendance-card">
                                    <div class="card-header-custom">
                                        <span class="class-name">
                                            <i class="fas fa-chalkboard me-2 text-primary"></i>
                                            @attendance.ClassName
                                        </span>
                                        <span class="badge bg-@statusBadge">@statusText</span>
                                    </div>
                                    <div class="card-body-custom">
                                        <div class="stat-row">
                                            <span class="label">Attendance</span>
                                            <span class="value">
                                                @attendance.Percentage.ToString("F0")%
                                                <span class="text-muted small ms-1">
                                                    (@attendance.PresentDays/@attendance.TotalDays)
                                                </span>
                                            </span>
                                        </div>
                                        <div class="attendance-bar-modern">
                                            <div class="fill @statusClass" style="width: @attendance.Percentage%;"></div>
                                        </div>
                                        <div class="stat-row mt-2">
                                            <span class="label"><i class="fas fa-user-check text-success"></i> Present</span>
                                            <span class="value text-success">@attendance.PresentDays</span>
                                        </div>
                                        <div class="stat-row">
                                            <span class="label"><i class="fas fa-user-times text-danger"></i> Absent</span>
                                            <span class="value text-danger">@(attendance.TotalDays - attendance.PresentDays)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================
         DETAILED ATTENDANCE TABLE
         ============================================ -->
    <div class="row animate-in delay-1">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-list text-warning me-2"></i>Detailed Attendance Records
                        <span class="badge bg-secondary ms-2">@Model.Count</span>
                    </h5>
                </div>
                <div class="card-body pt-0 pb-4">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="attendanceTable">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th>Class</th>
                                    <th class="d-none d-sm-table-cell">Total Days</th>
                                    <th class="d-none d-sm-table-cell">Present</th>
                                    <th class="d-none d-md-table-cell">Absent</th>
                                    <th>Percentage</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var attendance in Model.OrderByDescending(a => a.Percentage))
                                {
                                    var statusClass = attendance.Percentage >= 80 ? "success" :
                                    (attendance.Percentage >= 60 ? "warning" : "danger");
                                    var statusText = attendance.Percentage >= 80 ? "Good" :
                                    (attendance.Percentage >= 60 ? "Fair" : "Poor");

                                    <tr>
                                        <td>@(Model.IndexOf(attendance) + 1)</td>
                                        <td>@attendance.ClassName</td>
                                        <td class="d-none d-sm-table-cell">@attendance.TotalDays</td>
                                        <td class="d-none d-sm-table-cell">@attendance.PresentDays</td>
                                        <td class="d-none d-md-table-cell">@(attendance.TotalDays - attendance.PresentDays)</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress" style="width: 80px; height: 6px;">
                                                    <div class="progress-bar bg-@statusClass" role="progressbar"
                                                         style="width: @attendance.Percentage%;"
                                                         aria-valuenow="@attendance.Percentage"
                                                         aria-valuemin="0"
                                                         aria-valuemax="100">
                                                    </div>
                                                </div>
                                                <span class="small fw-bold">@attendance.Percentage.ToString("F0")%</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-@statusClass">@statusText</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- ============================================
         EMPTY STATE
         ============================================ -->
    <div class="empty-state-modern animate-in delay-1">
        <div class="icon">
            <i class="fas fa-clipboard-check"></i>
        </div>
        <h4>No Attendance Records</h4>
        <p>You have no attendance records available yet. Your attendance will appear here once your teachers start marking attendance.</p>
        <a asp-action="Dashboard" class="btn btn-primary mt-3">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>
}

<!-- ============================================
     SCRIPTS
     ============================================ -->
@section Scripts {
    <script>
        $(document).ready(function() {
            // ============================================
            // DATATABLE
            // ============================================
            if ($('#attendanceTable').length > 0) {
                $('#attendanceTable').DataTable({
                    responsive: true,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search attendance...",
                        lengthMenu: "Show _MENU_ records",
                        info: "Showing _START_ to _END_ of _TOTAL_ records",
                        infoEmpty: "No records found",
                        infoFiltered: "(filtered from _MAX_ total records)"
                    },
                    pageLength: 10,
                    order: [[5, 'desc']],
                    columnDefs: [
                        { orderable: false, targets: [0, 6] }
                    ]
                });
            }

            // ============================================
            // STAT CARD HOVER EFFECT
            // ============================================
            $('.stat-card-modern').on('mouseenter', function() {
                var icon = $(this).find('.stat-icon');
                icon.css('transform', 'scale(1.2) rotate(-5deg)');
            }).on('mouseleave', function() {
                var icon = $(this).find('.stat-icon');
                icon.css('transform', 'scale(1) rotate(0deg)');
            });

            // ============================================
            // AUTO-HIDE ALERTS
            // ============================================
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });
    </script>
}