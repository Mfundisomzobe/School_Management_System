@using School_Management_System.ViewModels.Student
@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .stat-card {
        padding: 24px;
        border-radius: 16px;
        color: white;
        transition: all 0.3s ease;
        cursor: default;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .stat-card::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            pointer-events: none;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        }

        .stat-card .stat-icon {
            font-size: 2.5rem;
            opacity: 0.4;
            position: absolute;
            bottom: 15px;
            right: 20px;
        }

        .stat-card .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .stat-card .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
            margin: 0;
        }

    .grade-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-block;
        min-width: 35px;
        text-align: center;
    }

        .grade-badge.grade-a {
            background: #d4edda;
            color: #155724;
        }

        .grade-badge.grade-b {
            background: #d1ecf1;
            color: #0c5460;
        }

        .grade-badge.grade-c {
            background: #fff3cd;
            color: #856404;
        }

        .grade-badge.grade-d {
            background: #ffe5d0;
            color: #7b3f00;
        }

        .grade-badge.grade-f {
            background: #f8d7da;
            color: #721c24;
        }

        .grade-badge.grade-na {
            background: #e9ecef;
            color: #6c757d;
        }

    .attendance-bar {
        height: 8px;
        border-radius: 4px;
        background: #e9ecef;
        overflow: hidden;
        margin-top: 5px;
    }

        .attendance-bar .fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
        }

            .attendance-bar .fill.good {
                background: #28a745;
            }

            .attendance-bar .fill.fair {
                background: #ffc107;
            }

            .attendance-bar .fill.poor {
                background: #dc3545;
            }

    .quick-link-card {
        border: none;
        border-radius: 16px;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        height: 100%;
        display: block;
    }

        .quick-link-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.1);
            text-decoration: none;
            color: inherit;
        }

        .quick-link-card .card-body {
            padding: 24px;
            text-align: center;
        }

        .quick-link-card .action-icon {
            font-size: 2.5rem;
            margin-bottom: 12px;
            display: block;
        }

        .quick-link-card .action-title {
            font-weight: 600;
            font-size: 1rem;
        }

    .class-card {
        border: none;
        border-radius: 16px;
        transition: all 0.3s ease;
        height: 100%;
        overflow: hidden;
    }

        .class-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.1);
        }

        .class-card .class-header {
            padding: 16px 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

            .class-card .class-header .class-name {
                font-weight: 600;
                font-size: 1.1rem;
                margin: 0;
            }

        .class-card .class-body {
            padding: 16px 20px;
        }

            .class-card .class-body .class-info {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 6px 0;
                border-bottom: 1px solid #f0f2f5;
            }

                .class-card .class-body .class-info:last-child {
                    border-bottom: none;
                }

                .class-card .class-body .class-info .label {
                    color: #6c757d;
                    font-size: 0.85rem;
                }

                .class-card .class-body .class-info .value {
                    font-weight: 500;
                    font-size: 0.9rem;
                }

    .section-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #333;
        margin-bottom: 20px;
    }

        .section-title .badge {
            font-size: 0.8rem;
            margin-left: 10px;
        }

    @@media (max-width: 768px) {
        .stat-card .stat-number {
            font-size: 1.8rem;
        }

        .quick-link-card .action-icon {
            font-size: 2rem;
        }

        .class-card .class-header .class-name {
            font-size: 1rem;
        }
    }
</style>

<div class="container-fluid">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">
                        <i class="fas fa-user-graduate text-primary me-2"></i>
                        Student Dashboard
                    </h1>
                    <p class="text-muted mb-0">
                        <i class="fas fa-user me-1"></i>
                        Welcome, <strong>@ViewBag.StudentName</strong>
                        <span class="mx-2 text-muted">|</span>
                        <i class="fas fa-envelope me-1"></i> @ViewBag.StudentEmail
                    </p>
                </div>
                <div>
                    <span class="badge bg-primary fs-6 p-2">
                        <i class="fas fa-calendar-alt me-1"></i>
                        @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="stat-number">@Model.TotalClasses</div>
                <div class="stat-label">My Classes</div>
                <div class="stat-icon"><i class="fas fa-chalkboard"></i></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="stat-number">@Model.OverallGPA.ToString("F1")%</div>
                <div class="stat-label">Overall GPA</div>
                <div class="stat-icon"><i class="fas fa-graduation-cap"></i></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="stat-number">@Model.OverallAttendance.ToString("F0")%</div>
                <div class="stat-label">Attendance</div>
                <div class="stat-icon"><i class="fas fa-clipboard-check"></i></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <div class="stat-number">@Model.Enrollments.Count</div>
                <div class="stat-label">Enrollments</div>
                <div class="stat-icon"><i class="fas fa-users"></i></div>
            </div>
        </div>
    </div>

    <!-- Quick Links -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-md-3">
            <a asp-action="MyClasses" class="quick-link-card">
                <div class="card quick-link-card">
                    <div class="card-body">
                        <span class="action-icon"><i class="fas fa-chalkboard text-primary"></i></span>
                        <div class="action-title">My Classes</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="MyGrades" class="quick-link-card">
                <div class="card quick-link-card">
                    <div class="card-body">
                        <span class="action-icon"><i class="fas fa-graduation-cap text-success"></i></span>
                        <div class="action-title">My Grades</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="MyAttendance" class="quick-link-card">
                <div class="card quick-link-card">
                    <div class="card-body">
                        <span class="action-icon"><i class="fas fa-clipboard-check text-warning"></i></span>
                        <div class="action-title">Attendance</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="Profile" class="quick-link-card">
                <div class="card quick-link-card">
                    <div class="card-body">
                        <span class="action-icon"><i class="fas fa-user text-info"></i></span>
                        <div class="action-title">My Profile</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Grades Summary -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-graduation-cap text-success me-2"></i>
                        Grades Summary
                        <span class="badge bg-secondary ms-2">@Model.GradeSummary.Count</span>
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.GradeSummary.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Class</th>
                                        <th>Assessment</th>
                                        <th>Marks</th>
                                        <th>Grade</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var grade in Model.GradeSummary)
                                    {
                                        var gradeClass = grade.LetterGrade?.ToLower() ?? "na";
                                        <tr>
                                            <td>@grade.ClassName</td>
                                            <td>@grade.AssessmentName</td>
                                            <td>@(grade.Marks.HasValue? grade.Marks.Value.ToString("F1") : "-")</td>
                                            <td>
                                                <span class="grade-badge grade-@gradeClass">
                                                    @(grade.LetterGrade ?? "N/A")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No grades available yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Summary -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-clipboard-check text-warning me-2"></i>
                        Attendance Summary
                        <span class="badge bg-secondary ms-2">@Model.AttendanceSummary.Count</span>
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.AttendanceSummary.Any())
                    {
                        <div class="row g-3">
                            @foreach (var attendance in Model.AttendanceSummary)
                            {
                                var statusClass = attendance.Percentage >= 80 ? "good" : (attendance.Percentage >= 60 ? "fair" : "poor");
                                <div class="col-md-6 col-lg-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>@attendance.ClassName</span>
                                        <span>
                                            <strong>@attendance.Percentage.ToString("F0")%</strong>
                                            <span class="text-muted small">(@attendance.PresentDays/@attendance.TotalDays)</span>
                                        </span>
                                    </div>
                                    <div class="attendance-bar">
                                        <div class="fill @statusClass" style="width: @attendance.Percentage%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                            <p class="text-muted">No attendance records available.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Classes -->
    <div class="row">
        <div class="col-12">
            <h5 class="fw-bold mb-3">
                <i class="fas fa-chalkboard text-primary me-2"></i>
                My Classes
                <span class="badge bg-secondary ms-2">@Model.Enrollments.Count</span>
            </h5>
            <hr />
        </div>
    </div>

    @if (Model.Enrollments.Any())
    {
        <div class="row g-4">
            @foreach (var enrollment in Model.Enrollments.Take(4))
            {
                var grade = enrollment.Grades.FirstOrDefault();
                var gradeClass = grade?.LetterGrade?.ToLower() ?? "na";
                <div class="col-md-6 col-lg-3">
                    <div class="card class-card">
                        <div class="class-header">
                            <div class="class-name">
                                <i class="fas fa-chalkboard me-2"></i>
                                @enrollment.Class.ClassName
                            </div>
                        </div>
                        <div class="class-body">
                            <div class="class-info">
                                <span class="label">Course</span>
                                <span class="value">@enrollment.Class.Course?.CourseName</span>
                            </div>
                            <div class="class-info">
                                <span class="label">Teacher</span>
                                <span class="value">@enrollment.Class.Teacher?.User?.FullName</span>
                            </div>
                            <div class="class-info">
                                <span class="label">Grade</span>
                                <span class="value">
                                    @if (grade != null)
                                    {
                                        <span class="grade-badge grade-@gradeClass">@grade.LetterGrade</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not graded</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-chalkboard fa-4x text-muted mb-3"></i>
            <h5 class="text-muted">No Classes Enrolled</h5>
            <p class="text-muted">You are not enrolled in any classes yet.</p>
        </div>
    }
</div>