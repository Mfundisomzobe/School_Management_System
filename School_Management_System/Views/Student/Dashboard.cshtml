@using School_Management_System.ViewModels.Student
@model StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ============================================
           MODERN STUDENT DASHBOARD STYLES
           ============================================ */

    /* ----- Animations ----- */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes floatOrb {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(30px, -30px) scale(1.1);
        }
    }

    .animate-in {
        animation: fadeInUp 0.6s ease forwards;
        opacity: 0;
    }

        .animate-in.delay-1 {
            animation-delay: 0.1s;
        }

        .animate-in.delay-2 {
            animation-delay: 0.2s;
        }

        .animate-in.delay-3 {
            animation-delay: 0.3s;
        }

        .animate-in.delay-4 {
            animation-delay: 0.4s;
        }

        .animate-in.delay-5 {
            animation-delay: 0.5s;
        }

        .animate-in.delay-6 {
            animation-delay: 0.6s;
        }

    /* ----- Modern Header ----- */
    .dashboard-header-modern {
        background: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #2d1b69 100%);
        border-radius: 20px;
        padding: 28px 32px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
    }

        .dashboard-header-modern::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.08);
            animation: floatOrb 8s ease-in-out infinite;
        }

        .dashboard-header-modern::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: 10%;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(236, 72, 153, 0.05);
            animation: floatOrb 10s ease-in-out infinite reverse;
        }

        .dashboard-header-modern .header-content {
            position: relative;
            z-index: 1;
        }

        .dashboard-header-modern .avatar-wrapper {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
            font-weight: 700;
            box-shadow: 0 8px 30px rgba(99, 102, 241, 0.3);
            flex-shrink: 0;
        }

        .dashboard-header-modern h1 {
            color: white;
            font-weight: 700;
            margin: 0;
            font-size: 1.6rem;
        }

        .dashboard-header-modern .subtitle {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            margin: 4px 0 0;
        }

            .dashboard-header-modern .subtitle i {
                margin-right: 4px;
            }

        .dashboard-header-modern .badge-modern {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            padding: 8px 16px;
            border-radius: 12px;
            color: rgba(255,255,255,0.8);
            font-size: 0.8rem;
            border: 1px solid rgba(255,255,255,0.05);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .dashboard-header-modern .badge-modern i {
                font-size: 0.9rem;
                opacity: 0.7;
            }

    /* ----- Stat Cards ----- */
    .stat-card-modern {
        padding: 22px 24px;
        border-radius: 16px;
        color: white;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: default;
        height: 100%;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
    }

        .stat-card-modern:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }

        .stat-card-modern .stat-icon {
            font-size: 2rem;
            opacity: 0.2;
            position: absolute;
            bottom: 12px;
            right: 16px;
            transition: all 0.3s ease;
        }

        .stat-card-modern:hover .stat-icon {
            transform: scale(1.1) rotate(-5deg);
            opacity: 0.3;
        }

        .stat-card-modern .stat-number {
            font-size: 2.4rem;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.5px;
            line-height: 1;
        }

        .stat-card-modern .stat-label {
            font-size: 0.85rem;
            opacity: 0.85;
            margin: 6px 0 0;
            font-weight: 500;
        }

        .stat-card-modern .stat-change {
            font-size: 0.7rem;
            margin-top: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(255,255,255,0.1);
            padding: 2px 12px;
            border-radius: 20px;
        }

            .stat-card-modern .stat-change.up {
                color: #4ade80;
            }

            .stat-card-modern .stat-change.down {
                color: #f87171;
            }

        .stat-card-modern.color-1 {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
        }

        .stat-card-modern.color-2 {
            background: linear-gradient(135deg, #ec4899, #f472b6);
        }

        .stat-card-modern.color-3 {
            background: linear-gradient(135deg, #06b6d4, #22d3ee);
        }

        .stat-card-modern.color-4 {
            background: linear-gradient(135deg, #22c55e, #4ade80);
        }

    /* ----- Quick Actions ----- */
    .quick-actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 12px;
    }

    .quick-action-btn {
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid #f0f2f5;
        background: white;
        text-align: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        text-decoration: none;
        color: #1a1a3e;
        font-weight: 500;
        font-size: 0.85rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

        .quick-action-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.08);
            border-color: #6366f1;
            text-decoration: none;
            color: #1a1a3e;
        }

        .quick-action-btn .icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        .quick-action-btn:hover .icon-wrapper {
            transform: scale(1.05);
        }

        .quick-action-btn .icon-wrapper.purple {
            background: rgba(99, 102, 241, 0.1);
            color: #6366f1;
        }

        .quick-action-btn .icon-wrapper.green {
            background: rgba(34, 197, 94, 0.1);
            color: #22c55e;
        }

        .quick-action-btn .icon-wrapper.yellow {
            background: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
        }

        .quick-action-btn .icon-wrapper.blue {
            background: rgba(6, 182, 212, 0.1);
            color: #06b6d4;
        }

        .quick-action-btn .icon-wrapper.red {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .quick-action-btn .action-title {
            font-weight: 600;
            font-size: 0.85rem;
        }

        .quick-action-btn .action-desc {
            font-size: 0.7rem;
            color: #9ca3af;
            margin: 0;
        }

    /* ----- Grade Badges ----- */
    .grade-badge-modern {
        padding: 5px 14px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.8rem;
        display: inline-block;
        min-width: 40px;
        text-align: center;
    }

        .grade-badge-modern.grade-a {
            background: #d4edda;
            color: #155724;
        }

        .grade-badge-modern.grade-b {
            background: #d1ecf1;
            color: #0c5460;
        }

        .grade-badge-modern.grade-c {
            background: #fff3cd;
            color: #856404;
        }

        .grade-badge-modern.grade-d {
            background: #ffe5d0;
            color: #7b3f00;
        }

        .grade-badge-modern.grade-f {
            background: #f8d7da;
            color: #721c24;
        }

        .grade-badge-modern.grade-na {
            background: #e9ecef;
            color: #6c757d;
        }

    /* ----- Attendance Bar ----- */
    .attendance-bar-modern {
        height: 6px;
        border-radius: 3px;
        background: #f0f2f5;
        overflow: hidden;
        margin-top: 4px;
    }

        .attendance-bar-modern .fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.8s ease;
        }

            .attendance-bar-modern .fill.good {
                background: linear-gradient(90deg, #22c55e, #4ade80);
            }

            .attendance-bar-modern .fill.fair {
                background: linear-gradient(90deg, #f59e0b, #fbbf24);
            }

            .attendance-bar-modern .fill.poor {
                background: linear-gradient(90deg, #ef4444, #f87171);
            }

    /* ----- Class Cards ----- */
    .class-card-modern {
        border: none;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        overflow: hidden;
        background: white;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }

        .class-card-modern:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.08);
        }

        .class-card-modern .class-header {
            padding: 14px 18px;
            color: white;
            position: relative;
            overflow: hidden;
        }

            .class-card-modern .class-header::after {
                content: '';
                position: absolute;
                top: -50%;
                right: -20%;
                width: 120px;
                height: 120px;
                border-radius: 50%;
                background: rgba(255,255,255,0.05);
                pointer-events: none;
            }

            .class-card-modern .class-header .class-name {
                font-weight: 700;
                font-size: 1rem;
                margin: 0;
                position: relative;
                z-index: 1;
            }

        .class-card-modern .class-body {
            padding: 14px 18px;
        }

            .class-card-modern .class-body .class-info {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 4px 0;
                border-bottom: 1px solid #f3f4f6;
            }

                .class-card-modern .class-body .class-info:last-child {
                    border-bottom: none;
                }

                .class-card-modern .class-body .class-info .label {
                    color: #6c757d;
                    font-size: 0.75rem;
                    display: flex;
                    align-items: center;
                    gap: 4px;
                }

                    .class-card-modern .class-body .class-info .label i {
                        font-size: 0.7rem;
                        color: #9ca3af;
                    }

                .class-card-modern .class-body .class-info .value {
                    font-weight: 500;
                    font-size: 0.8rem;
                }

    /* ----- Empty State ----- */
    .empty-state-modern {
        padding: 50px 20px;
        text-align: center;
    }

        .empty-state-modern .icon {
            font-size: 3.5rem;
            color: #d1d5db;
            margin-bottom: 16px;
        }

        .empty-state-modern h4 {
            color: #374151;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .empty-state-modern p {
            color: #6c757d;
            font-size: 0.85rem;
            max-width: 400px;
            margin: 0 auto;
        }

    /* ----- Responsive ----- */
    @@media (max-width: 991px) {
        .dashboard-header-modern {
            padding: 24px;
        }

            .dashboard-header-modern h1 {
                font-size: 1.4rem;
            }

        .stat-card-modern .stat-number {
            font-size: 2rem;
        }

        .quick-actions-grid {
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .dashboard-header-modern {
            padding: 20px;
            border-radius: 16px;
        }

            .dashboard-header-modern .avatar-wrapper {
                width: 48px;
                height: 48px;
                font-size: 20px;
            }

            .dashboard-header-modern h1 {
                font-size: 1.2rem;
            }

            .dashboard-header-modern .subtitle {
                font-size: 0.8rem;
            }

            .dashboard-header-modern .badge-modern {
                font-size: 0.7rem;
                padding: 6px 12px;
            }

        .stat-card-modern {
            padding: 18px 20px;
        }

            .stat-card-modern .stat-number {
                font-size: 1.8rem;
            }

            .stat-card-modern .stat-label {
                font-size: 0.8rem;
            }

        .quick-actions-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
        }

        .quick-action-btn {
            padding: 12px 14px;
            font-size: 0.8rem;
        }

            .quick-action-btn .icon-wrapper {
                width: 38px;
                height: 38px;
                font-size: 1rem;
            }

        .class-card-modern .class-header {
            padding: 12px 14px;
        }

            .class-card-modern .class-header .class-name {
                font-size: 0.9rem;
            }

        .class-card-modern .class-body {
            padding: 10px 14px;
        }
    }

    @@media (max-width: 576px) {
        .dashboard-header-modern {
            padding: 16px;
            border-radius: 14px;
        }

            .dashboard-header-modern .avatar-wrapper {
                width: 40px;
                height: 40px;
                font-size: 16px;
            }

            .dashboard-header-modern h1 {
                font-size: 1rem;
            }

            .dashboard-header-modern .subtitle {
                font-size: 0.7rem;
            }

            .dashboard-header-modern .badge-modern {
                font-size: 0.6rem;
                padding: 4px 10px;
            }

        .stat-card-modern {
            padding: 14px 16px;
        }

            .stat-card-modern .stat-number {
                font-size: 1.5rem;
            }

            .stat-card-modern .stat-label {
                font-size: 0.75rem;
            }

            .stat-card-modern .stat-change {
                font-size: 0.6rem;
                padding: 1px 8px;
            }

            .stat-card-modern .stat-icon {
                font-size: 1.5rem;
                bottom: 8px;
                right: 12px;
            }

        .quick-actions-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 6px;
        }

        .quick-action-btn {
            padding: 10px 8px;
            font-size: 0.7rem;
            border-radius: 10px;
        }

            .quick-action-btn .icon-wrapper {
                width: 32px;
                height: 32px;
                font-size: 0.9rem;
                border-radius: 8px;
            }

            .quick-action-btn .action-title {
                font-size: 0.75rem;
            }

            .quick-action-btn .action-desc {
                font-size: 0.6rem;
            }

        .class-card-modern .class-header {
            padding: 10px 12px;
        }

            .class-card-modern .class-header .class-name {
                font-size: 0.8rem;
            }

        .class-card-modern .class-body {
            padding: 8px 12px;
        }

            .class-card-modern .class-body .class-info {
                padding: 3px 0;
            }

                .class-card-modern .class-body .class-info .label {
                    font-size: 0.65rem;
                }

                .class-card-modern .class-body .class-info .value {
                    font-size: 0.7rem;
                }

        .grade-badge-modern {
            font-size: 0.7rem;
            padding: 3px 10px;
            min-width: 30px;
        }

        .empty-state-modern {
            padding: 30px 16px;
        }

            .empty-state-modern .icon {
                font-size: 2.5rem;
            }

            .empty-state-modern h4 {
                font-size: 1rem;
            }

            .empty-state-modern p {
                font-size: 0.75rem;
            }
    }

    @@media (max-width: 400px) {
        .dashboard-header-modern h1 {
            font-size: 0.9rem;
        }

        .quick-actions-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<!-- ============================================
     HEADER
     ============================================ -->
<div class="dashboard-header-modern animate-in">
    <div class="header-content">
        <div class="row align-items-center">
            <div class="col-md-7">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-wrapper">
                        @{
                            var initial = ViewBag.StudentName?.ToString().Substring(0, 1).ToUpper() ?? "S";
                        }
                        @initial
                    </div>
                    <div>
                        <h1>Welcome, @ViewBag.StudentName</h1>
                        <div class="subtitle">
                            <i class="fas fa-envelope"></i> @ViewBag.StudentEmail
                            <span class="mx-2">•</span>
                            <i class="fas fa-calendar-alt"></i> @DateTime.Now.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-5 mt-3 mt-md-0">
                <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                    <span class="badge-modern">
                        <i class="fas fa-user-graduate"></i> Student
                    </span>
                    <span class="badge-modern">
                        <i class="fas fa-id-badge"></i> @Model.Student.AdmissionNumber
                    </span>
                    <span class="badge-modern">
                        <i class="fas fa-clock"></i> @DateTime.Now.ToString("HH:mm")
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     STATS CARDS - FIXED WITH DIRECT VALUES
     ============================================ -->
<div class="row g-3 g-md-4 mb-4">
    <div class="col-6 col-md-3 animate-in delay-1">
        <div class="stat-card-modern color-1">
            <div class="stat-icon"><i class="fas fa-chalkboard"></i></div>
            <div class="stat-number">@Model.TotalClasses</div>
            <div class="stat-label">My Classes</div>
            <span class="stat-change up"><i class="fas fa-arrow-up"></i> Active</span>
        </div>
    </div>
    <div class="col-6 col-md-3 animate-in delay-2">
        <div class="stat-card-modern color-2">
            <div class="stat-icon"><i class="fas fa-graduation-cap"></i></div>
            <div class="stat-number">@Model.OverallGPA.ToString("F1")%</div>
            <div class="stat-label">Overall GPA</div>
            <span class="stat-change up"><i class="fas fa-arrow-up"></i> Average</span>
        </div>
    </div>
    <div class="col-6 col-md-3 animate-in delay-3">
        <div class="stat-card-modern color-3">
            <div class="stat-icon"><i class="fas fa-clipboard-check"></i></div>
            <div class="stat-number">@Model.OverallAttendance.ToString("F0")%</div>
            <div class="stat-label">Attendance</div>
            <span class="stat-change up"><i class="fas fa-arrow-up"></i> Overall</span>
        </div>
    </div>
    <div class="col-6 col-md-3 animate-in delay-4">
        <div class="stat-card-modern color-4">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-number">@Model.Enrollments.Count</div>
            <div class="stat-label">Enrollments</div>
            <span class="stat-change up"><i class="fas fa-arrow-up"></i> Total</span>
        </div>
    </div>
</div>

<!-- ============================================
     QUICK ACTIONS
     ============================================ -->
<div class="row mb-4 animate-in delay-5">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-3 p-md-4">
                <h6 class="fw-bold mb-3">
                    <i class="fas fa-bolt text-warning me-2"></i>Quick Actions
                </h6>
                <div class="quick-actions-grid">
                    <a asp-action="MyClasses" class="quick-action-btn">
                        <span class="icon-wrapper purple"><i class="fas fa-chalkboard"></i></span>
                        <span class="action-title">My Classes</span>
                        <span class="action-desc">View schedule</span>
                    </a>
                    <a asp-action="MyGrades" class="quick-action-btn">
                        <span class="icon-wrapper green"><i class="fas fa-graduation-cap"></i></span>
                        <span class="action-title">My Grades</span>
                        <span class="action-desc">Check marks</span>
                    </a>
                    <a asp-action="MyAttendance" class="quick-action-btn">
                        <span class="icon-wrapper yellow"><i class="fas fa-clipboard-check"></i></span>
                        <span class="action-title">Attendance</span>
                        <span class="action-desc">View records</span>
                    </a>
                    <a asp-action="Profile" class="quick-action-btn">
                        <span class="icon-wrapper blue"><i class="fas fa-user"></i></span>
                        <span class="action-title">My Profile</span>
                        <span class="action-desc">Personal info</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     GRADES SUMMARY
     ============================================ -->
<div class="row mb-4 animate-in delay-6">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-graduation-cap text-success me-2"></i>Grades Summary
                        <span class="badge bg-secondary ms-2">@Model.GradeSummary.Count</span>
                    </h5>
                    <a asp-action="MyGrades" class="btn btn-sm btn-outline-primary">
                        View All <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="card-body pt-0">
                @if (Model.GradeSummary.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Class</th>
                                    <th>Assessment</th>
                                    <th>Marks</th>
                                    <th>Grade</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var grade in Model.GradeSummary)
                                {
                                    var gradeClass = grade.LetterGrade?.ToLower() ?? "na";
                                    <tr>
                                        <td>@grade.ClassName</td>
                                        <td>@grade.AssessmentName</td>
                                        <td>@(grade.Marks.HasValue? grade.Marks.Value.ToString("F1") : "-")</td>
                                        <td>
                                            <span class="grade-badge-modern grade-@gradeClass">
                                                @(grade.LetterGrade ?? "N/A")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No grades available yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     ATTENDANCE SUMMARY
     ============================================ -->
<div class="row mb-4 animate-in delay-1">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-clipboard-check text-warning me-2"></i>Attendance Summary
                        <span class="badge bg-secondary ms-2">@Model.AttendanceSummary.Count</span>
                    </h5>
                    <a asp-action="MyAttendance" class="btn btn-sm btn-outline-primary">
                        View All <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="card-body pt-0">
                @if (Model.AttendanceSummary.Any())
                {
                    <div class="row g-3">
                        @foreach (var attendance in Model.AttendanceSummary)
                        {
                            var statusClass = attendance.Percentage >= 80 ? "good" : (attendance.Percentage >= 60 ? "fair" : "poor");
                            <div class="col-md-6 col-lg-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="small">@attendance.ClassName</span>
                                    <span>
                                        <strong>@attendance.Percentage.ToString("F0")%</strong>
                                        <span class="text-muted small">(@attendance.PresentDays/@attendance.TotalDays)</span>
                                    </span>
                                </div>
                                <div class="attendance-bar-modern">
                                    <div class="fill @statusClass" style="width: @attendance.Percentage%;"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                        <p class="text-muted">No attendance records available.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     MY CLASSES
     ============================================ -->
<div class="row mb-3 animate-in delay-2">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="fas fa-chalkboard text-primary me-2"></i>My Classes
                <span class="badge bg-secondary ms-2">@Model.Enrollments.Count</span>
            </h5>
            @if (Model.Enrollments.Any())
            {
                <a asp-action="MyClasses" class="btn btn-sm btn-outline-primary">
                    View All <i class="fas fa-arrow-right ms-1"></i>
                </a>
            }
        </div>
        <hr class="my-2" />
    </div>
</div>

@if (Model.Enrollments.Any())
{
    <div class="row g-3 g-md-4 animate-in delay-3">
        @{
            var delayIndex = 0;
            var colors = new[] { "#6366f1,#8b5cf6", "#667eea,#764ba2", "#f093fb,#f5576c", "#4facfe,#00f2fe" };
        }
        @foreach (var enrollment in Model.Enrollments.Take(4))
        {
            var grade = enrollment.Grades.FirstOrDefault();
            var gradeClass = grade?.LetterGrade?.ToLower() ?? "na";
            var colorIndex = delayIndex % colors.Length;
            var delayClass = (delayIndex % 4 + 1).ToString();

            <div class="col-md-6 col-lg-3 animate-in delay-@delayClass">
                <div class="class-card-modern">
                    <div class="class-header" style="background: linear-gradient(135deg, @colors[colorIndex]);">
                        <div class="class-name">
                            <i class="fas fa-chalkboard me-2"></i>
                            @enrollment.Class.ClassName
                        </div>
                    </div>
                    <div class="class-body">
                        <div class="class-info">
                            <span class="label"><i class="fas fa-book"></i>Course</span>
                            <span class="value">@enrollment.Class.Course?.CourseName</span>
                        </div>
                        <div class="class-info">
                            <span class="label"><i class="fas fa-user"></i>Teacher</span>
                            <span class="value">@enrollment.Class.Teacher?.User?.FullName</span>
                        </div>
                        <div class="class-info">
                            <span class="label"><i class="fas fa-graduation-cap"></i>Grade</span>
                            <span class="value">
                                @if (grade != null)
                                {
                                    <span class="grade-badge-modern grade-@gradeClass">@grade.LetterGrade</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Not graded</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            delayIndex++;
        }
    </div>
}
else
{
    <div class="empty-state-modern animate-in delay-3">
        <div class="icon">
            <i class="fas fa-chalkboard"></i>
        </div>
        <h4>No Classes Enrolled</h4>
        <p>You are not enrolled in any classes yet. Please contact your academic advisor.</p>
    </div>
}

<!-- ============================================
     SCRIPTS - SIMPLIFIED
     ============================================ -->
@section Scripts {
    <script>
        $(document).ready(function() {
            // ============================================
            // STAT CARD HOVER EFFECT
            // ============================================
            $('.stat-card-modern').on('mouseenter', function() {
                var icon = $(this).find('.stat-icon');
                icon.css('transform', 'scale(1.2) rotate(-5deg)');
            }).on('mouseleave', function() {
                var icon = $(this).find('.stat-icon');
                icon.css('transform', 'scale(1) rotate(0deg)');
            });

            // ============================================
            // AUTO-HIDE ALERTS
            // ============================================
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // ============================================
            // ADD COUNTER ANIMATION (Optional Enhancement)
            // ============================================
            // Only animate if the value is 0 to show it counting up
            // Otherwise, display the actual value directly
        });
    </script>
}