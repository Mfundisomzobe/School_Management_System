@model AttendanceReportViewModel
@{
    ViewData["Title"] = "Attendance Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="fas fa-file-alt text-success me-2"></i>Attendance Report
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active">@Model.ClassName</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="MarkAttendance" asp-route-classId="@Model.ClassId" class="btn btn-primary">
                <i class="fas fa-clipboard-check me-2"></i>Mark Attendance
            </a>
            <a asp-action="AttendanceHistory" asp-route-classId="@Model.ClassId" class="btn btn-info text-white">
                <i class="fas fa-history me-2"></i>History
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    <!-- Date Range -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="classId" value="@Model.ClassId" />
                <div class="col-md-4">
                    <label class="form-label fw-bold">Start Date</label>
                    <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">End Date</label>
                    <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-refresh me-2"></i>Generate Report
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Students</h6>
                    <h3 class="fw-bold text-primary">@Model.Summary.TotalStudents</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Overall Attendance</h6>
                    <h3 class="fw-bold text-success">@Model.Summary.OverallAttendance.ToString("F1")%</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Above 80%</h6>
                    <h3 class="fw-bold text-success">@Model.Summary.StudentsAbove80</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Below 60%</h6>
                    <h3 class="fw-bold text-danger">@Model.Summary.StudentsBelow60</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Student Report Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-user-graduate text-success me-2"></i>Student Attendance Report
                <span class="badge bg-secondary ms-2">@Model.StudentReports.Count</span>
            </h5>
        </div>
        <div class="card-body">
            @if (Model.StudentReports.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="reportTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student</th>
                                <th>Admission No</th>
                                <th>Total Days</th>
                                <th>Present</th>
                                <th>Absent</th>
                                <th>Late</th>
                                <th>Excused</th>
                                <th>Percentage</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Model.StudentReports)
                            {
                                var statusClass = report.AttendancePercentage >= 80 ? "success" :
                                (report.AttendancePercentage >= 60 ? "warning" : "danger");
                                var statusText = report.AttendancePercentage >= 80 ? "Good" :
                                (report.AttendancePercentage >= 60 ? "Fair" : "Poor");
                                <tr>
                                    <td>@report.StudentId</td>
                                    <td>@report.StudentName</td>
                                    <td>@report.AdmissionNumber</td>
                                    <td>@report.TotalDays</td>
                                    <td class="text-success">@report.PresentDays</td>
                                    <td class="text-danger">@report.AbsentDays</td>
                                    <td class="text-warning">@report.LateDays</td>
                                    <td class="text-info">@report.ExcusedDays</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress" style="width: 80px; height: 6px;">
                                                <div class="progress-bar bg-@statusClass" role="progressbar"
                                                     style="width: @report.AttendancePercentage%;"
                                                     aria-valuenow="@report.AttendancePercentage"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <span class="small">@report.AttendancePercentage.ToString("F1")%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-@statusClass">@statusText</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-file-alt fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No Data Available</h5>
                    <p class="text-muted">No attendance records found for this period.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#reportTable').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search students..."
                },
                pageLength: 10,
                order: [[8, 'desc']],
                columnDefs: [
                    { orderable: false, targets: [9] }
                ]
            });
        });
    </script>
}