@model EnterGradesViewModel
@{
    ViewData["Title"] = "Enter Grades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .grade-a {
        background: #d4edda;
        color: #155724;
    }

    .grade-b {
        background: #d1ecf1;
        color: #0c5460;
    }

    .grade-c {
        background: #fff3cd;
        color: #856404;
    }

    .grade-d {
        background: #ffe5d0;
        color: #7b3f00;
    }

    .grade-f {
        background: #f8d7da;
        color: #721c24;
    }

    .grade-na {
        background: #e9ecef;
        color: #6c757d;
    }

    .grade-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-block;
        min-width: 35px;
        text-align: center;
    }

    .marks-input {
        width: 100px !important;
        display: inline-block !important;
    }

    .stats-card {
        padding: 16px 20px;
        border-radius: 12px;
        background: white;
        border-left: 4px solid;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

        .stats-card .number {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .stats-card .label {
            font-size: 0.85rem;
            color: #6c757d;
        }
</style>

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="fas fa-graduation-cap text-success me-2"></i>Enter Grades
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active">@Model.ClassName</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="GradeHistory" asp-route-classId="@Model.ClassId" class="btn btn-info text-white">
                <i class="fas fa-history me-2"></i>History
            </a>
            <a asp-action="GradeReport" asp-route-classId="@Model.ClassId" class="btn btn-secondary">
                <i class="fas fa-file-alt me-2"></i>Report
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Summary -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stats-card border-success">
                <div class="number text-success">@Model.GradedCount</div>
                <div class="label">Graded Students</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card border-warning">
                <div class="number text-warning">@Model.UngradedCount</div>
                <div class="label">Ungraded Students</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card border-primary">
                <div class="number text-primary">@Model.ClassAverage.ToString("F1")%</div>
                <div class="label">Class Average</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stats-card border-info">
                <div class="number text-info">@Model.TotalStudents</div>
                <div class="label">Total Students</div>
            </div>
        </div>
    </div>

    <!-- Grade Scale -->
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        <strong>Grade Scale:</strong>
        <span class="grade-badge grade-a">A (90-100)</span>
        <span class="grade-badge grade-b">B (80-89)</span>
        <span class="grade-badge grade-c">C (70-79)</span>
        <span class="grade-badge grade-d">D (60-69)</span>
        <span class="grade-badge grade-f">F (Below 60)</span>
    </div>

    <!-- Grade Form -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-edit text-success me-2"></i>
                    Enter Marks
                    <span class="badge bg-primary ms-2">@Model.TotalStudents Students</span>
                </h5>
                <span class="badge bg-secondary">@Model.ClassName</span>
            </div>
        </div>
        <div class="card-body">
            <form method="post" id="gradesForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ClassId" />
                <input type="hidden" asp-for="ClassName" />
                <input type="hidden" asp-for="TotalStudents" />

                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="gradesTable">
                        <thead>
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Student Name</th>
                                <th class="d-none d-sm-table-cell">Admission No</th>
                                <th style="min-width: 120px;">Marks (0-100)</th>
                                <th style="min-width: 70px;">Grade</th>
                                <th class="d-none d-md-table-cell">Assessment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>
                                        <i class="fas fa-user-circle me-2 text-success"></i>
                                        @Model.Students[i].StudentName
                                        <input type="hidden" asp-for="@Model.Students[i].EnrollmentId" />
                                        <input type="hidden" asp-for="@Model.Students[i].StudentId" />
                                        <input type="hidden" asp-for="@Model.Students[i].StudentName" />
                                        <input type="hidden" asp-for="@Model.Students[i].AdmissionNumber" />
                                        <input type="hidden" asp-for="@Model.Students[i].GradeId" />
                                        <input type="hidden" asp-for="@Model.Students[i].HasGrade" />
                                    </td>
                                    <td class="d-none d-sm-table-cell">@Model.Students[i].AdmissionNumber</td>
                                    <td>
                                        <input asp-for="@Model.Students[i].Marks" class="form-control form-control-sm marks-input marks-input-@i"
                                               type="number" min="0" max="100" step="0.5"
                                               placeholder="Marks" />
                                        <span asp-validation-for="@Model.Students[i].Marks" class="text-danger small d-block"></span>
                                    </td>
                                    <td>
                                        <span class="grade-badge grade-letter" id="grade_@i">
                                            @if (!string.IsNullOrEmpty(Model.Students[i].LetterGrade))
                                            {
                                                @Model.Students[i].LetterGrade
                                            }
                                            else
                                            {
                                                <text>-</text>
                                            }
                                        </span>
                                        <input type="hidden" asp-for="@Model.Students[i].LetterGrade" />
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        <input asp-for="@Model.Students[i].AssessmentName" class="form-control form-control-sm assessment-input"
                                               placeholder="Assessment" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-md-none mt-3">
                    <small class="text-muted">Assessment names can be edited on desktop view</small>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="fas fa-save me-2"></i>Save Grades
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3 text-center text-muted small">
        <i class="fas fa-info-circle me-1"></i>
        <span class="d-none d-sm-inline">Letter grades are automatically calculated based on the marks entered.</span>
        <span class="d-inline d-sm-none">Grades auto-calculated.</span>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#gradesTable').DataTable({
                responsive: true,
                paging: false,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search students..."
                },
                columnDefs: [
                    { orderable: false, targets: [0, 3, 4, 5] }
                ]
            });

            // Auto-calculate letter grade on marks change
            $('.marks-input').on('input', function() {
                var marks = parseFloat($(this).val());
                var row = $(this).closest('tr');
                var gradeSpan = row.find('.grade-letter');
                var gradeInput = row.find('input[name$=".LetterGrade"]');
                var letterGrade = '';
                var gradeClass = '';

                if (isNaN(marks) || marks < 0 || marks > 100) {
                    letterGrade = '-';
                    gradeClass = 'grade-na';
                } else if (marks >= 90) {
                    letterGrade = 'A';
                    gradeClass = 'grade-a';
                } else if (marks >= 80) {
                    letterGrade = 'B';
                    gradeClass = 'grade-b';
                } else if (marks >= 70) {
                    letterGrade = 'C';
                    gradeClass = 'grade-c';
                } else if (marks >= 60) {
                    letterGrade = 'D';
                    gradeClass = 'grade-d';
                } else {
                    letterGrade = 'F';
                    gradeClass = 'grade-f';
                }

                gradeSpan.text(letterGrade);
                gradeSpan.removeClass('grade-a grade-b grade-c grade-d grade-f grade-na');
                gradeSpan.addClass(gradeClass);
                gradeInput.val(letterGrade);
            });

            // Trigger initial calculation
            $('.marks-input').trigger('input');

            // Validate form before submit
            $('#gradesForm').on('submit', function(e) {
                var hasMarks = false;
                $('.marks-input').each(function() {
                    if ($(this).val() && $(this).val() !== '') {
                        hasMarks = true;
                    }
                });

                if (!hasMarks) {
                    e.preventDefault();
                    alert('Please enter at least one grade before saving.');
                    return false;
                }

                // Check for invalid marks
                var invalidMarks = false;
                $('.marks-input').each(function() {
                    var val = parseFloat($(this).val());
                    if (val !== '' && (isNaN(val) || val < 0 || val > 100)) {
                        invalidMarks = true;
                        $(this).addClass('is-invalid');
                    } else {
                        $(this).removeClass('is-invalid');
                    }
                });

                if (invalidMarks) {
                    e.preventDefault();
                    alert('Please enter valid marks between 0 and 100.');
                    return false;
                }
                return true;
            });
        });
    </script>
}