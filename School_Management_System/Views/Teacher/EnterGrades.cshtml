@model EnterGradesViewModel
@{
    ViewData["Title"] = "Enter Grades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-3 mb-md-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-graduation-cap text-success me-2"></i>
                        <span class="d-none d-sm-inline">Enter Grades</span>
                        <span class="d-inline d-sm-none">Grades</span>
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item active">@Model.ClassName</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="Dashboard" class="btn btn-secondary btn-sm w-100 w-sm-auto">
                    <i class="fas fa-arrow-left me-2"></i>Back
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-white py-2 py-md-3">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                <h5 class="mb-0 fw-bold fs-6 fs-md-5">
                    <i class="fas fa-chart-line text-success me-2"></i>@Model.ClassName
                </h5>
                <span class="badge bg-primary fs-6 p-2">@Model.Students.Count Students</span>
            </div>
        </div>
        <div class="card-body p-2 p-md-3">
            <!-- Grade Scale -->
            <div class="alert alert-info small mb-3">
                <i class="fas fa-info-circle me-2"></i>
                <strong class="d-none d-sm-inline">Grade Scale:</strong>
                <div class="grade-scale mt-1 mt-sm-0 d-sm-inline-flex">
                    <span class="grade-badge grade-a">A 90-100</span>
                    <span class="grade-badge grade-b">B 80-89</span>
                    <span class="grade-badge grade-c">C 70-79</span>
                    <span class="grade-badge grade-d">D 60-69</span>
                    <span class="grade-badge grade-f">F &lt;60</span>
                </div>
            </div>

            <form method="post" id="gradesForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ClassId" />
                <input type="hidden" asp-for="ClassName" />

                <div class="grades-table-wrapper">
                    <table class="table table-striped table-hover mb-0" id="gradesTable">
                        <thead>
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Student</th>
                                <th class="d-none d-sm-table-cell">Admission</th>
                                <th style="min-width: 100px;">Marks</th>
                                <th style="min-width: 60px;">Grade</th>
                                <th class="d-none d-md-table-cell">Assessment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>
                                        <i class="fas fa-user-circle me-1 me-md-2 text-success"></i>
                                        @Model.Students[i].StudentName
                                        <input type="hidden" asp-for="@Model.Students[i].EnrollmentId" />
                                        <input type="hidden" asp-for="@Model.Students[i].StudentId" />
                                        <input type="hidden" asp-for="@Model.Students[i].StudentName" />
                                        <input type="hidden" asp-for="@Model.Students[i].AdmissionNumber" />
                                        <input type="hidden" asp-for="@Model.Students[i].GradeId" />
                                    </td>
                                    <td class="d-none d-sm-table-cell">@Model.Students[i].AdmissionNumber</td>
                                    <td>
                                        <input asp-for="@Model.Students[i].Marks" class="form-control form-control-sm marks-input marks-input-@i"
                                               type="number" min="0" max="100" step="0.5"
                                               placeholder="Marks" />
                                        <span asp-validation-for="@Model.Students[i].Marks" class="text-danger small d-block"></span>
                                    </td>
                                    <td>
                                        <span class="grade-badge grade-letter" id="grade_@i">@Model.Students[i].LetterGrade</span>
                                        <input type="hidden" asp-for="@Model.Students[i].LetterGrade" />
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        <input asp-for="@Model.Students[i].AssessmentName" class="form-control form-control-sm assessment-input"
                                               placeholder="Assessment" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-md-none mt-3">
                    <small class="text-muted">Assessment names can be edited on desktop view</small>
                </div>

                <div class="d-grid gap-2 mt-3 mt-md-4">
                    <button type="submit" class="btn btn-success btn-lg py-2 py-md-3">
                        <i class="fas fa-save me-2"></i>Save Grades
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3 text-center text-muted small">
        <i class="fas fa-info-circle me-1"></i>
        <span class="d-none d-sm-inline">Letter grades are automatically calculated based on the marks entered.</span>
        <span class="d-inline d-sm-none">Grades auto-calculated.</span>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#gradesTable').DataTable({
                responsive: true,
                paging: false,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search students...",
                    info: "Showing _START_ to _END_ of _TOTAL_ students",
                    infoEmpty: "No students found"
                },
                columnDefs: [
                    { orderable: false, targets: [0, 3, 4, 5] }
                ]
            });

            // Auto-calculate letter grade
            $('.marks-input').on('input', function() {
                var marks = parseFloat($(this).val());
                var row = $(this).closest('tr');
                var gradeSpan = row.find('.grade-letter');
                var gradeInput = row.find('input[name$=".LetterGrade"]');
                var letterGrade = '';
                var gradeClass = '';

                if (isNaN(marks) || marks < 0 || marks > 100) {
                    letterGrade = '-';
                    gradeClass = '';
                } else if (marks >= 90) {
                    letterGrade = 'A';
                    gradeClass = 'grade-a';
                } else if (marks >= 80) {
                    letterGrade = 'B';
                    gradeClass = 'grade-b';
                } else if (marks >= 70) {
                    letterGrade = 'C';
                    gradeClass = 'grade-c';
                } else if (marks >= 60) {
                    letterGrade = 'D';
                    gradeClass = 'grade-d';
                } else {
                    letterGrade = 'F';
                    gradeClass = 'grade-f';
                }

                gradeSpan.text(letterGrade);
                gradeSpan.removeClass('grade-a grade-b grade-c grade-d grade-f');
                if (gradeClass) {
                    gradeSpan.addClass(gradeClass);
                }
                gradeInput.val(letterGrade);
            });

            $('.marks-input').trigger('input');

            // Validate form
            $('#gradesForm').on('submit', function(e) {
                var hasMarks = false;
                $('.marks-input').each(function() {
                    if ($(this).val() && $(this).val() !== '') {
                        hasMarks = true;
                    }
                });

                if (!hasMarks) {
                    e.preventDefault();
                    alert('Please enter at least one grade before saving.');
                    return false;
                }
                return true;
            });
        });
    </script>
}