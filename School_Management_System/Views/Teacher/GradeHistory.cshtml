@model GradeHistoryViewModel
@{
    ViewData["Title"] = "Grade History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="fas fa-history text-info me-2"></i>Grade History
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active">@Model.ClassName</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="EnterGrades" asp-route-classId="@Model.ClassId" class="btn btn-primary">
                <i class="fas fa-edit me-2"></i>Enter Grades
            </a>
            <a asp-action="GradeReport" asp-route-classId="@Model.ClassId" class="btn btn-secondary">
                <i class="fas fa-file-alt me-2"></i>Report
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Students</h6>
                    <h3 class="fw-bold text-primary">@Model.TotalStudents</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Grades</h6>
                    <h3 class="fw-bold text-success">@Model.GradeRecords.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Assessments</h6>
                    <h3 class="fw-bold text-info">@Model.Assessments.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Class Average</h6>
                    <h3 class="fw-bold text-warning">@Model.OverallClassAverage.ToString("F1")%</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Assessment Averages -->
    @if (Model.AssessmentAverages.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-chart-bar text-info me-2"></i>Assessment Averages
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var assessment in Model.AssessmentAverages)
                    {
                        <div class="col-md-4 col-lg-3">
                            <div class="border rounded p-3 text-center">
                                <div class="text-muted small">@assessment.Key</div>
                                <div class="fw-bold fs-4">@assessment.Value.ToString("F1")%</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Grade Distribution -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-chart-pie text-info me-2"></i>Grade Distribution
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <div class="alert alert-light">
                        @Model.GradeDistribution
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Records Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-list text-info me-2"></i>All Grade Records
                <span class="badge bg-secondary ms-2">@Model.GradeRecords.Count</span>
            </h5>
        </div>
        <div class="card-body">
            @if (Model.GradeRecords.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="historyTable">
                        <thead>
                            <tr>
                                <th>Student</th>
                                <th>Admission No</th>
                                <th>Assessment</th>
                                <th>Marks</th>
                                <th>Grade</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.GradeRecords.OrderByDescending(r => r.DateRecorded).ThenBy(r => r.StudentName))
                            {
                                <tr>
                                    <td>@record.StudentName</td>
                                    <td>@record.AdmissionNumber</td>
                                    <td>@record.AssessmentName</td>
                                    <td>@record.Marks?.ToString("F1")</td>
                                    <td>
                                        <span class="badge bg-@record.GradeColor">
                                            @record.LetterGrade
                                        </span>
                                    </td>
                                    <td>@record.DateRecorded.ToString("yyyy-MM-dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-graduation-cap fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No Grade Records</h5>
                    <p class="text-muted">No grades have been entered for this class yet.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#historyTable').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records..."
                },
                pageLength: 25,
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [4] }
                ]
            });
        });
    </script>
}