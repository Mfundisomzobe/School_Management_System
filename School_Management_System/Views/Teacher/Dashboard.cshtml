@model TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teacher Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Teacher Dashboard Styles */
    .stat-card {
        padding: 24px;
        border-radius: 16px;
        color: white;
        transition: all 0.3s ease;
        cursor: default;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .stat-card::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            pointer-events: none;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        }

        .stat-card .stat-icon {
            font-size: 2.5rem;
            opacity: 0.4;
            position: absolute;
            bottom: 15px;
            right: 20px;
        }

        .stat-card .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .stat-card .stat-label {
            font-size: 0.9rem;
            opacity: 0.9;
            margin: 0;
        }

        .stat-card .stat-sub {
            font-size: 0.8rem;
            opacity: 0.7;
            margin-top: 5px;
        }

    /* Quick Actions */
    .quick-action-card {
        border: none;
        border-radius: 16px;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        height: 100%;
        display: block;
    }

        .quick-action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.1);
            text-decoration: none;
            color: inherit;
        }

        .quick-action-card .card-body {
            padding: 24px;
            text-align: center;
        }

        .quick-action-card .action-icon {
            font-size: 2.5rem;
            margin-bottom: 12px;
            display: block;
        }

        .quick-action-card .action-title {
            font-weight: 600;
            font-size: 1rem;
        }

        .quick-action-card .action-desc {
            font-size: 0.85rem;
            color: #6c757d;
            margin: 0;
        }

    /* Class Cards */
    .class-card {
        border: none;
        border-radius: 16px;
        transition: all 0.3s ease;
        height: 100%;
        overflow: hidden;
    }

        .class-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.1);
        }

        .class-card .class-header {
            padding: 16px 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .class-card .class-header .class-name {
                font-weight: 600;
                font-size: 1.1rem;
                margin: 0;
            }

            .class-card .class-header .class-badge {
                background: rgba(255,255,255,0.2);
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 0.75rem;
                font-weight: 500;
            }

        .class-card .class-body {
            padding: 16px 20px;
        }

            .class-card .class-body .class-info {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 6px 0;
                border-bottom: 1px solid #f0f2f5;
            }

                .class-card .class-body .class-info:last-child {
                    border-bottom: none;
                }

                .class-card .class-body .class-info .label {
                    color: #6c757d;
                    font-size: 0.85rem;
                }

                .class-card .class-body .class-info .value {
                    font-weight: 500;
                    font-size: 0.9rem;
                }

        .class-card .class-footer {
            padding: 12px 20px;
            background: #f8f9fa;
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

            .class-card .class-footer .btn {
                flex: 1;
                min-width: 60px;
                font-size: 0.75rem;
                padding: 6px 10px;
            }

    .progress-bar-custom {
        height: 6px;
        border-radius: 3px;
        margin-top: 8px;
    }

    .class-list-wrapper {
        max-height: 500px;
        overflow-y: auto;
    }

        .class-list-wrapper::-webkit-scrollbar {
            width: 4px;
        }

        .class-list-wrapper::-webkit-scrollbar-thumb {
            background: #dee2e6;
            border-radius: 4px;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .stat-card .stat-number {
            font-size: 1.8rem;
        }

        .quick-action-card .action-icon {
            font-size: 2rem;
        }

        .class-card .class-header .class-name {
            font-size: 1rem;
        }
    }
</style>

<div class="container-fluid">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                    <h1 class="fw-bold">
                        <i class="fas fa-chalkboard-teacher text-primary me-2"></i>
                        Teacher Dashboard
                    </h1>
                    <p class="text-muted mb-0">
                        <i class="fas fa-user me-1"></i>
                        Welcome back, <strong>@ViewBag.TeacherName</strong>
                        <span class="mx-2 text-muted">|</span>
                        <i class="fas fa-envelope me-1"></i> @ViewBag.TeacherEmail
                    </p>
                </div>
                <div>
                    <span class="badge bg-primary fs-6 p-2">
                        <i class="fas fa-calendar-alt me-1"></i>
                        @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="stat-number">@Model.TotalClasses</div>
                <div class="stat-label">My Classes</div>
                <div class="stat-sub">Active classes assigned</div>
                <div class="stat-icon"><i class="fas fa-chalkboard"></i></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="stat-number">@Model.TotalStudents</div>
                <div class="stat-label">Total Students</div>
                <div class="stat-sub">Across all your classes</div>
                <div class="stat-icon"><i class="fas fa-user-graduate"></i></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="stat-number">@Model.TodayAttendance</div>
                <div class="stat-label">Today's Attendance</div>
                <div class="stat-sub">Marked today</div>
                <div class="stat-icon"><i class="fas fa-clipboard-check"></i></div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <div class="stat-number">@((Model.TotalStudents > 0 && Model.TotalClasses > 0) ? (Model.TotalStudents / Model.TotalClasses) : 0)</div>
                <div class="stat-label">Avg Students/Class</div>
                <div class="stat-sub">Average class size</div>
                <div class="stat-icon"><i class="fas fa-users"></i></div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-md-3">
            <a asp-action="ClassRoster" asp-route-id="@(Model.Classes.FirstOrDefault()?.ClassId ?? 0)"
               class="quick-action-card @(Model.Classes.Any() ? "" : "disabled-link")">
                <div class="card quick-action-card">
                    <div class="card-body">
                        <span class="action-icon"><i class="fas fa-users text-primary"></i></span>
                        <div class="action-title">View Roster</div>
                        <p class="action-desc">See all students in your classes</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="MarkAttendance" asp-route-classId="@(Model.Classes.FirstOrDefault()?.ClassId ?? 0)"
               class="quick-action-card @(Model.Classes.Any() ? "" : "disabled-link")">
                <div class="card quick-action-card">
                    <div class="card-body">
                        <span class="action-icon"><i class="fas fa-clipboard-check text-success"></i></span>
                        <div class="action-title">Mark Attendance</div>
                        <p class="action-desc">Record attendance for today</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="EnterGrades" asp-route-classId="@(Model.Classes.FirstOrDefault()?.ClassId ?? 0)"
               class="quick-action-card @(Model.Classes.Any() ? "" : "disabled-link")">
                <div class="card quick-action-card">
                    <div class="card-body">
                        <span class="action-icon"><i class="fas fa-graduation-cap text-warning"></i></span>
                        <div class="action-title">Enter Grades</div>
                        <p class="action-desc">Update student grades</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="ChangePassword" asp-controller="Account" class="quick-action-card">
                <div class="card quick-action-card">
                    <div class="card-body">
                        <span class="action-icon"><i class="fas fa-key text-danger"></i></span>
                        <div class="action-title">Change Password</div>
                        <p class="action-desc">Update your account security</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- My Classes -->
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold mb-3">
                <i class="fas fa-list me-2 text-primary"></i>
                My Classes
                <span class="badge bg-secondary ms-2">@Model.Classes.Count</span>
            </h4>
            <hr />
        </div>
    </div>

    @if (Model.Classes.Any())
    {
        <div class="row g-4 class-list-wrapper">
            @foreach (var classEntity in Model.Classes)
            {
                var enrollmentCount = classEntity.Enrollments?.Count ?? 0;
                var availableSpots = classEntity.Capacity - enrollmentCount;
                var fillPercentage = classEntity.Capacity > 0 ? (double)enrollmentCount / classEntity.Capacity * 100 : 0;
                var barColor = fillPercentage >= 80 ? "bg-success" : (fillPercentage >= 60 ? "bg-warning" : "bg-danger");

                <div class="col-md-6 col-lg-4">
                    <div class="card class-card">
                        <div class="class-header">
                            <span class="class-name">
                                <i class="fas fa-chalkboard me-2"></i>@classEntity.ClassName
                            </span>
                            <span class="class-badge">@enrollmentCount / @classEntity.Capacity</span>
                        </div>
                        <div class="class-body">
                            <div class="class-info">
                                <span class="label"><i class="fas fa-book me-1"></i>Course</span>
                                <span class="value">@classEntity.Course?.CourseName</span>
                            </div>
                            <div class="class-info">
                                <span class="label"><i class="fas fa-user me-1"></i>Teacher</span>
                                <span class="value">@classEntity.Teacher?.User?.FullName</span>
                            </div>
                            <div class="class-info">
                                <span class="label"><i class="fas fa-users me-1"></i>Enrollment</span>
                                <span class="value">
                                    @enrollmentCount / @classEntity.Capacity
                                    <span class="text-muted ms-1">(@availableSpots spots left)</span>
                                </span>
                            </div>
                            <div class="class-info">
                                <span class="label"><i class="fas fa-chart-pie me-1"></i>Capacity</span>
                                <span class="value">
                                    <div class="progress-bar-custom">
                                        <div class="progress">
                                            <div class="progress-bar @barColor" role="progressbar"
                                                 style="width: @fillPercentage%;"
                                                 aria-valuenow="@fillPercentage"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                            </div>
                                        </div>
                                    </div>
                                </span>
                            </div>
                        </div>
                        <div class="class-footer">
                            <a asp-action="ClassRoster" asp-route-id="@classEntity.ClassId"
                               class="btn btn-info btn-sm text-white" title="View Roster">
                                <i class="fas fa-users me-1"></i>Roster
                            </a>
                            <a asp-action="MarkAttendance" asp-route-classId="@classEntity.ClassId"
                               class="btn btn-success btn-sm" title="Mark Attendance">
                                <i class="fas fa-clipboard-check me-1"></i>Attendance
                            </a>
                            <a asp-action="EnterGrades" asp-route-classId="@classEntity.ClassId"
                               class="btn btn-warning btn-sm" title="Enter Grades">
                                <i class="fas fa-graduation-cap me-1"></i>Grades
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-chalkboard fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No Classes Assigned</h4>
            <p class="text-muted">You haven't been assigned to any classes yet.</p>
            <p class="text-muted small">Please contact the administrator for class assignments.</p>
        </div>
    }

    <!-- Recent Activity / Quick Stats -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-chart-line text-primary me-2"></i>Class Enrollment Overview
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.ClassEnrollmentCounts != null && Model.ClassEnrollmentCounts.Any())
                    {
                        <div class="row g-3">
                            @foreach (var item in Model.ClassEnrollmentCounts)
                            {
                                var percentage = Model.Classes.FirstOrDefault(c => (c.ClassName + " (" + c.Course?.CourseName + ")") == item.Key)?.Capacity ?? 100;
                                var barWidth = percentage > 0 ? (double)item.Value / percentage * 100 : 0;
                                var color = barWidth >= 80 ? "success" : (barWidth >= 60 ? "warning" : "danger");
                                <div class="col-md-6 col-lg-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="text-truncate" style="max-width: 60%;" title="@item.Key">
                                            <i class="fas fa-users me-1 text-primary"></i>@item.Key
                                        </span>
                                        <span>
                                            <strong>@item.Value</strong>
                                            <span class="text-muted small">/ @percentage</span>
                                        </span>
                                    </div>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar bg-@color" role="progressbar"
                                             style="width: @Math.Min(barWidth, 100)%;"
                                             aria-valuenow="@barWidth"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">No class enrollment data available.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .disabled-link {
        opacity: 0.5;
        pointer-events: none;
        cursor: not-allowed;
    }

        .disabled-link .card {
            opacity: 0.5;
        }
</style>