@model TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teacher Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-3 mb-md-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3 fs-lg-2">
                        <i class="fas fa-chalkboard-teacher text-primary me-2"></i>
                        <span class="d-none d-sm-inline">Teacher Dashboard</span>
                        <span class="d-inline d-sm-none">Dashboard</span>
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item active">Dashboard</li>
                        </ol>
                    </nav>
                </div>
                <div>
                    <span class="badge bg-primary role-badge">
                        <i class="fas fa-user me-1"></i>
                        <span class="d-none d-sm-inline">@ViewBag.TeacherName</span>
                        <span class="d-inline d-sm-none"><i class="fas fa-user"></i></span>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-2 g-sm-3 g-md-4 mb-3 mb-md-4">
        <div class="col-12 col-sm-6 col-md-4">
            <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="label">My Classes</div>
                        <div class="number">@Model.TotalClasses</div>
                    </div>
                    <div class="icon">
                        <i class="fas fa-chalkboard"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="label">Total Students</div>
                        <div class="number">@Model.TotalStudents</div>
                    </div>
                    <div class="icon">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-4">
            <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="label">Employee ID</div>
                        <div class="fs-5 fs-md-4 fw-bold">@Model.Teacher.EmployeeId</div>
                    </div>
                    <div class="icon">
                        <i class="fas fa-id-badge"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- My Classes -->
    <div class="card shadow">
        <div class="card-header bg-white py-2 py-md-3">
            <h5 class="mb-0 fw-bold fs-6 fs-md-5">
                <i class="fas fa-list text-primary me-2"></i>My Classes
                <span class="badge bg-secondary ms-2 d-none d-sm-inline">@Model.Classes.Count</span>
            </h5>
        </div>
        <div class="card-body p-2 p-md-3">
            @if (Model.Classes.Any())
            {
                <div class="table-responsive-stack">
                    <table class="table table-striped table-hover mb-0" id="classTable">
                        <thead>
                            <tr>
                                <th class="d-none d-md-table-cell">#</th>
                                <th>Class</th>
                                <th class="d-none d-sm-table-cell">Course</th>
                                <th class="d-none d-md-table-cell">Students</th>
                                <th class="d-none d-lg-table-cell">Capacity</th>
                                <th class="d-none d-md-table-cell">Available</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var classEntity in Model.Classes)
                            {
                                var enrollmentCount = classEntity.Enrollments?.Count ?? 0;
                                var availableSpots = classEntity.Capacity - enrollmentCount;
                                <tr>
                                    <td class="d-none d-md-table-cell">@classEntity.ClassId</td>
                                    <td>
                                        <i class="fas fa-chalkboard me-1 me-md-2 text-primary"></i>
                                        <span class="fw-semibold">@classEntity.ClassName</span>
                                    </td>
                                    <td class="d-none d-sm-table-cell">@classEntity.Course?.CourseName</td>
                                    <td class="d-none d-md-table-cell"><span class="badge bg-info">@enrollmentCount</span></td>
                                    <td class="d-none d-lg-table-cell">@classEntity.Capacity</td>
                                    <td class="d-none d-md-table-cell">
                                        <span class="badge @(availableSpots > 0 ? "bg-success" : "bg-danger")">
                                            @availableSpots
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-btn-group">
                                            <a asp-action="ClassRoster" asp-route-id="@classEntity.ClassId"
                                               class="btn btn-info btn-sm action-btn" title="View Roster">
                                                <i class="fas fa-users"></i>
                                            </a>
                                            <a asp-action="MarkAttendance" asp-route-classId="@classEntity.ClassId"
                                               class="btn btn-warning btn-sm action-btn" title="Mark Attendance">
                                                <i class="fas fa-clipboard-check"></i>
                                            </a>
                                            <a asp-action="EnterGrades" asp-route-classId="@classEntity.ClassId"
                                               class="btn btn-success btn-sm action-btn" title="Enter Grades">
                                                <i class="fas fa-graduation-cap"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 py-md-5">
                    <i class="fas fa-info-circle fa-3x fa-md-4x text-muted mb-3"></i>
                    <h5 class="text-muted fs-6 fs-md-5">No Classes Assigned</h5>
                    <p class="text-muted small">You haven't been assigned to any classes yet.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.min.css" />

    <script>
        $(document).ready(function() {
            $('#classTable').DataTable({
                responsive: {
                    details: {
                        display: $.fn.dataTable.Responsive.display.modal({
                            header: function(row) {
                                var data = row.data();
                                return 'Class Details: ' + data[1];
                            }
                        }),
                        renderer: $.fn.dataTable.Responsive.renderer.tableAll({
                            tableClass: 'table table-bordered mb-0'
                        })
                    }
                },
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search classes...",
                    lengthMenu: "Show _MENU_ classes",
                    info: "Showing _START_ to _END_ of _TOTAL_ classes",
                    infoEmpty: "No classes found",
                    infoFiltered: "(filtered from _MAX_ total classes)"
                },
                columnDefs: [
                    { orderable: false, targets: [6] }
                ],
                pageLength: 10,
                responsive: true
            });
        });
    </script>
}