@model MarkAttendanceViewModel
@{
    ViewData["Title"] = "Mark Attendance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-3 mb-md-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-clipboard-check text-warning me-2"></i>
                        <span class="d-none d-sm-inline">Mark Attendance</span>
                        <span class="d-inline d-sm-none">Attendance</span>
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item active">@Model.ClassName</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="Dashboard" class="btn btn-secondary btn-sm w-100 w-sm-auto">
                    <i class="fas fa-arrow-left me-2"></i>Back
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-white py-2 py-md-3">
            <div class="attendance-header">
                <div>
                    <h5 class="mb-0 fw-bold fs-6 fs-md-5">
                        <i class="fas fa-calendar-alt text-primary me-2"></i>
                        @Model.Date.ToString("dddd, MMMM dd, yyyy")
                    </h5>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-primary fs-6 p-2">@Model.ClassName</span>
                    <span class="badge bg-info fs-6 p-2 d-none d-sm-inline">@Model.Students.Count Students</span>
                </div>
            </div>
        </div>
        <div class="card-body p-2 p-md-3">
            <!-- Status Guide -->
            <div class="alert alert-info small mb-3">
                <i class="fas fa-info-circle me-2"></i>
                <strong class="d-none d-sm-inline">Quick Guide:</strong>
                <div class="d-flex flex-wrap gap-1 mt-1 mt-sm-0 d-sm-inline">
                    <span class="status-badge status-Present">Present</span>
                    <span class="status-badge status-Absent">Absent</span>
                    <span class="status-badge status-Late">Late</span>
                    <span class="status-badge status-Excused">Excused</span>
                </div>
            </div>

            <form method="post" id="attendanceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ClassId" />
                <input type="hidden" asp-for="Date" />
                <input type="hidden" asp-for="ClassName" />

                <div class="attendance-table-wrapper">
                    <table class="table table-striped table-hover mb-0" id="attendanceTable">
                        <thead>
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Student</th>
                                <th class="d-none d-sm-table-cell">Admission</th>
                                <th style="min-width: 140px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>
                                        <i class="fas fa-user-circle me-1 me-md-2 text-success"></i>
                                        @Model.Students[i].StudentName
                                        <input type="hidden" asp-for="@Model.Students[i].EnrollmentId" />
                                        <input type="hidden" asp-for="@Model.Students[i].StudentId" />
                                        <input type="hidden" asp-for="@Model.Students[i].StudentName" />
                                        <input type="hidden" asp-for="@Model.Students[i].AdmissionNumber" />
                                    </td>
                                    <td class="d-none d-sm-table-cell">@Model.Students[i].AdmissionNumber</td>
                                    <td>
                                        <select asp-for="@Model.Students[i].Status" class="form-select form-select-sm attendance-select status-select">
                                            @foreach (var status in ViewBag.AttendanceStatuses)
                                            {
                                                <option value="@status.Value" class="@status.Value">
                                                    @status.Text
                                                </option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-grid gap-2 mt-3 mt-md-4">
                    <button type="submit" class="btn btn-primary btn-lg py-2 py-md-3">
                        <i class="fas fa-save me-2"></i>Save Attendance
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3 text-center text-muted small">
        <i class="fas fa-info-circle me-1"></i>
        <span class="d-none d-sm-inline">You can only mark attendance for today or past dates. Future dates are not allowed.</span>
        <span class="d-inline d-sm-none">Only today or past dates allowed.</span>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#attendanceTable').DataTable({
                responsive: true,
                paging: false,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search students...",
                    info: "Showing _START_ to _END_ of _TOTAL_ students",
                    infoEmpty: "No students found"
                },
                columnDefs: [
                    { orderable: false, targets: [0, 3] }
                ]
            });

            $('.status-select').each(function() {
                var select = $(this);
                select.change(function() {
                    var value = $(this).val();
                    $(this).removeClass('Present Absent Late Excused');
                    $(this).addClass(value);
                });
                select.trigger('change');
            });
        });
    </script>
}