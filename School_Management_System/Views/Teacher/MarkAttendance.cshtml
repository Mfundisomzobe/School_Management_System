@model MarkAttendanceViewModel
@{
    ViewData["Title"] = "Mark Attendance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .status-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 500;
        font-size: 0.8rem;
        display: inline-block;
    }

    .status-Present {
        background: #d4edda;
        color: #155724;
    }

    .status-Absent {
        background: #f8d7da;
        color: #721c24;
    }

    .status-Late {
        background: #fff3cd;
        color: #856404;
    }

    .status-Excused {
        background: #d1ecf1;
        color: #0c5460;
    }

    .attendance-select {
        min-width: 140px;
        cursor: pointer;
        font-size: 0.9rem;
    }

        .attendance-select option.Present {
            background: #d4edda;
        }

        .attendance-select option.Absent {
            background: #f8d7da;
        }

        .attendance-select option.Late {
            background: #fff3cd;
        }

        .attendance-select option.Excused {
            background: #d1ecf1;
        }

    .stats-card {
        padding: 16px 20px;
        border-radius: 12px;
        background: white;
        border-left: 4px solid;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

        .stats-card .number {
            font-size: 1.5rem;
            font-weight: 700;
        }

        .stats-card .label {
            font-size: 0.85rem;
            color: #6c757d;
        }
</style>

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="fas fa-clipboard-check text-warning me-2"></i>Mark Attendance
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active">@Model.ClassName</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="AttendanceHistory" asp-route-classId="@Model.ClassId" class="btn btn-info text-white">
                <i class="fas fa-history me-2"></i>History
            </a>
            <a asp-action="AttendanceReport" asp-route-classId="@Model.ClassId" class="btn btn-secondary">
                <i class="fas fa-file-alt me-2"></i>Report
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Summary -->
    <div class="row g-3 mb-4">
        <div class="col-3">
            <div class="stats-card border-success">
                <div class="number text-success">@Model.PresentCount</div>
                <div class="label">Present</div>
            </div>
        </div>
        <div class="col-3">
            <div class="stats-card border-danger">
                <div class="number text-danger">@Model.AbsentCount</div>
                <div class="label">Absent</div>
            </div>
        </div>
        <div class="col-3">
            <div class="stats-card border-warning">
                <div class="number text-warning">@Model.LateCount</div>
                <div class="label">Late</div>
            </div>
        </div>
        <div class="col-3">
            <div class="stats-card border-info">
                <div class="number text-info">@Model.ExcusedCount</div>
                <div class="label">Excused</div>
            </div>
        </div>
    </div>

    <!-- Attendance Form -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-calendar-alt text-primary me-2"></i>
                    @Model.Date.ToString("dddd, MMMM dd, yyyy")
                    <span class="badge bg-primary ms-2">@Model.TotalStudents Students</span>
                </h5>
                <span class="badge bg-secondary">@Model.ClassName</span>
            </div>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Quick Guide:</strong>
                <span class="status-badge status-Present ms-2">Present</span>
                <span class="status-badge status-Absent">Absent</span>
                <span class="status-badge status-Late">Late</span>
                <span class="status-badge status-Excused">Excused</span>
            </div>

            <form method="post" id="attendanceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ClassId" />
                <input type="hidden" asp-for="Date" />
                <input type="hidden" asp-for="ClassName" />
                <input type="hidden" asp-for="TotalStudents" />

                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="attendanceTable">
                        <thead>
                            <tr>
                                <th style="width: 40px;">#</th>
                                <th>Student Name</th>
                                <th class="d-none d-sm-table-cell">Admission No</th>
                                <th style="min-width: 160px;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>
                                        <i class="fas fa-user-circle me-2 text-success"></i>
                                        @Model.Students[i].StudentName
                                        <input type="hidden" asp-for="@Model.Students[i].EnrollmentId" />
                                        <input type="hidden" asp-for="@Model.Students[i].StudentId" />
                                        <input type="hidden" asp-for="@Model.Students[i].StudentName" />
                                        <input type="hidden" asp-for="@Model.Students[i].AdmissionNumber" />
                                        <input type="hidden" asp-for="@Model.Students[i].HasAttendanceRecord" />
                                    </td>
                                    <td class="d-none d-sm-table-cell">@Model.Students[i].AdmissionNumber</td>
                                    <td>
                                        <select asp-for="@Model.Students[i].Status" class="form-select form-select-sm attendance-select status-select">
                                            @foreach (var status in ViewBag.AttendanceStatuses)
                                            {
                                                <option value="@status.Value" class="@status.Value">
                                                    @status.Text
                                                </option>
                                            }
                                        </select>
                                        @if (Model.Students[i].HasAttendanceRecord)
                                        {
                                            <span class="badge bg-secondary ms-1">Updated</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-save me-2"></i>Save Attendance
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3 text-center text-muted small">
        <i class="fas fa-info-circle me-1"></i>
        <span class="d-none d-sm-inline">You can only mark attendance for today or past dates. Future dates are not allowed.</span>
        <span class="d-inline d-sm-none">Only today or past dates allowed.</span>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable
            $('#attendanceTable').DataTable({
                responsive: true,
                paging: false,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search students..."
                },
                columnDefs: [
                    { orderable: false, targets: [0, 3] }
                ]
            });

            // Add color coding to status selects
            $('.status-select').each(function() {
                var select = $(this);
                select.change(function() {
                    var value = $(this).val();
                    $(this).removeClass('Present Absent Late Excused');
                    $(this).addClass(value);
                });
                select.trigger('change');
            });

            // Confirm before save if no changes made
            $('#attendanceForm').on('submit', function(e) {
                var hasChanges = false;
                $('.status-select').each(function() {
                    var originalValue = $(this).data('original-value');
                    if (!originalValue) {
                        originalValue = $(this).val();
                        $(this).data('original-value', originalValue);
                    }
                    if ($(this).val() !== originalValue) {
                        hasChanges = true;
                    }
                });

                if (!hasChanges) {
                    if (!confirm('No changes were made to attendance. Do you want to continue?')) {
                        e.preventDefault();
                        return false;
                    }
                }
                return true;
            });
        });
    </script>
}