@model AttendanceHistoryViewModel
@{
    ViewData["Title"] = "Attendance History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="fas fa-history text-info me-2"></i>Attendance History
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active">@Model.ClassName</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="MarkAttendance" asp-route-classId="@Model.ClassId" class="btn btn-primary">
                <i class="fas fa-clipboard-check me-2"></i>Mark Attendance
            </a>
            <a asp-action="AttendanceReport" asp-route-classId="@Model.ClassId" class="btn btn-secondary">
                <i class="fas fa-file-alt me-2"></i>Report
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Days</h6>
                    <h2 class="fw-bold">@Model.TotalDays</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Attendance Rate</h6>
                    <h2 class="fw-bold text-success">@Model.OverallAttendanceRate.ToString("F1")%</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Records</h6>
                    <h2 class="fw-bold">@Model.AttendanceRecords.Count</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Records Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-list text-info me-2"></i>Attendance Records
                <span class="badge bg-secondary ms-2">@Model.AttendanceRecords.Count</span>
            </h5>
        </div>
        <div class="card-body">
            @if (Model.AttendanceRecords.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="historyTable">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Student</th>
                                <th>Admission No</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in Model.AttendanceRecords.OrderByDescending(r => r.Date).ThenBy(r => r.StudentName))
                            {
                                <tr>
                                    <td>@record.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@record.StudentName</td>
                                    <td>@record.AdmissionNumber</td>
                                    <td>
                                        <span class="badge bg-@record.StatusColor">
                                            @record.StatusDisplay
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-clipboard-check fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No Attendance Records</h5>
                    <p class="text-muted">No attendance has been marked for this class yet.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#historyTable').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records..."
                },
                pageLength: 25,
                order: [[0, 'desc']],
                columnDefs: [
                    { orderable: false, targets: [3] }
                ]
            });
        });
    </script>
}