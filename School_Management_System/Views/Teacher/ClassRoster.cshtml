@model Class
@{
    ViewData["Title"] = "Class Roster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-3 mb-md-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-users text-info me-2"></i>
                        <span class="d-none d-sm-inline">Class Roster</span>
                        <span class="d-inline d-sm-none">Roster</span>
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item active">@Model.ClassName</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="Dashboard" class="btn btn-secondary btn-sm w-100 w-sm-auto">
                    <i class="fas fa-arrow-left me-2"></i>Back
                </a>
            </div>
        </div>
    </div>

    <!-- Info Cards -->
    <div class="row g-2 g-sm-3 mb-3 mb-md-4">
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-primary">
                <div class="label">Class</div>
                <div class="value text-primary">@Model.ClassName</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-success">
                <div class="label">Course</div>
                <div class="value text-success">@Model.Course?.CourseName</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-info">
                <div class="label">Teacher</div>
                <div class="value text-info">@Model.Teacher?.User?.FullName</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-warning">
                <div class="label">Students</div>
                <div class="value text-warning">@(Model.Enrollments?.Count ?? 0) / @Model.Capacity</div>
            </div>
        </div>
    </div>

    <!-- Students Table -->
    <div class="card shadow">
        <div class="card-header bg-white py-2 py-md-3">
            <h5 class="mb-0 fw-bold fs-6 fs-md-5">
                <i class="fas fa-user-graduate text-info me-2"></i>Enrolled Students
                <span class="badge bg-secondary ms-2 d-none d-sm-inline">@(Model.Enrollments?.Count ?? 0)</span>
            </h5>
        </div>
        <div class="card-body p-2 p-md-3">
            @if (Model.Enrollments != null && Model.Enrollments.Any())
            {
                <div class="table-responsive-stack">
                    <table class="table table-striped table-hover mb-0" id="rosterTable">
                        <thead>
                            <tr>
                                <th class="d-none d-md-table-cell">#</th>
                                <th>Student</th>
                                <th class="d-none d-sm-table-cell">Admission</th>
                                <th class="d-none d-lg-table-cell">Class</th>
                                <th class="d-none d-xl-table-cell">Section</th>
                                <th class="d-none d-md-table-cell">Enrolled</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrollment in Model.Enrollments.OrderBy(e => e.Student.User.FullName))
                            {
                                <tr>
                                    <td class="d-none d-md-table-cell">@enrollment.Student.Id</td>
                                    <td>
                                        <i class="fas fa-user-circle me-1 me-md-2 text-success"></i>
                                        @enrollment.Student.User.FullName
                                    </td>
                                    <td class="d-none d-sm-table-cell">@enrollment.Student.AdmissionNumber</td>
                                    <td class="d-none d-lg-table-cell">@enrollment.Student.Class</td>
                                    <td class="d-none d-xl-table-cell">@(string.IsNullOrEmpty(enrollment.Student.Section) ? "-" : enrollment.Student.Section)</td>
                                    <td class="d-none d-md-table-cell">@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="roster-actions">
                                            <a asp-action="ViewStudent" asp-route-studentId="@enrollment.Student.Id"
                                               class="btn btn-info btn-sm" title="View Student">
                                                <i class="fas fa-eye"></i>
                                                <span class="d-none d-md-inline ms-1">View</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 py-md-5">
                    <i class="fas fa-user-graduate fa-3x fa-md-4x text-muted mb-3"></i>
                    <h5 class="text-muted fs-6 fs-md-5">No Students Enrolled</h5>
                    <p class="text-muted small">This class has no students enrolled yet.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#rosterTable').DataTable({
                responsive: {
                    details: {
                        display: $.fn.dataTable.Responsive.display.modal({
                            header: function(row) {
                                return 'Student Details';
                            }
                        })
                    }
                },
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search students...",
                    lengthMenu: "Show _MENU_ students",
                    info: "Showing _START_ to _END_ of _TOTAL_ students",
                    infoEmpty: "No students found",
                    infoFiltered: "(filtered from _MAX_ total students)"
                },
                pageLength: 10,
                responsive: true
            });
        });
    </script>
}