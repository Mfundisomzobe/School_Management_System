@model Class
@{
    ViewData["Title"] = "Class Roster";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="fas fa-users text-info me-2"></i>Class Roster
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active">@Model.ClassName</li>
                </ol>
            </nav>
        </div>
        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
        </a>
    </div>

    <!-- Class Info Cards -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-primary">
                <div class="label">Class</div>
                <div class="value text-primary">@Model.ClassName</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-success">
                <div class="label">Course</div>
                <div class="value text-success">@Model.Course?.CourseName</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-info">
                <div class="label">Teacher</div>
                <div class="value text-info">@Model.Teacher?.User?.FullName</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-warning">
                <div class="label">Students</div>
                <div class="value text-warning">@ViewBag.EnrollmentCount / @Model.Capacity</div>
            </div>
        </div>
    </div>

    <!-- Students Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-user-graduate text-info me-2"></i>Enrolled Students
                <span class="badge bg-secondary ms-2">@ViewBag.EnrollmentCount</span>
            </h5>
        </div>
        <div class="card-body">
            @if (Model.Enrollments != null && Model.Enrollments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="rosterTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th>Admission No</th>
                                <th>Class</th>
                                <th>Section</th>
                                <th>Attendance %</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrollment in Model.Enrollments.OrderBy(e => e.Student.User.FullName))
                            {
                                var attendancePercent = enrollment.AttendancePercentage ?? 0;
                                var barColor = attendancePercent >= 80 ? "bg-success" :
                                (attendancePercent >= 60 ? "bg-warning" : "bg-danger");
                                <tr>
                                    <td>@enrollment.Student.Id</td>
                                    <td>
                                        <i class="fas fa-user-circle me-2 text-success"></i>
                                        @enrollment.Student.User.FullName
                                    </td>
                                    <td>@enrollment.Student.AdmissionNumber</td>
                                    <td>@enrollment.Student.Class</td>
                                    <td>@(string.IsNullOrEmpty(enrollment.Student.Section) ? "-" : enrollment.Student.Section)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress" style="width: 80px; height: 6px;">
                                                <div class="progress-bar @barColor" role="progressbar"
                                                     style="width: @attendancePercent%;"
                                                     aria-valuenow="@attendancePercent"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <span class="small">@attendancePercent.ToString("F0")%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <a asp-action="ViewStudent" asp-route-studentId="@enrollment.Student.Id"
                                           class="btn btn-info btn-sm" title="View Student">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-user-graduate fa-4x text-muted mb-3"></i>
                    <h5 class="text-muted">No Students Enrolled</h5>
                    <p class="text-muted">This class has no students enrolled yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .info-card-sm {
        padding: 15px 20px;
        border-radius: 10px;
        background: #f8f9fa;
        height: 100%;
    }

        .info-card-sm .label {
            font-size: 0.75rem;
            color: #6c757d;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .info-card-sm .value {
            font-size: 1.2rem;
            font-weight: 600;
            margin-top: 5px;
        }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#rosterTable').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search students..."
                },
                pageLength: 10,
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [6] }
                ]
            });
        });
    </script>
}