@model Student
@{
    ViewData["Title"] = "Student Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .btn-pdf {
        background: #dc3545;
        border: none;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-pdf:hover {
            background: #c82333;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
        }
</style>

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-3 mb-md-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-user-graduate text-success me-2"></i>
                        <span class="d-none d-sm-inline">Student Details</span>
                        <span class="d-inline d-sm-none">Student</span>
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item active">@Model.User.FullName</li>
                        </ol>
                    </nav>
                </div>
                <div class="d-flex gap-2">
                    <!-- PDF Export Button -->
                   @*  <a href="#" onclick="exportPDF(event, '@Url.Action("ExportStudentReportPdf", "Teacher", new { studentId = Model.Id })')"
                       class="btn btn-danger btn-sm">
                        <i class="fas fa-file-pdf me-1"></i>PDF
                    </a> *@
                </div>
            </div>
        </div>
    </div>

    <!-- Student Info -->
    <div class="row g-2 g-md-3 mb-3 mb-md-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white py-2 py-md-3">
                    <h5 class="mb-0 fw-bold fs-6 fs-md-5">
                        <i class="fas fa-info-circle me-2"></i>Student Information
                    </h5>
                </div>
                <div class="card-body p-2 p-md-3">
                    <div class="row g-2 g-md-3">
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="info-card" style="border-color: #007bff;">
                                <div class="label"><i class="fas fa-user me-1"></i>Full Name</div>
                                <div class="value">@Model.User.FullName</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="info-card" style="border-color: #28a745;">
                                <div class="label"><i class="fas fa-id-card me-1"></i>Admission</div>
                                <div class="value">@Model.AdmissionNumber</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="info-card" style="border-color: #17a2b8;">
                                <div class="label"><i class="fas fa-chalkboard me-1"></i>Class</div>
                                <div class="value">@Model.Class @Model.Section</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="info-card" style="border-color: #ffc107;">
                                <div class="label"><i class="fas fa-birthday-cake me-1"></i>Date of Birth</div>
                                <div class="value">@Model.DateOfBirth.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="info-card" style="border-color: #6c757d;">
                                <div class="label"><i class="fas fa-envelope me-1"></i>Email</div>
                                <div class="value" style="word-break: break-all;">@Model.User.Email</div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="info-card" style="border-color: #fd7e14;">
                                <div class="label"><i class="fas fa-graduation-cap me-1"></i>Overall GPA</div>
                                <div class="value">
                                    @{
                                        var totalMarks = 0.0;
                                        var gradeCount = 0;
                                        foreach (var enrollment in Model.Enrollments)
                                        {
                                            var grade = enrollment.Grades.FirstOrDefault();
                                            if (grade != null)
                                            {
                                                totalMarks += grade.Marks;
                                                gradeCount++;
                                            }
                                        }
                                        var avg = gradeCount > 0 ? totalMarks / gradeCount : 0;
                                    }
                                    @avg.ToString("F1")%
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grades & Attendance -->
    @if (Model.Enrollments != null && Model.Enrollments.Any())
    {
        <div class="card shadow">
            <div class="card-header bg-success text-white py-2 py-md-3">
                <h5 class="mb-0 fw-bold fs-6 fs-md-5">
                    <i class="fas fa-graduation-cap me-2"></i>Academic Records
                </h5>
            </div>
            <div class="card-body p-2 p-md-3">
                <div class="records-wrapper">
                    <table class="table table-striped table-hover mb-0" id="recordsTable">
                        <thead>
                            <tr>
                                <th>Class</th>
                                <th class="d-none d-sm-table-cell">Course</th>
                                <th>Marks</th>
                                <th>Grade</th>
                                <th class="d-none d-md-table-cell">Assessment</th>
                                <th>Attendance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enrollment in Model.Enrollments.OrderBy(e => e.Class.ClassName))
                            {
                                var grade = enrollment.Grades.FirstOrDefault();
                                var attendanceRecords = enrollment.Attendances ?? new List<Attendance>();
                                var totalDays = attendanceRecords.Count;
                                var presentDays = attendanceRecords.Count(a =>
                                a.Status == Attendance.AttendanceStatus.Present ||
                                a.Status == Attendance.AttendanceStatus.Excused);
                                var attendancePercent = totalDays > 0 ? (double)presentDays / totalDays * 100 : 0;
                                var barColor = attendancePercent >= 80 ? "bg-success" :
                                (attendancePercent >= 60 ? "bg-warning" : "bg-danger");

                                <tr>
                                    <td><span class="fw-semibold">@enrollment.Class.ClassName</span></td>
                                    <td class="d-none d-sm-table-cell">@enrollment.Class.Course?.CourseName</td>
                                    <td>
                                        @if (grade != null)
                                        {
                                            @grade.Marks.ToString("F1")
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (grade != null)
                                        {
                                            <span class="grade-badge grade-@grade.LetterGrade.ToLower()">@grade.LetterGrade</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="d-none d-md-table-cell">@(grade?.AssessmentName ?? "-")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="attendance-bar flex-grow-1" style="min-width: 60px;">
                                                <div class="fill @barColor" style="width: @attendancePercent%;"></div>
                                                <span class="percentage">@attendancePercent.ToString("F0")%</span>
                                            </div>
                                            <span class="small text-muted d-none d-sm-inline">(@presentDays/@totalDays)</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="card-body text-center py-4 py-md-5">
                <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No Enrollment Records</h5>
                <p class="text-muted small">This student is not enrolled in any classes.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#recordsTable').DataTable({
                responsive: {
                    details: {
                        display: $.fn.dataTable.Responsive.display.modal({
                            header: function(row) {
                                return 'Academic Records';
                            }
                        })
                    }
                },
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search records...",
                    info: "Showing _START_ to _END_ of _TOTAL_ records",
                    infoEmpty: "No records found"
                },
                paging: false,
                responsive: true,
                columnDefs: [
                    { orderable: false, targets: [0, 1, 2, 3, 4, 5] }
                ]
            });
        });
    </script>
}