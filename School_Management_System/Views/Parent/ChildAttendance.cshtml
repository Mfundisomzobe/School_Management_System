@using School_Management_System.ViewModels.Parent
@model List<AttendanceSummary>
@{
    ViewData["Title"] = "Child Attendance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .attendance-bar {
        height: 8px;
        border-radius: 4px;
        background: #e9ecef;
        overflow: hidden;
        margin-top: 5px;
    }

        .attendance-bar .fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
        }

            .attendance-bar .fill.good {
                background: #28a745;
            }

            .attendance-bar .fill.fair {
                background: #ffc107;
            }

            .attendance-bar .fill.poor {
                background: #dc3545;
            }
</style>

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="fas fa-clipboard-check text-warning me-2"></i>@ViewBag.StudentName - Attendance
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="MyChildren" class="text-decoration-none">My Children</a></li>
                    <li class="breadcrumb-item"><a asp-action="ViewChild" asp-route-studentId="@ViewBag.StudentId" class="text-decoration-none">@ViewBag.StudentName</a></li>
                    <li class="breadcrumb-item active">Attendance</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-info fs-6 p-2">
                <i class="fas fa-heart me-1"></i> @ViewBag.Relationship
            </span>
            <span class="badge bg-warning fs-6 p-2">
                <i class="fas fa-percent me-1"></i> @ViewBag.OverallAttendance.ToString("F0")% Overall
            </span>
            <a asp-action="ViewChild" asp-route-studentId="@ViewBag.StudentId" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white">
                        <h5 class="mb-0 fw-bold">
                            <i class="fas fa-chart-bar text-warning me-2"></i>
                            Attendance Summary by Class
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var attendance in Model)
                            {
                                var statusClass = attendance.Percentage >= 80 ? "good" :
                                (attendance.Percentage >= 60 ? "fair" : "poor");
                                var statusText = attendance.Percentage >= 80 ? "Good" :
                                (attendance.Percentage >= 60 ? "Fair" : "Poor");
                                var statusBadge = attendance.Percentage >= 80 ? "success" :
                                (attendance.Percentage >= 60 ? "warning" : "danger");
                                <div class="col-md-6 col-lg-4">
                                    <div class="card border-0 bg-light">
                                        <div class="card-body">
                                            <h6 class="fw-bold">@attendance.ClassName</h6>
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span>Attendance</span>
                                                <span>
                                                    <strong>@attendance.Percentage.ToString("F0")%</strong>
                                                    <span class="text-muted small ms-1">
                                                        (@attendance.PresentDays/@attendance.TotalDays)
                                                    </span>
                                                </span>
                                            </div>
                                            <div class="attendance-bar mt-2">
                                                <div class="fill @statusClass" style="width: @attendance.Percentage%;"></div>
                                            </div>
                                            <div class="mt-2">
                                                <span class="badge bg-@statusBadge">@statusText</span>
                                            </div>
                                            <div class="mt-2 small">
                                                <span class="text-success"><i class="fas fa-user-check me-1"></i>Present: @attendance.PresentDays</span>
                                                <span class="text-danger ms-2"><i class="fas fa-user-times me-1"></i>Absent: @(attendance.TotalDays - attendance.PresentDays)</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detailed Table -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-list text-warning me-2"></i>
                    Detailed Attendance Records
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="attendanceTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Class</th>
                                <th>Total Days</th>
                                <th>Present</th>
                                <th>Absent</th>
                                <th>Percentage</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var attendance in Model.OrderByDescending(a => a.Percentage))
                            {
                                var statusClass = attendance.Percentage >= 80 ? "success" :
                                (attendance.Percentage >= 60 ? "warning" : "danger");
                                var statusText = attendance.Percentage >= 80 ? "Good" :
                                (attendance.Percentage >= 60 ? "Fair" : "Poor");
                                <tr>
                                    <td>@(Model.IndexOf(attendance) + 1)</td>
                                    <td>@attendance.ClassName</td>
                                    <td>@attendance.TotalDays</td>
                                    <td>@attendance.PresentDays</td>
                                    <td>@(attendance.TotalDays - attendance.PresentDays)</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress" style="width: 80px; height: 6px;">
                                                <div class="progress-bar bg-@statusClass" role="progressbar"
                                                     style="width: @attendance.Percentage%;"
                                                     aria-valuenow="@attendance.Percentage"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>
                                            </div>
                                            <span class="small">@attendance.Percentage.ToString("F0")%</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-@statusClass">@statusText</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-clipboard-check fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No Attendance Records</h4>
            <p class="text-muted">No attendance records available for this student.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#attendanceTable').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search attendance..."
                },
                pageLength: 10,
                order: [[5, 'desc']],
                columnDefs: [
                    { orderable: false, targets: [0, 6] }
                ]
            });
        });
    </script>
}