@model List<StudentParent>
@{
    ViewData["Title"] = "Parent Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2><i class="fas fa-user-friends me-2"></i>Parent Dashboard</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </nav>
            </div>
            <span class="badge bg-primary">Welcome, @ViewBag.ParentName</span>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-white-50">My Children</h6>
                    <h3 class="text-white">@ViewBag.ChildCount</h3>
                </div>
                <i class="fas fa-child text-white-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="fas fa-child me-2"></i>My Children</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="row">
                @foreach (var sp in Model)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <i class="fas fa-user-graduate text-success" style="font-size: 2rem;"></i>
                                    <h5 class="card-title ms-3">@sp.Student.User.FullName</h5>
                                </div>
                                <p class="card-text">
                                    <span class="badge bg-info">@sp.Relationship</span>
                                    @if (sp.IsPrimaryContact)
                                    {
                                        <span class="badge bg-primary">Primary</span>
                                    }
                                </p>
                                <p class="card-text small">
                                    <i class="fas fa-id-card me-2"></i>@sp.Student.AdmissionNumber<br />
                                    <i class="fas fa-graduation-cap me-2"></i>@sp.Student.Class @(string.IsNullOrEmpty(sp.Student.Section) ? "" : "- " + sp.Student.Section)<br />
                                    <i class="fas fa-chalkboard-teacher me-2"></i>@(sp.Student.Teacher?.User?.FullName ?? "Not Assigned")
                                </p>
                                <a asp-controller="Parent" asp-action="ViewChild" asp-route-studentId="@sp.Student.Id" class="btn btn-info btn-sm text-white">
                                    <i class="fas fa-eye me-1"></i>View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-info-circle me-2"></i>No children linked to your account.
            </div>
        }
    </div>
</div>