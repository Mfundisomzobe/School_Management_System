@using School_Management_System.ViewModels.Parent
@model ParentDashboardViewModel
@{
    ViewData["Title"] = "Parent Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ============================================
               MODERN PARENT DASHBOARD STYLES
               ============================================ */

    /* ----- Animations ----- */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes floatOrb {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(30px, -30px) scale(1.1);
        }
    }

    .animate-in {
        animation: fadeInUp 0.6s ease forwards;
        opacity: 0;
    }

        .animate-in.delay-1 {
            animation-delay: 0.1s;
        }

        .animate-in.delay-2 {
            animation-delay: 0.2s;
        }

        .animate-in.delay-3 {
            animation-delay: 0.3s;
        }

        .animate-in.delay-4 {
            animation-delay: 0.4s;
        }

        .animate-in.delay-5 {
            animation-delay: 0.5s;
        }

        .animate-in.delay-6 {
            animation-delay: 0.6s;
        }

    /* ----- Modern Header ----- */
    .dashboard-header-modern {
        background: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #2d1b69 100%);
        border-radius: 20px;
        padding: 28px 32px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
    }

        .dashboard-header-modern::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.08);
            animation: floatOrb 8s ease-in-out infinite;
        }

        .dashboard-header-modern::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: 10%;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(236, 72, 153, 0.05);
            animation: floatOrb 10s ease-in-out infinite reverse;
        }

        .dashboard-header-modern .header-content {
            position: relative;
            z-index: 1;
        }

        .dashboard-header-modern .avatar-wrapper {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
            font-weight: 700;
            box-shadow: 0 8px 30px rgba(99, 102, 241, 0.3);
            flex-shrink: 0;
        }

        .dashboard-header-modern h1 {
            color: white;
            font-weight: 700;
            margin: 0;
            font-size: 1.6rem;
        }

        .dashboard-header-modern .subtitle {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            margin: 4px 0 0;
        }

            .dashboard-header-modern .subtitle i {
                margin-right: 4px;
            }

        .dashboard-header-modern .badge-modern {
            background: rgba(255,255,255,0.08);
            backdrop-filter: blur(10px);
            padding: 8px 16px;
            border-radius: 12px;
            color: rgba(255,255,255,0.8);
            font-size: 0.8rem;
            border: 1px solid rgba(255,255,255,0.05);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

            .dashboard-header-modern .badge-modern i {
                font-size: 0.9rem;
                opacity: 0.7;
            }

    /* ----- Stat Cards ----- */
    .stat-card-modern {
        padding: 22px 24px;
        border-radius: 16px;
        color: white;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: default;
        height: 100%;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
    }

        .stat-card-modern:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
        }

        .stat-card-modern .stat-icon {
            font-size: 2rem;
            opacity: 0.2;
            position: absolute;
            bottom: 12px;
            right: 16px;
            transition: all 0.3s ease;
        }

        .stat-card-modern:hover .stat-icon {
            transform: scale(1.1) rotate(-5deg);
            opacity: 0.3;
        }

        .stat-card-modern .stat-number {
            font-size: 2.4rem;
            font-weight: 800;
            margin: 0;
            letter-spacing: -0.5px;
            line-height: 1;
        }

        .stat-card-modern .stat-label {
            font-size: 0.85rem;
            opacity: 0.85;
            margin: 6px 0 0;
            font-weight: 500;
        }

        .stat-card-modern .stat-change {
            font-size: 0.7rem;
            margin-top: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(255,255,255,0.1);
            padding: 2px 12px;
            border-radius: 20px;
        }

            .stat-card-modern .stat-change.up {
                color: #4ade80;
            }

            .stat-card-modern .stat-change.down {
                color: #f87171;
            }

        .stat-card-modern.color-1 {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
        }

        .stat-card-modern.color-2 {
            background: linear-gradient(135deg, #ec4899, #f472b6);
        }

        .stat-card-modern.color-3 {
            background: linear-gradient(135deg, #06b6d4, #22d3ee);
        }

        .stat-card-modern.color-4 {
            background: linear-gradient(135deg, #22c55e, #4ade80);
        }

    /* ----- Child Cards ----- */
    .child-card-modern {
        border: none;
        border-radius: 16px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        overflow: hidden;
        background: white;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }

        .child-card-modern:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.08);
        }

        .child-card-modern .card-header-custom {
            padding: 16px 20px;
            color: white;
            position: relative;
            overflow: hidden;
        }

            .child-card-modern .card-header-custom::after {
                content: '';
                position: absolute;
                top: -50%;
                right: -20%;
                width: 120px;
                height: 120px;
                border-radius: 50%;
                background: rgba(255,255,255,0.05);
                pointer-events: none;
            }

            .child-card-modern .card-header-custom .child-name {
                font-weight: 700;
                font-size: 1.1rem;
                margin: 0;
                position: relative;
                z-index: 1;
            }

            .child-card-modern .card-header-custom .relationship-badge {
                background: rgba(255,255,255,0.15);
                padding: 4px 14px;
                border-radius: 20px;
                font-size: 0.7rem;
                font-weight: 600;
                position: relative;
                z-index: 1;
            }

        .child-card-modern .card-body-custom {
            padding: 16px 20px;
        }

            .child-card-modern .card-body-custom .stat-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 4px 0;
                border-bottom: 1px solid #f3f4f6;
            }

                .child-card-modern .card-body-custom .stat-row:last-child {
                    border-bottom: none;
                }

                .child-card-modern .card-body-custom .stat-row .label {
                    color: #6c757d;
                    font-size: 0.85rem;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                }

                    .child-card-modern .card-body-custom .stat-row .label i {
                        font-size: 0.75rem;
                        color: #9ca3af;
                    }

                .child-card-modern .card-body-custom .stat-row .value {
                    font-weight: 600;
                    font-size: 0.9rem;
                }

    /* Grade Badges */
    .grade-badge-modern {
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.75rem;
        display: inline-block;
        min-width: 35px;
        text-align: center;
    }

        .grade-badge-modern.grade-a {
            background: #d4edda;
            color: #155724;
        }

        .grade-badge-modern.grade-b {
            background: #d1ecf1;
            color: #0c5460;
        }

        .grade-badge-modern.grade-c {
            background: #fff3cd;
            color: #856404;
        }

        .grade-badge-modern.grade-d {
            background: #ffe5d0;
            color: #7b3f00;
        }

        .grade-badge-modern.grade-f {
            background: #f8d7da;
            color: #721c24;
        }

        .grade-badge-modern.grade-na {
            background: #e9ecef;
            color: #6c757d;
        }

    .child-card-modern .card-footer-custom {
        padding: 12px 20px 16px;
        background: #fafbfc;
        border-top: 1px solid #f3f4f6;
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

        .child-card-modern .card-footer-custom .btn {
            flex: 1;
            min-width: 55px;
            font-size: 0.7rem;
            padding: 6px 10px;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .child-card-modern .card-footer-custom .btn:hover {
                transform: scale(1.03);
            }

        .child-card-modern .card-footer-custom .btn-info {
            background: linear-gradient(135deg, #06b6d4, #0891b2);
            border: none;
            color: white;
        }

        .child-card-modern .card-footer-custom .btn-success {
            background: linear-gradient(135deg, #22c55e, #16a34a);
            border: none;
            color: white;
        }

        .child-card-modern .card-footer-custom .btn-warning {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            border: none;
            color: white;
        }

    /* ----- Empty State ----- */
    .empty-state-modern {
        padding: 50px 20px;
        text-align: center;
    }

        .empty-state-modern .icon {
            font-size: 3.5rem;
            color: #d1d5db;
            margin-bottom: 16px;
        }

        .empty-state-modern h4 {
            color: #374151;
            font-weight: 600;
            font-size: 1.2rem;
        }

        .empty-state-modern p {
            color: #6c757d;
            font-size: 0.85rem;
            max-width: 400px;
            margin: 0 auto;
        }

    /* ----- Responsive ----- */
    @@media (max-width: 991px) {
        .dashboard-header-modern {
            padding: 24px;
        }

            .dashboard-header-modern h1 {
                font-size: 1.4rem;
            }

        .stat-card-modern .stat-number {
            font-size: 2rem;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-header-modern {
            padding: 20px;
            border-radius: 16px;
        }

            .dashboard-header-modern .avatar-wrapper {
                width: 48px;
                height: 48px;
                font-size: 20px;
            }

            .dashboard-header-modern h1 {
                font-size: 1.2rem;
            }

            .dashboard-header-modern .subtitle {
                font-size: 0.8rem;
            }

            .dashboard-header-modern .badge-modern {
                font-size: 0.7rem;
                padding: 6px 12px;
            }

        .stat-card-modern {
            padding: 18px 20px;
        }

            .stat-card-modern .stat-number {
                font-size: 1.8rem;
            }

            .stat-card-modern .stat-label {
                font-size: 0.8rem;
            }

        .child-card-modern .card-header-custom {
            padding: 14px 16px;
        }

            .child-card-modern .card-header-custom .child-name {
                font-size: 1rem;
            }

        .child-card-modern .card-body-custom {
            padding: 14px 16px;
        }

        .child-card-modern .card-footer-custom {
            padding: 10px 16px 14px;
        }

            .child-card-modern .card-footer-custom .btn {
                font-size: 0.65rem;
                padding: 5px 8px;
            }
    }

    @@media (max-width: 576px) {
        .dashboard-header-modern {
            padding: 16px;
            border-radius: 14px;
        }

            .dashboard-header-modern .avatar-wrapper {
                width: 40px;
                height: 40px;
                font-size: 16px;
            }

            .dashboard-header-modern h1 {
                font-size: 1rem;
            }

            .dashboard-header-modern .subtitle {
                font-size: 0.7rem;
            }

            .dashboard-header-modern .badge-modern {
                font-size: 0.6rem;
                padding: 4px 10px;
            }

        .stat-card-modern {
            padding: 14px 16px;
        }

            .stat-card-modern .stat-number {
                font-size: 1.5rem;
            }

            .stat-card-modern .stat-label {
                font-size: 0.75rem;
            }

            .stat-card-modern .stat-change {
                font-size: 0.6rem;
                padding: 1px 8px;
            }

            .stat-card-modern .stat-icon {
                font-size: 1.5rem;
                bottom: 8px;
                right: 12px;
            }

        .child-card-modern .card-header-custom {
            padding: 10px 12px;
        }

            .child-card-modern .card-header-custom .child-name {
                font-size: 0.9rem;
            }

        .child-card-modern .card-body-custom {
            padding: 10px 12px;
        }

            .child-card-modern .card-body-custom .stat-row .label {
                font-size: 0.75rem;
            }

            .child-card-modern .card-body-custom .stat-row .value {
                font-size: 0.8rem;
            }

        .child-card-modern .card-footer-custom {
            padding: 8px 12px 10px;
            gap: 4px;
            flex-direction: column;
        }

            .child-card-modern .card-footer-custom .btn {
                width: 100%;
                font-size: 0.6rem;
                padding: 4px 8px;
            }

        .grade-badge-modern {
            font-size: 0.65rem;
            padding: 2px 8px;
            min-width: 30px;
        }

        .empty-state-modern {
            padding: 30px 16px;
        }

            .empty-state-modern .icon {
                font-size: 2.5rem;
            }

            .empty-state-modern h4 {
                font-size: 1rem;
            }

            .empty-state-modern p {
                font-size: 0.75rem;
            }
    }

    @@media (max-width: 400px) {
        .dashboard-header-modern h1 {
            font-size: 0.9rem;
        }
    }
</style>

<!-- ============================================
     HEADER
     ============================================ -->
<div class="dashboard-header-modern animate-in">
    <div class="header-content">
        <div class="row align-items-center">
            <div class="col-md-7">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-wrapper">
                        @{
                            var initial = ViewBag.ParentName?.ToString().Substring(0, 1).ToUpper() ?? "P";
                        }
                        @initial
                    </div>
                    <div>
                        <h1>Welcome, @ViewBag.ParentName</h1>
                        <div class="subtitle">
                            <i class="fas fa-envelope"></i> @ViewBag.ParentEmail
                            <span class="mx-2">•</span>
                            <i class="fas fa-calendar-alt"></i> @DateTime.Now.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb" style="background: transparent; padding: 0; margin: 8px 0 0;">
                        <li class="breadcrumb-item active" style="color: rgba(255,255,255,0.7);">Dashboard</li>
                    </ol>
                </nav>
            </div>
            <div class="col-md-5 mt-3 mt-md-0">
                <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                    <span class="badge-modern">
                        <i class="fas fa-user-friends"></i> Parent
                    </span>
                    <span class="badge-modern">
                        <i class="fas fa-clock"></i> @DateTime.Now.ToString("HH:mm")
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     STATS CARDS - FIXED
     ============================================ -->
@{
    var avgGPA = Model.ChildSummaries.Any() ? Model.ChildSummaries.Average(c => c.OverallGPA) : 0;
    var avgAttendance = Model.ChildSummaries.Any() ? Model.ChildSummaries.Average(c => c.OverallAttendance) : 0;
    var totalClasses = Model.ChildSummaries.Sum(c => c.TotalClasses);
}

<div class="row g-3 g-md-4 mb-4">
    <div class="col-6 col-md-3 animate-in delay-1">
        <div class="stat-card-modern color-1">
            <div class="stat-icon"><i class="fas fa-child"></i></div>
            <div class="stat-number" id="childCount">@Model.TotalChildren</div>
            <div class="stat-label">My Children</div>
            <span class="stat-change up"><i class="fas fa-arrow-up"></i> Linked</span>
        </div>
    </div>
    <div class="col-6 col-md-3 animate-in delay-2">
        <div class="stat-card-modern color-2">
            <div class="stat-icon"><i class="fas fa-graduation-cap"></i></div>
            <div class="stat-number" id="avgGPA">@avgGPA.ToString("F1")%</div>
            <div class="stat-label">Average GPA</div>
            <span class="stat-change up"><i class="fas fa-arrow-up"></i> Overall</span>
        </div>
    </div>
    <div class="col-6 col-md-3 animate-in delay-3">
        <div class="stat-card-modern color-3">
            <div class="stat-icon"><i class="fas fa-clipboard-check"></i></div>
            <div class="stat-number" id="avgAttendance">@avgAttendance.ToString("F0")%</div>
            <div class="stat-label">Average Attendance</div>
            <span class="stat-change up"><i class="fas fa-arrow-up"></i> Overall</span>
        </div>
    </div>
    <div class="col-6 col-md-3 animate-in delay-4">
        <div class="stat-card-modern color-4">
            <div class="stat-icon"><i class="fas fa-chalkboard"></i></div>
            <div class="stat-number" id="totalClasses">@totalClasses</div>
            <div class="stat-label">Total Classes</div>
            <span class="stat-change up"><i class="fas fa-arrow-up"></i> Enrolled</span>
        </div>
    </div>
</div>

<!-- ============================================
     MY CHILDREN
     ============================================ -->
<div class="row mb-3 animate-in delay-5">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0">
                <i class="fas fa-child text-primary me-2"></i>My Children
                <span class="badge bg-secondary ms-2">@Model.TotalChildren</span>
            </h4>
            <a asp-action="MyChildren" class="btn btn-sm btn-outline-primary">
                View All <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
        <hr class="my-2" />
    </div>
</div>

@if (Model.ChildSummaries.Any())
{
    <div class="row g-4">
        @foreach (var child in Model.ChildSummaries)
        {
            var colorIndex = Model.ChildSummaries.IndexOf(child) % 4;
            var colors = new[] { "#6366f1,#8b5cf6", "#667eea,#764ba2", "#f093fb,#f5576c", "#4facfe,#00f2fe" };
            var delayClass = (Model.ChildSummaries.IndexOf(child) % 4 + 1).ToString();
            var gradeClass = child.RecentGrades.FirstOrDefault()?.LetterGrade?.ToLower() ?? "na";

            <div class="col-md-6 col-lg-4 animate-in delay-@delayClass">
                <div class="child-card-modern">
                    <div class="card-header-custom" style="background: linear-gradient(135deg, @colors[colorIndex]);">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="child-name">
                                <i class="fas fa-user-circle me-2"></i>
                                @child.Student.User.FullName
                            </span>
                            <span class="relationship-badge">
                                @child.Relationship
                            </span>
                        </div>
                        <small style="opacity:0.7; position:relative; z-index:1;">
                            <i class="fas fa-id-card me-1"></i> @child.Student.AdmissionNumber
                        </small>
                    </div>
                    <div class="card-body-custom">
                        <div class="stat-row">
                            <span class="label"><i class="fas fa-chalkboard"></i> Classes</span>
                            <span class="value">@child.TotalClasses</span>
                        </div>
                        <div class="stat-row">
                            <span class="label"><i class="fas fa-graduation-cap"></i> GPA</span>
                            <span class="value">@child.OverallGPA.ToString("F1")%</span>
                        </div>
                        <div class="stat-row">
                            <span class="label"><i class="fas fa-clipboard-check"></i> Attendance</span>
                            <span class="value">@child.OverallAttendance.ToString("F0")%</span>
                        </div>
                        <div class="stat-row">
                            <span class="label"><i class="fas fa-building"></i> Class</span>
                            <span class="value">@child.Student.Class @child.Student.Section</span>
                        </div>
                        @if (child.RecentGrades.Any())
                        {
                            <div class="stat-row">
                                <span class="label"><i class="fas fa-graduation-cap"></i> Latest Grade</span>
                                <span class="value">
                                    <span class="grade-badge-modern grade-@gradeClass">
                                        @child.RecentGrades.FirstOrDefault()?.LetterGrade
                                    </span>
                                    <span class="text-muted ms-1 small">
                                        (@child.RecentGrades.FirstOrDefault()?.Marks?.ToString("F1") ?? "0")%
                                    </span>
                                </span>
                            </div>
                        }
                    </div>
                    <div class="card-footer-custom">
                        <a asp-action="ViewChild" asp-route-studentId="@child.Student.Id" class="btn btn-info btn-sm text-white">
                            <i class="fas fa-eye me-1"></i>View
                        </a>
                        <a asp-action="ChildGrades" asp-route-studentId="@child.Student.Id" class="btn btn-success btn-sm">
                            <i class="fas fa-graduation-cap me-1"></i>Grades
                        </a>
                        <a asp-action="ChildAttendance" asp-route-studentId="@child.Student.Id" class="btn btn-warning btn-sm">
                            <i class="fas fa-clipboard-check me-1"></i>Attendance
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state-modern animate-in delay-3">
        <div class="icon">
            <i class="fas fa-child"></i>
        </div>
        <h4>No Children Linked</h4>
        <p>You don't have any children linked to your account yet. Please contact the school administrator to link your children.</p>
    </div>
}

<!-- ============================================
     SCRIPTS - FIXED
     ============================================ -->
@section Scripts {
    <script>
        $(document).ready(function() {
            // ============================================
            // ANIMATE NUMBER COUNTING
            // ============================================
            function animateNumber(elementId, targetValue, isPercentage = false, isDecimal = false) {
                var element = document.getElementById(elementId);
                if (!element) return;

                // Get the current displayed value (remove % sign if present)
                var currentDisplay = element.textContent.replace('%', '');
                var current = parseFloat(currentDisplay) || 0;
                var target = parseFloat(targetValue) || 0;

                // If they're the same, just display the value (no animation needed)
                if (Math.abs(current - target) < 0.01) {
                    updateDisplay(element, target, isPercentage, isDecimal);
                    return;
                }

                var steps = 40;
                var increment = (target - current) / steps;
                var duration = 1200;
                var stepTime = duration / steps;
                var counter = 0;

                var timer = setInterval(function() {
                    counter++;
                    current += increment;

                    if (counter >= steps) {
                        current = target;
                        clearInterval(timer);
                    }

                    updateDisplay(element, current, isPercentage, isDecimal);
                }, stepTime);
            }

            function updateDisplay(element, value, isPercentage, isDecimal) {
                var displayValue;
                if (isDecimal) {
                    displayValue = value.toFixed(1);
                } else {
                    displayValue = Math.round(value);
                }

                if (isPercentage) {
                    element.textContent = displayValue + '%';
                } else {
                    element.textContent = displayValue;
                }
            }

            // Calculate values from model data (passed from server)
            var childCount = @Model.TotalChildren;
            var avgGPA = @(Model.ChildSummaries.Any() ? Model.ChildSummaries.Average(c => c.OverallGPA) : 0);
            var avgAttendance = @(Model.ChildSummaries.Any() ? Model.ChildSummaries.Average(c => c.OverallAttendance) : 0);
            var totalClasses = @Model.ChildSummaries.Sum(c => c.TotalClasses);

            // Animate each stat with appropriate formatting
            animateNumber('childCount', childCount, false, false);
            animateNumber('avgGPA', avgGPA, true, true);
            animateNumber('avgAttendance', avgAttendance, true, false);
            animateNumber('totalClasses', totalClasses, false, false);

            // ============================================
            // STAT CARD HOVER EFFECT
            // ============================================
            $('.stat-card-modern').on('mouseenter', function() {
                var icon = $(this).find('.stat-icon');
                icon.css('transform', 'scale(1.2) rotate(-5deg)');
            }).on('mouseleave', function() {
                var icon = $(this).find('.stat-icon');
                icon.css('transform', 'scale(1) rotate(0deg)');
            });

            // ============================================
            // AUTO-HIDE ALERTS
            // ============================================
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);
        });
    </script>
}