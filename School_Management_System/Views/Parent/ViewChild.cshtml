@using School_Management_System.ViewModels.Parent
@model ChildDetailsViewModel
@{
    ViewData["Title"] = "Child Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .info-card {
        border-left: 4px solid;
        padding: 12px 15px;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 12px;
    }

        .info-card .label {
            font-size: 0.75rem;
            color: #6c757d;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-card .value {
            font-size: 1rem;
            font-weight: 500;
            margin-top: 4px;
        }

    .grade-badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-block;
        min-width: 35px;
        text-align: center;
    }

        .grade-badge.grade-a {
            background: #d4edda;
            color: #155724;
        }

        .grade-badge.grade-b {
            background: #d1ecf1;
            color: #0c5460;
        }

        .grade-badge.grade-c {
            background: #fff3cd;
            color: #856404;
        }

        .grade-badge.grade-d {
            background: #ffe5d0;
            color: #7b3f00;
        }

        .grade-badge.grade-f {
            background: #f8d7da;
            color: #721c24;
        }

        .grade-badge.grade-na {
            background: #e9ecef;
            color: #6c757d;
        }

    .attendance-bar {
        height: 8px;
        border-radius: 4px;
        background: #e9ecef;
        overflow: hidden;
        margin-top: 5px;
    }

        .attendance-bar .fill {
            height: 100%;
            border-radius: 4px;
            transition: width 0.5s ease;
        }

            .attendance-bar .fill.good {
                background: #28a745;
            }

            .attendance-bar .fill.fair {
                background: #ffc107;
            }

            .attendance-bar .fill.poor {
                background: #dc3545;
            }
</style>

<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">
                <i class="fas fa-user-graduate text-success me-2"></i>@Model.Student.User.FullName
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="MyChildren" class="text-decoration-none">My Children</a></li>
                    <li class="breadcrumb-item active">@Model.Student.User.FullName</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-info fs-6 p-2">
                <i class="fas fa-heart me-1"></i> @Model.Relationship
            </span>
            <a asp-action="MyChildren" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>

    <!-- Student Info -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-info-circle me-2"></i>Student Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <small class="text-muted">Full Name</small>
                            <p class="fw-bold">@Model.Student.User.FullName</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Admission Number</small>
                            <p class="fw-bold">@Model.Student.AdmissionNumber</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Class</small>
                            <p class="fw-bold">@Model.Student.Class @Model.Student.Section</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Date of Birth</small>
                            <p class="fw-bold">@Model.Student.DateOfBirth.ToString("dd MMM yyyy")</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Email</small>
                            <p class="fw-bold">@Model.Student.User.Email</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Overall GPA</small>
                            <p class="fw-bold text-success">@Model.OverallGPA.ToString("F1")%</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold"><i class="fas fa-chart-pie me-2"></i>Quick Stats</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <h3 class="fw-bold text-primary">@Model.Enrollments.Count</h3>
                            <small class="text-muted">Classes</small>
                        </div>
                        <div class="col-4">
                            <h3 class="fw-bold text-success">@Model.OverallGPA.ToString("F1")%</h3>
                            <small class="text-muted">GPA</small>
                        </div>
                        <div class="col-4">
                            <h3 class="fw-bold text-warning">@Model.OverallAttendance.ToString("F0")%</h3>
                            <small class="text-muted">Attendance</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grades -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-graduation-cap text-success me-2"></i>Grades
                <span class="badge bg-secondary ms-2">@Model.Grades.Count</span>
            </h5>
        </div>
        <div class="card-body">
            @if (Model.Grades.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Class</th>
                                <th>Assessment</th>
                                <th>Marks</th>
                                <th>Grade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grade in Model.Grades)
                            {
                                var gradeClass = grade.LetterGrade?.ToLower() ?? "na";
                                <tr>
                                    <td>@grade.ClassName</td>
                                    <td>@grade.AssessmentName</td>
                                    <td>@(grade.Marks.HasValue? grade.Marks.Value.ToString("F1") : "-")</td>
                                    <td>
                                        <span class="grade-badge grade-@gradeClass">
                                            @(grade.LetterGrade ?? "N/A")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No grades available for this student.</p>
                </div>
            }
        </div>
    </div>

    <!-- Attendance -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-clipboard-check text-warning me-2"></i>Attendance Summary
                <span class="badge bg-secondary ms-2">@Model.AttendanceRecords.Count</span>
            </h5>
        </div>
        <div class="card-body">
            @if (Model.AttendanceRecords.Any())
            {
                <div class="row g-3">
                    @foreach (var attendance in Model.AttendanceRecords)
                    {
                        var statusClass = attendance.Percentage >= 80 ? "good" : (attendance.Percentage >= 60 ? "fair" : "poor");
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>@attendance.ClassName</span>
                                <span>
                                    <strong>@attendance.Percentage.ToString("F0")%</strong>
                                    <span class="text-muted small">(@attendance.PresentDays/@attendance.TotalDays)</span>
                                </span>
                            </div>
                            <div class="attendance-bar">
                                <div class="fill @statusClass" style="width: @attendance.Percentage%;"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-info-circle fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No attendance records available for this student.</p>
                </div>
            }
        </div>
    </div>
</div>