@using School_Management_System.ViewModels
@model AddStudentViewModel
@{
    ViewData["Title"] = "Add Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2><i class="fas fa-user-graduate me-2"></i>Add Student</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active">Add Student</li>
                    </ol>
                </nav>
            </div>
            <a asp-controller="Admin" asp-action="ViewStudents" class="btn btn-info text-white">
                <i class="fas fa-list me-2"></i>View Students
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i>Student Information</h5>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <h5><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</h5>
                        <div class="mt-3 bg-light p-3 rounded">
                            <p><strong><i class="fas fa-id-card me-2"></i>Admission Number:</strong> <span class="badge bg-primary">@TempData["AdmissionNumber"]</span></p>
                            <p><strong><i class="fas fa-key me-2"></i>Auto-generated Password:</strong> <span class="badge bg-warning text-dark">@TempData["Password"]</span></p>
                            <p class="text-muted small"><i class="fas fa-info-circle me-1"></i>Please save these credentials and share them with the student.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" type="email" placeholder="Enter email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Class" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-graduation-cap"></i></span>
                                <input asp-for="Class" class="form-control" placeholder="Enter class" />
                            </div>
                            <span asp-validation-for="Class" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Section" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-layer-group"></i></span>
                                <input asp-for="Section" class="form-control" placeholder="Enter section" />
                            </div>
                            <span asp-validation-for="Section" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="DateOfBirth" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                            </div>
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="TeacherId" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-chalkboard-teacher"></i></span>
                                <select asp-for="TeacherId" class="form-control" asp-items="ViewBag.Teachers">
                                    <option value="">-- Select Teacher --</option>
                                </select>
                            </div>
                            <span asp-validation-for="TeacherId" class="text-danger small"></span>
                        </div>
                        <!-- Admission Number -->
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold fs-6">Admission Number</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                <input asp-for="AdmissionNumber" id="admissionNumberInput" class="form-control form-control-lg" readonly style="font-size: 1.1rem; font-weight: 500; background-color: #f8f9fa;" />
                            </div>
                        </div>

                        <!-- Password - BIGGER VERSION -->
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold fs-6">Password</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                <input asp-for="Password" id="passwordInput" class="form-control form-control-lg" readonly style="font-size: 1.2rem; font-weight: 600; background-color: #f8f9fa; letter-spacing: 1px; font-family: 'Courier New', monospace;" />
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility()" style="padding: 0 20px;">
                                    <i class="fas fa-eye" id="eyeIcon" style="font-size: 1.2rem;"></i>
                                </button>
                                <button type="button" class="btn btn-warning" onclick="regenerateCredentials()" style="padding: 0 25px; font-weight: 600; font-size: 1rem;">
                                    <i class="fas fa-sync me-2"></i> Regenerate
                                </button>
                            </div>
                            <small class="text-muted mt-1 d-block">
                                <i class="fas fa-info-circle me-1"></i>
                                This password will be used for login. Click <strong>Regenerate</strong> for a new one.
                            </small>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> Admission Number and Password will be auto-generated automatically.
                    </div>

                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-2"></i>Add Student
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert-success').fadeOut('slow');
            }, 10000);
        });
        
        // Regenerate both credentials
        function regenerateCredentials() {
            var btn = document.querySelector('.btn-warning');
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
            btn.disabled = true;

            $.ajax({
                url: '/Admin/GenerateCredentials',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#admissionNumberInput').val(data.admissionNumber);
                    $('#passwordInput').val(data.password);

                    btn.innerHTML = '<i class="fas fa-check"></i> Regenerated!';
                    btn.disabled = false;
                    setTimeout(function() {
                        btn.innerHTML = originalHtml;
                    }, 2000);
                },
                error: function() {
                    alert('Failed to regenerate credentials. Please try again.');
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });
        }

        // Toggle password visibility
        function togglePasswordVisibility() {
            var passwordInput = $('#passwordInput');
            var eyeIcon = $('#eyeIcon');

            if (passwordInput.attr('type') === 'password') {
                passwordInput.attr('type', 'text');
                eyeIcon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                passwordInput.attr('type', 'password');
                eyeIcon.removeClass('fa-eye-slash').addClass('fa-eye');
            }
        }

        // Auto-hide success alert after 10 seconds
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert-success').fadeOut('slow');
            }, 10000);
        });

        // Copy password on double-click
        $('#passwordInput').on('dblclick', function() {
            this.select();
            document.execCommand('copy');
            alert('Password copied to clipboard!');
        });
    
    </script>
}