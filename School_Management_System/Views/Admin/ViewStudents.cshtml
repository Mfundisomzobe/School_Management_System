@model List<Student>
@{
    ViewData["Title"] = "View Students";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-user-graduate text-success me-2"></i>Students List
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item active">Students</li>
                        </ol>
                    </nav>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="AddStudent" class="btn btn-primary btn-sm w-100 w-sm-auto">
                        <i class="fas fa-user-plus me-1"></i>Add New Student
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search & Filter -->
    <div class="row mb-3">
        <div class="col-12 col-md-8">
            <form method="get" asp-action="ViewStudents" class="d-flex gap-2 flex-wrap">
                <div class="input-group flex-grow-1">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search students by name, admission number, or email..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="showInactive" value="true"
                               id="showInactive" @(ViewBag.ShowInactive == true ? "checked" : "")
                               onchange="this.form.submit()" />
                        <label class="form-check-label" for="showInactive">Show Inactive</label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Search</button>
                    <a asp-action="ViewStudents" class="btn btn-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Stats Summary -->
    <div class="row g-2 g-sm-3 mb-3 mb-md-4">
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-primary">
                <div class="label">Total Students</div>
                <div class="value text-primary">@Model.Count(s => s.IsActive)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-success">
                <div class="label">Active</div>
                <div class="value text-success">@Model.Count(s => s.IsActive)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-danger">
                <div class="label">Inactive</div>
                <div class="value text-danger">@Model.Count(s => !s.IsActive)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-info">
                <div class="label">With Parents</div>
                <div class="value text-info">@Model.Count(s => s.StudentParents != null && s.StudentParents.Any(sp => sp.IsActive))</div>
            </div>
        </div>
    </div>

    <!-- Students Table -->
    <div class="card shadow border-0">
        <div class="card-header bg-white py-2 py-md-3">
            <h5 class="mb-0 fw-bold fs-6 fs-md-5">
                <i class="fas fa-list text-success me-2"></i>All Students
                <span class="badge bg-secondary ms-2">@Model.Count</span>
            </h5>
        </div>
        <div class="card-body p-2 p-md-3">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0" id="studentTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th class="d-none d-sm-table-cell">Email</th>
                                <th>Admission</th>
                                <th class="d-none d-md-table-cell">Class</th>
                                <th class="d-none d-lg-table-cell">Section</th>
                                <th class="d-none d-xl-table-cell">Teacher</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.OrderBy(s => s.User.FullName))
                            {
                                var hasParent = student.StudentParents != null && student.StudentParents.Any(sp => sp.IsActive);
                                <tr>
                                    <td>@student.Id</td>
                                    <td>
                                        <i class="fas fa-user-circle me-1 me-md-2 text-success"></i>
                                        @student.User.FullName
                                        @if (hasParent)
                                        {
                                            <i class="fas fa-user-friends text-info ms-1" title="Has parent linked"></i>
                                        }
                                    </td>
                                    <td class="d-none d-sm-table-cell">
                                        <i class="fas fa-envelope me-1 text-muted"></i>
                                        @student.User.Email
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@student.AdmissionNumber</span>
                                    </td>
                                    <td class="d-none d-md-table-cell">@student.Class</td>
                                    <td class="d-none d-lg-table-cell">@(string.IsNullOrEmpty(student.Section) ? "-" : student.Section)</td>
                                    <td class="d-none d-xl-table-cell">
                                        @if (student.Teacher != null)
                                        {
                                            <span class="badge bg-info">@student.Teacher.User?.FullName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not Assigned</span>
                                        }
                                    </td>
                                    <td>
                                        @if (student.IsActive)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            @if (student.IsActive)
                                            {
                                                <a asp-action="EditStudent" asp-route-id="@student.Id" class="btn btn-warning btn-sm action-btn" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="DeleteStudent" asp-route-id="@student.Id" class="btn btn-danger btn-sm action-btn" title="Deactivate"
                                                   onclick="return confirm('Are you sure you want to deactivate this student?');">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="ReactivateStudent" asp-route-id="@student.Id" class="btn btn-success btn-sm" title="Reactivate"
                                                   onclick="return confirm('Are you sure you want to reactivate this student?');">
                                                    <i class="fas fa-undo me-1"></i>Reactivate
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 py-md-5">
                    <i class="fas fa-user-graduate fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No Students Found</h5>
                    <p class="text-muted small">
                        @(ViewBag.ShowInactive == true ? "No students match your search criteria." : "Start by adding your first student.")
                    </p>
                    <a asp-action="AddStudent" class="btn btn-primary btn-sm">
                        <i class="fas fa-user-plus me-1"></i>Add New Student
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-3">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="ViewStudents" asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-showInactive="@ViewBag.ShowInactive">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="ViewStudents" asp-route-page="@i"
                           asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-showInactive="@ViewBag.ShowInactive">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="ViewStudents" asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-showInactive="@ViewBag.ShowInactive">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<style>
    .info-card-sm {
        padding: 15px 20px;
        border-radius: 10px;
        background: #f8f9fa;
        height: 100%;
        transition: all 0.3s ease;
    }

        .info-card-sm:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        }

        .info-card-sm .label {
            font-size: 0.75rem;
            color: #6c757d;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .info-card-sm .value {
            font-size: 1.5rem;
            font-weight: 700;
            margin-top: 5px;
        }

    .action-btn {
        border-radius: 50%;
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        padding: 0;
        border: none;
    }

        .action-btn:hover {
            transform: scale(1.1);
        }

    .card {
        border-radius: 16px;
        overflow: hidden;
    }

    .table-responsive {
        border-radius: 12px;
    }

    .table thead {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

        .table thead th {
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 12px 15px;
            border-bottom: none;
        }

    .table tbody td {
        padding: 12px 15px;
        vertical-align: middle;
    }

    .badge {
        font-weight: 500;
        padding: 5px 12px;
        border-radius: 20px;
    }

    .form-check-input:checked {
        background-color: #28a745;
        border-color: #28a745;
    }

    .form-check-input:focus {
        box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#studentTable').DataTable({
                responsive: {
                    details: {
                        display: $.fn.dataTable.Responsive.display.modal({
                            header: function(row) {
                                var data = row.data();
                                return 'Student Details';
                            }
                        })
                    }
                },
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search students...",
                    lengthMenu: "Show _MENU_ students",
                    info: "Showing _START_ to _END_ of _TOTAL_ students",
                    infoEmpty: "No students found",
                    infoFiltered: "(filtered from _MAX_ total students)"
                },
                pageLength: 10,
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: [8] }
                ]
            });
        });
    </script>
}