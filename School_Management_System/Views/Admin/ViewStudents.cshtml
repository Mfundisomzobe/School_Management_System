@model List<Student>
@{
    ViewData["Title"] = "View Students";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="fas fa-user-graduate me-2"></i>Students List</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item active">Students</li>
                        </ol>
                    </nav>
                </div>
                <a asp-controller="Admin" asp-action="AddStudent" class="btn btn-primary">
                    <i class="fas fa-user-plus me-2"></i>Add New Student
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="studentTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Admission No</th>
                            <th>Class</th>
                            <th>Section</th>
                            <th>Teacher</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td>@student.Id</td>
                                <td><i class="fas fa-user-circle me-2 text-success"></i>@student.User.FullName</td>
                                <td><i class="fas fa-envelope me-1 text-muted"></i>@student.User.Email</td>
                                <td><span class="badge bg-secondary">@student.AdmissionNumber</span></td>
                                <td>@student.Class</td>
                                <td>@(string.IsNullOrEmpty(student.Section) ? "-" : student.Section)</td>
                                <td>@(student.Teacher?.User?.FullName ?? "Not Assigned")</td>
                                <td>
                                    @if (student.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (student.IsActive)
                                    {
                                        <a asp-controller="Admin" asp-action="EditStudent" asp-route-id="@student.Id"
                                           class="btn btn-warning btn-sm" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-controller="Admin" asp-action="DeleteStudent" asp-route-id="@student.Id"
                                           class="btn btn-danger btn-sm" title="Deactivate"
                                           onclick="return confirm('Are you sure you want to deactivate this student?');">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Admin" asp-action="ReactivateStudent" asp-route-id="@student.Id"
                                           class="btn btn-success btn-sm" title="Reactivate"
                                           onclick="return confirm('Are you sure you want to reactivate this student?');">
                                            <i class="fas fa-undo"></i> Reactivate
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#studentTable').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search students..."
                }
            });
        });
    </script>
}