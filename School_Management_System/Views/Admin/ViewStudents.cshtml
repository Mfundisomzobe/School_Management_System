@model List<Student>
@{
    ViewData["Title"] = "View Students";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2><i class="fas fa-user-graduate me-2"></i>Students</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active">Students</li>
                    </ol>
                </nav>
            </div>
            <a asp-controller="Admin" asp-action="AddStudent" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Add Student
            </a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table datatable" id="studentTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Admission No</th>
                        <th>Class</th>
                        <th>Section</th>
                        <th>Teacher</th>
                        <th>Parents</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int index = 1;
                        foreach (var student in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td><i class="fas fa-user-circle me-2 text-success"></i>@student.User.FullName</td>
                                <td>@student.User.Email</td>
                                <td><span class="badge bg-secondary">@student.AdmissionNumber</span></td>
                                <td>@student.Class</td>
                                <td>@(string.IsNullOrEmpty(student.Section) ? "-" : student.Section)</td>
                                <td>@(student.Teacher?.User?.FullName ?? "Not Assigned")</td>
                                <td>
                                    @if (student.StudentParents != null && student.StudentParents.Any())
                                    {
                                        foreach (var sp in student.StudentParents.Where(x => x.IsActive))
                                        {
                                            <span class="badge bg-info">@sp.Parent.User.FullName (@sp.Relationship)</span>
                                            <br />
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No parents</span>
                                    }
                                </td>
                                <td>
                                    @if (student.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                       
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4">
                                <i class="fas fa-info-circle me-2"></i>No students found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

