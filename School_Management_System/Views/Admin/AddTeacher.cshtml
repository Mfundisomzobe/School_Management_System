@using School_Management_System.ViewModels
@model AddTeacherViewModel
@{
    ViewData["Title"] = "Add Teacher";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ========================================
           MODERN ADD TEACHER STYLES
           ======================================== */

    /* ----- Page Header ----- */
    .page-header-modern {
        background: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #2d1b69 100%);
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
    }

        .page-header-modern::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.08);
            animation: floatOrb 8s ease-in-out infinite;
        }

        .page-header-modern::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: 10%;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(236, 72, 153, 0.05);
            animation: floatOrb 10s ease-in-out infinite reverse;
        }

   
    .page-header-modern .header-content {
        position: relative;
        z-index: 1;
    }

    .page-header-modern h2 {
        color: white;
        font-weight: 700;
        margin: 0;
        font-size: 1.6rem;
    }

    .page-header-modern p {
        color: rgba(255,255,255,0.5);
        margin: 4px 0 0;
        font-size: 0.95rem;
    }

    .page-header-modern .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 8px 0 0;
    }

    .page-header-modern .breadcrumb-item a {
        color: rgba(255,255,255,0.4);
        text-decoration: none;
        transition: color 0.3s ease;
        font-size: 0.85rem;
    }

        .page-header-modern .breadcrumb-item a:hover {
            color: #818cf8;
        }

    .page-header-modern .breadcrumb-item.active {
        color: rgba(255,255,255,0.6);
        font-size: 0.85rem;
    }

    .page-header-modern .breadcrumb-item::before {
        color: rgba(255,255,255,0.15);
    }

    /* ----- Form Card ----- */
    .form-card-modern {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        overflow: hidden;
        transition: box-shadow 0.3s ease;
    }

        .form-card-modern:hover {
            box-shadow: 0 8px 40px rgba(0,0,0,0.06);
        }

        .form-card-modern .card-header {
            background: white;
            border-bottom: 1px solid #f0f2f5;
            padding: 18px 28px;
        }

        .form-card-modern .card-body {
            padding: 28px;
        }

    /* ----- Form Controls ----- */
    .form-label-modern {
        font-weight: 600;
        font-size: 0.85rem;
        color: #1a1a3e;
        margin-bottom: 6px;
    }

    .form-control-modern,
    .form-select-modern {
        border-radius: 10px;
        border: 1.5px solid #e5e7eb;
        padding: 10px 16px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        background: #fafbfc;
    }

        .form-control-modern:focus,
        .form-select-modern:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.08);
            background: white;
        }

        .form-control-modern.is-invalid,
        .form-select-modern.is-invalid {
            border-color: #ef4444;
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.08);
        }

    .input-group-modern .input-group-text {
        background: #f8fafc;
        border: 1.5px solid #e5e7eb;
        border-right: none;
        border-radius: 10px 0 0 10px;
        color: #6b7280;
        font-size: 0.9rem;
        padding: 10px 14px;
    }

    .input-group-modern .form-control,
    .input-group-modern .form-select {
        border-radius: 0 10px 10px 0;
        border-left: none;
    }

        .input-group-modern .form-control:focus + .input-group-text,
        .input-group-modern .form-select:focus + .input-group-text {
            border-color: #6366f1;
        }

    /* ----- Auto-Generated Section ----- */
    .auto-gen-section {
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
        border-radius: 14px;
        padding: 20px 24px;
        border: 1px solid #e5e7eb;
        position: relative;
        overflow: hidden;
    }

        .auto-gen-section .section-title {
            font-weight: 600;
            color: #1a1a3e;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.95rem;
        }

            .auto-gen-section .section-title i {
                color: #6366f1;
                font-size: 1.1rem;
            }

        .auto-gen-section .credential-field {
            background: white;
            border-radius: 10px;
            padding: 10px 16px;
            border: 1px solid #e5e7eb;
            font-weight: 600;
            font-size: 0.95rem;
            font-family: 'Courier New', monospace;
            letter-spacing: 0.5px;
            color: #1a1a3e;
            width: 100%;
            background: white;
            cursor: default;
        }

        .auto-gen-section .btn-regenerate {
            border-radius: 10px;
            padding: 8px 20px;
            font-weight: 600;
            transition: all 0.3s ease;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            border: none;
            color: white;
            font-size: 0.85rem;
        }

            .auto-gen-section .btn-regenerate:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(245, 158, 11, 0.3);
            }

            .auto-gen-section .btn-regenerate:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none;
            }

        .auto-gen-section .btn-toggle-password {
            border-radius: 0 10px 10px 0;
            padding: 0 18px;
            border: 1px solid #e5e7eb;
            border-left: none;
            background: white;
            color: #6b7280;
            transition: all 0.3s ease;
        }

            .auto-gen-section .btn-toggle-password:hover {
                color: #6366f1;
                background: #f8fafc;
            }

        .auto-gen-section .input-group .credential-field {
            border-radius: 0;
            border-left: none;
            border-right: none;
        }

            .auto-gen-section .input-group .credential-field:first-child {
                border-radius: 10px 0 0 10px;
                border-left: 1px solid #e5e7eb;
            }

    /* ----- Success Alert ----- */
    .success-alert-modern {
        border: none;
        border-radius: 14px;
        padding: 20px 24px;
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        border-left: 4px solid #22c55e;
        margin-bottom: 24px;
        position: relative;
        animation: slideDown 0.5s ease;
    }

 

    .success-alert-modern h6 {
        color: #065f46;
        font-weight: 600;
        margin: 0 0 12px 0;
    }

    .success-alert-modern .credentials-box {
        background: white;
        border-radius: 10px;
        padding: 14px 18px;
        border: 1px solid #e5e7eb;
        display: flex;
        flex-wrap: wrap;
        gap: 16px 24px;
    }

        .success-alert-modern .credentials-box .cred-item {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

            .success-alert-modern .credentials-box .cred-item .label {
                font-weight: 600;
                color: #374151;
                font-size: 0.85rem;
            }

            .success-alert-modern .credentials-box .cred-item .value {
                padding: 4px 14px;
                border-radius: 6px;
                font-weight: 600;
                font-size: 0.85rem;
                font-family: 'Courier New', monospace;
            }

                .success-alert-modern .credentials-box .cred-item .value.id {
                    background: #e0e7ff;
                    color: #4338ca;
                }

                .success-alert-modern .credentials-box .cred-item .value.pass {
                    background: #fef3c7;
                    color: #92400e;
                }

            .success-alert-modern .credentials-box .cred-item .btn-copy {
                padding: 2px 10px;
                font-size: 0.75rem;
                border-radius: 6px;
                border: 1px solid #e5e7eb;
                background: white;
                color: #6b7280;
                transition: all 0.3s ease;
                cursor: pointer;
            }

                .success-alert-modern .credentials-box .cred-item .btn-copy:hover {
                    background: #f3f4f6;
                    color: #1a1a3e;
                }

    /* ----- Action Buttons ----- */
    .action-buttons-modern {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid #f0f2f5;
        margin-top: 20px;
    }

        .action-buttons-modern .btn {
            border-radius: 10px;
            padding: 10px 28px;
            font-weight: 600;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .action-buttons-modern .btn-primary {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            border: none;
            color: white;
        }

            .action-buttons-modern .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 30px rgba(99, 102, 241, 0.3);
            }

            .action-buttons-modern .btn-primary:disabled {
                opacity: 0.7;
                cursor: not-allowed;
                transform: none;
            }

        .action-buttons-modern .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        }



    /* ----- Loading Spinner ----- */
    .spinner-container {
        display: inline-block;
        width: 20px;
        height: 20px;
    }

        .spinner-container .spinner-border {
            width: 18px;
            height: 18px;
            border-width: 2px;
        }

    /* ----- Tooltip Animation ----- */
    .copy-tooltip {
        position: fixed;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: #1a1a3e;
        color: white;
        padding: 8px 24px;
        border-radius: 10px;
        font-size: 0.9rem;
        z-index: 9999;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        animation: fadeInUp 0.3s ease;
        opacity: 1;
        transition: opacity 0.5s ease;
    }

    
</style>

<!-- ============================================
     PAGE HEADER
     ============================================ -->
<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <div class="page-header-modern">
        <div class="header-content">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; font-size: 22px;">
                            <i class="fas fa-chalkboard-teacher"></i>
                        </div>
                        <div>
                            <h2>Add New Teacher</h2>
                            <p>Create a new teacher account with auto-generated credentials</p>
                        </div>
                    </div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="ViewTeachers">Teachers</a></li>
                            <li class="breadcrumb-item active">Add</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-md-4 mt-3 mt-md-0">
                    <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                        <a asp-controller="Admin" asp-action="ViewTeachers" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-list me-1"></i>View All
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================
         MAIN FORM
         ============================================ -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-7">
            <div class="form-card-modern">
                <div class="card-header">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-user-plus text-primary me-2"></i>Teacher Information
                        <span class="badge bg-primary ms-2">New</span>
                    </h5>
                </div>
                <div class="card-body">

                    <!-- Success Alert -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="success-alert-modern" id="successAlert">
                            <h6><i class="fas fa-check-circle me-2" style="color: #22c55e;"></i>@TempData["Success"]</h6>
                            <div class="credentials-box">
                                <div class="cred-item">
                                    <span class="label"><i class="fas fa-id-card"></i> Employee ID:</span>
                                    <span class="value id">@TempData["EmployeeId"]</span>
                                </div>
                                <div class="cred-item">
                                    <span class="label"><i class="fas fa-key"></i> Password:</span>
                                    <span class="value pass">@TempData["Password"]</span>
                                    <button class="btn-copy" onclick="copyText('@TempData["Password"]')" title="Copy password">
                                        <i class="fas fa-copy"></i> Copy
                                    </button>
                                </div>
                            </div>
                            <small class="text-muted d-block mt-2">
                                <i class="fas fa-info-circle me-1"></i>
                                Please save these credentials and share them securely with the teacher.
                            </small>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" style="position: absolute; top: 16px; right: 16px;"></button>
                        </div>
                    }

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Form -->
                    <form method="post" id="addTeacherForm" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label-modern">Full Name</label>
                            <div class="input-group input-group-modern">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input asp-for="FullName" class="form-control form-control-modern" placeholder="Enter full name" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label-modern">Email Address</label>
                            <div class="input-group input-group-modern">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control form-control-modern" type="email" placeholder="Enter email" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="row g-3">
                            <!-- Department -->
                            <div class="col-12 col-sm-6">
                                <label asp-for="Department" class="form-label-modern">Department</label>
                                <div class="input-group input-group-modern">
                                    <span class="input-group-text"><i class="fas fa-building"></i></span>
                                    <select asp-for="Department" class="form-select form-select-modern" required>
                                        <option value="">-- Select --</option>
                                        <option value="Mathematics">Mathematics</option>
                                        <option value="English">English</option>
                                        <option value="Science">Science</option>
                                        <option value="Social Studies">Social Studies</option>
                                        <option value="Languages">Languages</option>
                                        <option value="Arts">Arts</option>
                                        <option value="Physical Education">Physical Education</option>
                                        <option value="ICT">ICT / Computer Science</option>
                                        <option value="Special Education">Special Education</option>
                                        <option value="Administration">Administration</option>
                                        <option value="Counseling">Counseling & Guidance</option>
                                        <option value="Library">Library & Media</option>
                                        <option value="STEM">STEM</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Department" class="text-danger small"></span>
                            </div>

                            <!-- Qualification -->
                            <div class="col-12 col-sm-6">
                                <label asp-for="Qualification" class="form-label-modern">Qualification</label>
                                <div class="input-group input-group-modern">
                                    <span class="input-group-text"><i class="fas fa-graduation-cap"></i></span>
                                    <select asp-for="Qualification" class="form-select form-select-modern">
                                        <option value="">-- Select --</option>
                                        <option value="Ph.D.">Ph.D. (Doctor of Philosophy)</option>
                                        <option value="M.Sc.">M.Sc. (Master of Science)</option>
                                        <option value="M.A.">M.A. (Master of Arts)</option>
                                        <option value="M.Ed.">M.Ed. (Master of Education)</option>
                                        <option value="MBA">MBA (Master of Business Administration)</option>
                                        <option value="B.Sc.">B.Sc. (Bachelor of Science)</option>
                                        <option value="B.A.">B.A. (Bachelor of Arts)</option>
                                        <option value="B.Ed.">B.Ed. (Bachelor of Education)</option>
                                        <option value="PGDE">PGDE (Postgraduate Diploma in Education)</option>
                                        <option value="Diploma">Diploma</option>
                                        <option value="Certificate">Certificate</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Qualification" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Auto-Generated Credentials -->
                        <div class="auto-gen-section mt-4">
                            <div class="section-title">
                                <i class="fas fa-robot"></i>
                                Auto-Generated Credentials
                                <span class="badge bg-primary ms-2">Auto</span>
                            </div>

                            <div class="row g-3">
                                <!-- Employee ID -->
                                <div class="col-12 col-sm-6">
                                    <label class="fw-bold small text-muted">Employee ID</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                        <input asp-for="EmployeeId" id="employeeIdInput" class="credential-field" readonly />
                                    </div>
                                </div>

                                <!-- Password -->
                                <div class="col-12 col-sm-6">
                                    <label class="fw-bold small text-muted">Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-key"></i></span>
                                        <input asp-for="Password" id="passwordInput" class="credential-field" readonly type="password" />
                                        <button class="btn-toggle-password" type="button" onclick="togglePasswordVisibility()" title="Toggle visibility">
                                            <i class="fas fa-eye" id="eyeIcon"></i>
                                        </button>
                                        <button class="btn-regenerate" type="button" onclick="regenerateCredentials()" title="Regenerate">
                                            <i class="fas fa-sync-alt me-1"></i> Regenerate
                                        </button>
                                    </div>
                                    <small class="text-muted">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Double-click the password to copy it
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Info Note -->
                        <div class="alert alert-info d-flex align-items-center gap-2 mt-3" style="border-radius: 10px; border-left: 4px solid #6366f1;">
                            <i class="fas fa-info-circle fs-5" style="color: #6366f1;"></i>
                            <div>
                                <strong>Note:</strong> Employee ID and Password are auto-generated.
                                Click <strong>Regenerate</strong> for a new password.
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons-modern">
                            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="fas fa-save me-2"></i>Add Teacher
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     SCRIPTS
     ============================================ -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ============================================
        // REGENERATE CREDENTIALS
        // ============================================
        function regenerateCredentials() {
            var btn = document.querySelector('.btn-regenerate');
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            fetch('@Url.Action("GenerateCredentials", "Admin")', {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById('employeeIdInput').value = data.employeeId;
                document.getElementById('passwordInput').value = data.password;
                document.getElementById('passwordInput').setAttribute('type', 'password');
                document.getElementById('eyeIcon').className = 'fas fa-eye';

                btn.innerHTML = '<i class="fas fa-check"></i>';
                btn.disabled = false;
                setTimeout(function() {
                    btn.innerHTML = originalHtml;
                }, 1500);
            })
            .catch(function() {
                alert('Failed to regenerate credentials. Please try again.');
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            });
        }

        // ============================================
        // TOGGLE PASSWORD VISIBILITY
        // ============================================
        function togglePasswordVisibility() {
            var passwordInput = document.getElementById('passwordInput');
            var eyeIcon = document.getElementById('eyeIcon');

            if (passwordInput.getAttribute('type') === 'password') {
                passwordInput.setAttribute('type', 'text');
                eyeIcon.className = 'fas fa-eye-slash';
            } else {
                passwordInput.setAttribute('type', 'password');
                eyeIcon.className = 'fas fa-eye';
            }
        }

        // ============================================
        // COPY TO CLIPBOARD
        // ============================================
        function copyText(text) {
            navigator.clipboard.writeText(text).then(function() {
                showTooltip('✓ Copied!');
            }).catch(function() {
                // Fallback
                var tempInput = document.createElement('input');
                tempInput.value = text;
                document.body.appendChild(tempInput);
                tempInput.select();
                document.execCommand('copy');
                tempInput.remove();
                showTooltip('✓ Copied!');
            });
        }

        function showTooltip(message) {
            var tooltip = document.createElement('div');
            tooltip.className = 'copy-tooltip';
            tooltip.textContent = message;
            document.body.appendChild(tooltip);
            setTimeout(function() {
                tooltip.style.opacity = '0';
                setTimeout(function() {
                    tooltip.remove();
                }, 500);
            }, 1500);
        }

        // ============================================
        // DOM CONTENT LOADED
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            // Double-click to copy password
            var passwordInput = document.getElementById('passwordInput');
            if (passwordInput) {
                passwordInput.addEventListener('dblclick', function() {
                    copyText(this.value);
                });
            }

            // Form submit loading state
            var form = document.getElementById('addTeacherForm');
            var submitBtn = document.getElementById('submitBtn');

            if (form && submitBtn) {
                form.addEventListener('submit', function() {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Adding...';
                });
            }

            // Auto-hide success alert
            var successAlert = document.getElementById('successAlert');
            if (successAlert) {
                setTimeout(function() {
                    var alert = new bootstrap.Alert(successAlert);
                    alert.close();
                }, 8000);
            }

            // Keyboard shortcut: Ctrl+Enter
            document.addEventListener('keydown', function(e) {
                if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                    var form = document.getElementById('addTeacherForm');
                    if (form && document.activeElement && document.activeElement.closest('form') === form) {
                        e.preventDefault();
                        form.submit();
                    }
                }
            });
        });
    </script>
}