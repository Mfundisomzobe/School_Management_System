@using School_Management_System.ViewModels
@model AddTeacherViewModel
@{
    ViewData["Title"] = "Add Teacher";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2><i class="fas fa-chalkboard-teacher me-2"></i>Add Teacher</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active">Add Teacher</li>
                    </ol>
                </nav>
            </div>
            <a asp-controller="Admin" asp-action="ViewTeachers" class="btn btn-info text-white">
                <i class="fas fa-list me-2"></i>View Teachers
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i>Teacher Information</h5>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <h5><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</h5>
                        <div class="mt-3 bg-light p-3 rounded">
                            <p><strong><i class="fas fa-id-card me-2"></i>Employee ID:</strong> <span class="badge bg-primary">@TempData["EmployeeId"]</span></p>
                            <p><strong><i class="fas fa-key me-2"></i>Auto-generated Password:</strong> <span class="badge bg-warning text-dark">@TempData["Password"]</span></p>
                            <p class="text-muted small"><i class="fas fa-info-circle me-1"></i>Please save these credentials and share them with the teacher.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post" id="addTeacherForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <!-- Full Name -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control" type="email" placeholder="Enter email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Department -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Department" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-building"></i></span>
                                <select asp-for="Department" class="form-control" required>
                                    <option value="">-- Select Department --</option>
                                    <option value="Mathematics">Mathematics</option>
                                    <option value="English">English</option>
                                    <option value="Science">Science</option>
                                    <option value="Social Studies">Social Studies</option>
                                    <option value="Languages">Languages</option>
                                    <option value="Arts">Arts</option>
                                    <option value="Physical Education">Physical Education</option>
                                    <option value="ICT">ICT / Computer Science</option>
                                    <option value="Special Education">Special Education</option>
                                    <option value="Administration">Administration</option>
                                    <option value="Counseling">Counseling & Guidance</option>
                                    <option value="Library">Library & Media</option>
                                    <option value="STEM">STEM</option>
                                </select>
                            </div>
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <!-- Qualification -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Qualification" class="form-label fw-bold">Qualification</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-graduation-cap"></i></span>
                                <select asp-for="Qualification" class="form-control">
                                    <option value="">-- Select Qualification --</option>
                                    <option value="Ph.D.">Ph.D. (Doctor of Philosophy)</option>
                                    <option value="M.Sc.">M.Sc. (Master of Science)</option>
                                    <option value="M.A.">M.A. (Master of Arts)</option>
                                    <option value="M.Ed.">M.Ed. (Master of Education)</option>
                                    <option value="MBA">MBA (Master of Business Administration)</option>
                                    <option value="B.Sc.">B.Sc. (Bachelor of Science)</option>
                                    <option value="B.A.">B.A. (Bachelor of Arts)</option>
                                    <option value="B.Ed.">B.Ed. (Bachelor of Education)</option>
                                    <option value="PGDE">PGDE (Postgraduate Diploma in Education)</option>
                                    <option value="Diploma">Diploma</option>
                                    <option value="Certificate">Certificate</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <span asp-validation-for="Qualification" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Auto-Generated Fields Display - UPDATED WITH BIGGER INPUT -->
                    <div class="row bg-light p-4 rounded mb-3">
                        <div class="col-12">
                            <h5 class="mb-3"><i class="fas fa-robot me-2"></i>Auto-Generated Credentials</h5>
                            <hr />
                        </div>

                        <!-- Employee ID -->
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold fs-6">Employee ID</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="fas fa-id-card"></i></span>
                                <input asp-for="EmployeeId" id="employeeIdInput" class="form-control form-control-lg" readonly style="font-size: 1.1rem; font-weight: 500; background-color: #f8f9fa;" />
                            </div>
                        </div>

                        <!-- Password - BIGGER VERSION -->
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold fs-6">Password</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                <input asp-for="Password" id="passwordInput" class="form-control form-control-lg" readonly style="font-size: 1.2rem; font-weight: 600; background-color: #f8f9fa; letter-spacing: 1px; font-family: 'Courier New', monospace;" />
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility()" style="padding: 0 20px;">
                                    <i class="fas fa-eye" id="eyeIcon" style="font-size: 1.2rem;"></i>
                                </button>
                                <button type="button" class="btn btn-warning" onclick="regenerateCredentials()" style="padding: 0 25px; font-weight: 600; font-size: 1rem;">
                                    <i class="fas fa-sync me-2"></i> Regenerate
                                </button>
                            </div>
                            <small class="text-muted mt-1 d-block">
                                <i class="fas fa-info-circle me-1"></i>
                                This password will be used for login. Click <strong>Regenerate</strong> for a new one.
                            </small>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Note:</strong> Employee ID and Password are auto-generated. You can regenerate the password above.
                    </div>

                    <hr />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-save me-2"></i>Add Teacher
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Regenerate both credentials
        function regenerateCredentials() {
            var btn = document.querySelector('.btn-warning');
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';
            btn.disabled = true;

            $.ajax({
                url: '/Admin/GenerateCredentials',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    $('#employeeIdInput').val(data.employeeId);
                    $('#passwordInput').val(data.password);

                    btn.innerHTML = '<i class="fas fa-check"></i> Regenerated!';
                    btn.disabled = false;
                    setTimeout(function() {
                        btn.innerHTML = originalHtml;
                    }, 2000);
                },
                error: function() {
                    alert('Failed to regenerate credentials. Please try again.');
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });
        }

        // Toggle password visibility
        function togglePasswordVisibility() {
            var passwordInput = $('#passwordInput');
            var eyeIcon = $('#eyeIcon');

            if (passwordInput.attr('type') === 'password') {
                passwordInput.attr('type', 'text');
                eyeIcon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                passwordInput.attr('type', 'password');
                eyeIcon.removeClass('fa-eye-slash').addClass('fa-eye');
            }
        }

        // Auto-hide success alert after 10 seconds
        $(document).ready(function() {
            setTimeout(function() {
                $('.alert-success').fadeOut('slow');
            }, 10000);
        });

        // Copy password on double-click
        $('#passwordInput').on('dblclick', function() {
            this.select();
            document.execCommand('copy');
            alert('Password copied to clipboard!');
        });
    </script>
}