@model List<Parent>
@{
    ViewData["Title"] = "View Parents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2><i class="fas fa-users me-2"></i>Parents List</h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item active">Parents</li>
                        </ol>
                    </nav>
                </div>
                <a asp-controller="Admin" asp-action="AddParent" class="btn btn-primary">
                    <i class="fas fa-user-plus me-2"></i>Add New Parent
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="parentTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Occupation</th>
                            <th>Children</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var parent in Model)
                        {
                            <tr>
                                <td>@parent.Id</td>
                                <td><i class="fas fa-user-circle me-2 text-warning"></i>@parent.User.FullName</td>
                                <td><i class="fas fa-envelope me-1 text-muted"></i>@parent.User.Email</td>
                                <td><i class="fas fa-phone me-1 text-muted"></i>@parent.PhoneNumber</td>
                                <td>@(string.IsNullOrEmpty(parent.Occupation) ? "-" : parent.Occupation)</td>
                                <td>
                                    @if (parent.StudentParents != null && parent.StudentParents.Any(sp => sp.IsActive))
                                    {
                                @string.Join(", ", parent.StudentParents
                                                                .Where(sp => sp.IsActive)
                                                                .Select(sp => sp.Student.User.FullName + " (" + sp.Relationship + ")"))
                                                                }
                                    else
                                    {
                                        <span class="text-muted">No children</span>
                                    }
                                </td>
                                <td>
                                    @if (parent.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (parent.IsActive)
                                    {
                                        <a asp-controller="Admin" asp-action="EditParent" asp-route-id="@parent.Id"
                                           class="btn btn-warning btn-sm" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-controller="Admin" asp-action="DeleteParent" asp-route-id="@parent.Id"
                                           class="btn btn-danger btn-sm" title="Deactivate"
                                           onclick="return confirm('Are you sure you want to deactivate this parent?');">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Admin" asp-action="ReactivateParent" asp-route-id="@parent.Id"
                                           class="btn btn-success btn-sm" title="Reactivate"
                                           onclick="return confirm('Are you sure you want to reactivate this parent?');">
                                            <i class="fas fa-undo"></i> Reactivate
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#parentTable').DataTable({
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search parents..."
                }
            });
        });
    </script>
}