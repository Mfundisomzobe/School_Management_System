@model List<Teacher>
@{
    ViewData["Title"] = "View Teachers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2><i class="fas fa-chalkboard-teacher me-2"></i>Teachers</h2>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item active">Teachers</li>
                    </ol>
                </nav>
            </div>
            <a asp-controller="Admin" asp-action="AddTeacher" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add Teacher
            </a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table datatable" id="teacherTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Employee ID</th>
                        <th>Department</th>
                        <th>Qualification</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int index = 1;
                        foreach (var teacher in Model)
                        {
                            <tr>
                                <td>@index</td>
                                <td><i class="fas fa-user-circle me-2 text-primary"></i>@teacher.User.FullName</td>
                                <td>@teacher.User.Email</td>
                                <td><span class="badge bg-secondary">@teacher.EmployeeId</span></td>
                                <td>@teacher.Department</td>
                                <td>@teacher.Qualification</td>
                                <td>
                                    @if (teacher.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                        <a asp-controller="Admin" asp-action="EditTeacher" asp-route-id="@teacher.Id" class="btn btn-primary">
                                            Edit
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4">
                                <i class="fas fa-info-circle me-2"></i>No teachers found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
