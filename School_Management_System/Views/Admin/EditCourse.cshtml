@using School_Management_System.ViewModels
@model EditCourseViewModel
@{
    ViewData["Title"] = "Edit Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-edit text-warning me-2"></i>Edit Course
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item"><a asp-action="ViewCourses" class="text-decoration-none">Courses</a></li>
                            <li class="breadcrumb-item active">Edit</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="ViewCourses" class="btn btn-secondary btn-sm w-100 w-sm-auto">
                    <i class="fas fa-arrow-left me-1"></i>Back to Courses
                </a>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark py-2 py-md-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-edit me-2"></i>Edit Course Information
                    </h5>
                </div>
                <div class="card-body p-3 p-md-4">
                    <form method="post" asp-action="EditCourse">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CourseId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Course Code -->
                        <div class="mb-3">
                            <label asp-for="CourseCode" class="form-label fw-bold">
                                <i class="fas fa-tag me-1 text-warning"></i>Course Code
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                <input asp-for="CourseCode" class="form-control" placeholder="e.g., MATH101" />
                            </div>
                            <span asp-validation-for="CourseCode" class="text-danger small"></span>
                            <div class="form-text">A unique identifier for the course (e.g., MATH101, ENG201).</div>
                        </div>

                        <!-- Course Name -->
                        <div class="mb-3">
                            <label asp-for="CourseName" class="form-label fw-bold">
                                <i class="fas fa-book me-1 text-warning"></i>Course Name
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-book"></i></span>
                                <input asp-for="CourseName" class="form-control" placeholder="e.g., Mathematics 101" />
                            </div>
                            <span asp-validation-for="CourseName" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="CourseDescription" class="form-label fw-bold">
                                <i class="fas fa-align-left me-1 text-warning"></i>Description
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-align-left"></i></span>
                                <textarea asp-for="CourseDescription" class="form-control" rows="4"
                                          placeholder="Enter course description..."></textarea>
                            </div>
                            <span asp-validation-for="CourseDescription" class="text-danger small"></span>
                            <div class="form-text">Optional description of the course content and objectives.</div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-end mt-4">
                            <a asp-action="ViewCourses" class="btn btn-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save me-1"></i>Update Course
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}