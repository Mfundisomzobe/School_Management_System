@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-tachometer-alt text-primary me-2"></i>Admin Dashboard
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item active">Dashboard</li>
                        </ol>
                    </nav>
                </div>
                <span class="badge bg-primary role-badge">
                    <i class="fas fa-user-shield me-1"></i>Administrator
                </span>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-2 g-sm-3 g-md-4 mb-3 mb-md-4">
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="label">Teachers</div>
                        <div class="number">@ViewBag.TotalTeachers</div>
                    </div>
                    <div class="icon">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="label">Students</div>
                        <div class="number">@ViewBag.TotalStudents</div>
                    </div>
                    <div class="icon">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="label">Courses</div>
                        <div class="number">@ViewBag.TotalCourses</div>
                    </div>
                    <div class="icon">
                        <i class="fas fa-book"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="label">Classes</div>
                        <div class="number">@ViewBag.TotalClasses</div>
                    </div>
                    <div class="icon">
                        <i class="fas fa-chalkboard"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Management Cards -->
    <div class="row g-3">
        <!-- Teacher Management -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow h-100 card-hover">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-chalkboard-teacher me-2"></i>Teacher Management</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Add, edit, or view teacher records.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="AddTeacher" class="btn btn-primary btn-sm">
                            <i class="fas fa-user-plus me-1"></i>Add Teacher
                        </a>
                        <a asp-action="ViewTeachers" class="btn btn-info btn-sm text-white">
                            <i class="fas fa-users me-1"></i>View Teachers
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Student Management -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow h-100 card-hover">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-user-graduate me-2"></i>Student Management</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Add, edit, or view student records.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="AddStudent" class="btn btn-success btn-sm">
                            <i class="fas fa-user-plus me-1"></i>Add Student
                        </a>
                        <a asp-action="ViewStudents" class="btn btn-info btn-sm text-white">
                            <i class="fas fa-users me-1"></i>View Students
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Course Management -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow h-100 card-hover">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-book me-2"></i>Course Management</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Add, edit, or view course records.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="CreateCourse" class="btn btn-info btn-sm text-white">
                            <i class="fas fa-plus me-1"></i>Add Course
                        </a>
                        <a asp-action="ViewCourses" class="btn btn-secondary btn-sm">
                            <i class="fas fa-list me-1"></i>View Courses
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Class Management -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow h-100 card-hover">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-chalkboard me-2"></i>Class Management</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Add, edit, or view class sections.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="CreateClass" class="btn btn-warning btn-sm">
                            <i class="fas fa-plus me-1"></i>Add Class
                        </a>
                        <a asp-action="ViewClasses" class="btn btn-secondary btn-sm">
                            <i class="fas fa-list me-1"></i>View Classes
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Parent Management -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow h-100 card-hover">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0"><i class="fas fa-users me-2"></i>Parent Management</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Manage parent accounts and links.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="AddParent" class="btn btn-secondary btn-sm text-white">
                            <i class="fas fa-user-plus me-1"></i>Add Parent
                        </a>
                        <a asp-action="ViewParents" class="btn btn-info btn-sm text-white">
                            <i class="fas fa-list me-1"></i>View Parents
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Audit Logs -->
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow h-100 card-hover">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Audit Logs</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">View system activity logs.</p>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="ViewAuditLogs" class="btn btn-dark btn-sm text-white">
                            <i class="fas fa-history me-1"></i>View Logs
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.1) !important;
        }
</style>