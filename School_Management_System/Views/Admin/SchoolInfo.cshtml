@model IEnumerable<School_Management_System.Models.SchoolInfo>
@{
    ViewData["Title"] = "School Information";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h1 class="page-title">@ViewData["Title"]</h1>

    <div class="mb-3">
        <a asp-action="AddSchool" class="btn btn-success">AddSchool Information</a>
    </div>

    <div class="card glassmorphic">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.First().SchoolName)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Address)</th>
                        <th>@Html.DisplayNameFor(model => model.First().PhoneNumber)</th>
                        <th>@Html.DisplayNameFor(model => model.First().Email)</th>
                        <th>@Html.DisplayNameFor(model => model.First().WebsiteUrl)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.SchoolName)</td>
                            <td>@Html.DisplayFor(modelItem => item.Address)</td>
                            <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                            <td>@Html.DisplayFor(modelItem => item.Email)</td>
                            <td>@Html.DisplayFor(modelItem => item.WebsiteUrl)</td>
                            <td>
                                <a asp-action="EditSchool" asp-route-id="@item.SchoolInfoId" class="btn btn-warning btn-sm">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a asp-action="DeleteSchool" asp-route-id="@item.SchoolInfoId" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this hospital?');">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-blue: #0097f8;
        --secondary-blue: #00b5f8;
        --accent-blue: #60a5fa;
        --light-blue: #dbeafe;
        --dark-blue: #1e3a8a;
        --gradient-primary: linear-gradient(135deg, #0097f8 0%, #3b82f6 100%);
        --gradient-secondary: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
        --gradient-success: linear-gradient(135deg, #059669 0%, #10b981 100%);
        --glass-bg: rgba(255, 255, 255, 0.15);
        --glass-border: rgba(255, 255, 255, 0.2);
        --shadow-blue: 0 8px 32px 0 rgba(30, 64, 175, 0.3);
    }

    body {
        background: linear-gradient(135deg, #0097f8 0%, #0097f8 50%, #00b5f8 100%);
        min-height: 100vh;
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        margin: 0;
        padding: 0;
    .container {
        margin-top: 20px;
    }

    .page-title {
        font-size: 2rem;
        margin-bottom: 20px;
        text-align: center;
    }

    .card {
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        margin-top: 20px;
    }

    .glassmorphic {
        background: rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .table th {
        background-color: #f8f9fa;
        font-weight: bold;
    }

    .btn {
        margin-right: 5px;
    }

    .btn-success {
        margin-bottom: 15px; /* Space below the add button */
    }
</style>
