@model List<Course>
@{
    ViewData["Title"] = "Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-book text-primary me-2"></i>Courses
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item active">Courses</li>
                        </ol>
                    </nav>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="CreateCourse" class="btn btn-primary btn-sm w-100 w-sm-auto">
                        <i class="fas fa-plus me-1"></i>Add New Course
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search & Filter -->
    <div class="row mb-3">
        <div class="col-12 col-md-8">
            <form method="get" asp-action="ViewCourses" class="d-flex gap-2 flex-wrap">
                <div class="input-group flex-grow-1">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search courses..." value="@ViewBag.SearchTerm" />
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="showInactive" value="true"
                               id="showInactive" @(ViewBag.ShowInactive == true ? "checked" : "")
                               onchange="this.form.submit()" />
                        <label class="form-check-label" for="showInactive">Show Inactive</label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Search</button>
                    <a asp-action="ViewCourses" class="btn btn-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Courses Table -->
    <div class="card shadow">
        <div class="card-header bg-white py-2 py-md-3">
            <h5 class="mb-0 fw-bold fs-6 fs-md-5">
                <i class="fas fa-list text-primary me-2"></i>All Courses
                <span class="badge bg-secondary ms-2">@ViewBag.TotalCount</span>
            </h5>
        </div>
        <div class="card-body p-2 p-md-3">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0" id="courseTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Course Code</th>
                                <th>Course Name</th>
                                <th class="d-none d-md-table-cell">Description</th>
                                <th class="d-none d-sm-table-cell">Classes</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                var activeClasses = course.Classes?.Count(c => c.IsActive) ?? 0;
                                <tr>
                                    <td>@course.CourseId</td>
                                    <td><span class="badge bg-secondary">@course.CourseCode</span></td>
                                    <td>@course.CourseName</td>
                                    <td class="d-none d-md-table-cell">@(string.IsNullOrEmpty(course.CourseDescription) ? "-" : course.CourseDescription)</td>
                                    <td class="d-none d-sm-table-cell">
                                        <span class="badge bg-info">@activeClasses</span>
                                        
                                    </td>
                                    <td>
                                        @if (course.IsActive)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="fas fa-times-circle me-1"></i>Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            @if (course.IsActive)
                                            {
                                                <!-- Show Edit and Delete for Active courses -->
                                                <a asp-action="EditCourse" asp-route-id="@course.CourseId" class="btn btn-warning btn-sm" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="DeleteCourse" asp-route-id="@course.CourseId" class="btn btn-danger btn-sm" title="Deactivate"
                                                   onclick="return confirm('Are you sure you want to deactivate this course?');">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <!-- Show Reactivate for Inactive courses -->
                                                <a asp-action="ReactivateCourse" asp-route-id="@course.CourseId" class="btn btn-success btn-sm" title="Reactivate"
                                                   onclick="return confirm('Are you sure you want to reactivate this course?');">
                                                    <i class="fas fa-undo me-1"></i>Reactivate
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 py-md-5">
                    <i class="fas fa-book fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No Courses Found</h5>
                    <p class="text-muted small">
                        @(ViewBag.ShowInactive == true ? "No courses match your search criteria." : "Start by adding your first course.")
                    </p>
                    <a asp-action="CreateCourse" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus me-1"></i>Add New Course
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-3">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="ViewCourses" asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-showInactive="@ViewBag.ShowInactive">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="ViewCourses" asp-route-page="@i"
                           asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-showInactive="@ViewBag.ShowInactive">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="ViewCourses" asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-showInactive="@ViewBag.ShowInactive">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#courseTable').DataTable({
                responsive: true,
                paging: false,
                searching: false,
                info: false,
                columnDefs: [
                    { orderable: false, targets: [6] }
                ]
            });
        });
    </script>
}