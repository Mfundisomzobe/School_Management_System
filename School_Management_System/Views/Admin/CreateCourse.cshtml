@using School_Management_System.ViewModels
@model CreateCourseViewModel
@{
    ViewData["Title"] = "Create Course";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ========================================
           MODERN CREATE COURSE STYLES
           ======================================== */

    /* ----- Page Header ----- */
    .page-header-modern {
        background: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #2d1b69 100%);
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 28px;
        position: relative;
        overflow: hidden;
    }

        .page-header-modern::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.08);
            animation: floatOrb 8s ease-in-out infinite;
        }

        .page-header-modern::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: 10%;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(236, 72, 153, 0.05);
            animation: floatOrb 10s ease-in-out infinite reverse;
        }

   

    .page-header-modern .header-content {
        position: relative;
        z-index: 1;
    }

    .page-header-modern h2 {
        color: white;
        font-weight: 700;
        margin: 0;
        font-size: 1.6rem;
    }

    .page-header-modern p {
        color: rgba(255,255,255,0.5);
        margin: 4px 0 0;
        font-size: 0.95rem;
    }

    .page-header-modern .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 8px 0 0;
    }

    .page-header-modern .breadcrumb-item a {
        color: rgba(255,255,255,0.4);
        text-decoration: none;
        transition: color 0.3s ease;
        font-size: 0.85rem;
    }

        .page-header-modern .breadcrumb-item a:hover {
            color: #818cf8;
        }

    .page-header-modern .breadcrumb-item.active {
        color: rgba(255,255,255,0.6);
        font-size: 0.85rem;
    }

    .page-header-modern .breadcrumb-item::before {
        color: rgba(255,255,255,0.15);
    }

    /* ----- Form Card ----- */
    .form-card-modern {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        overflow: hidden;
        transition: box-shadow 0.3s ease;
    }

        .form-card-modern:hover {
            box-shadow: 0 8px 40px rgba(0,0,0,0.06);
        }

        .form-card-modern .card-header {
            background: white;
            border-bottom: 1px solid #f0f2f5;
            padding: 18px 28px;
        }

        .form-card-modern .card-body {
            padding: 28px;
        }

    /* ----- Form Controls ----- */
    .form-label-modern {
        font-weight: 600;
        font-size: 0.85rem;
        color: #1a1a3e;
        margin-bottom: 6px;
    }

    .form-control-modern {
        border-radius: 10px;
        border: 1.5px solid #e5e7eb;
        padding: 10px 16px;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        background: #fafbfc;
    }

        .form-control-modern:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.08);
            background: white;
        }

        .form-control-modern.is-invalid {
            border-color: #ef4444;
            box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.08);
        }

    textarea.form-control-modern {
        resize: vertical;
        min-height: 100px;
    }

    .input-group-modern .input-group-text {
        background: #f8fafc;
        border: 1.5px solid #e5e7eb;
        border-right: none;
        border-radius: 10px 0 0 10px;
        color: #6b7280;
        font-size: 0.9rem;
        padding: 10px 14px;
    }

    .input-group-modern .form-control {
        border-radius: 0 10px 10px 0;
        border-left: none;
    }

        .input-group-modern .form-control:focus {
            border-color: #6366f1;
        }

    /* ----- Action Buttons ----- */
    .action-buttons-modern {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid #f0f2f5;
        margin-top: 20px;
    }

        .action-buttons-modern .btn {
            border-radius: 10px;
            padding: 10px 28px;
            font-weight: 600;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .action-buttons-modern .btn-primary {
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            border: none;
            color: white;
        }

            .action-buttons-modern .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 30px rgba(99, 102, 241, 0.3);
                color: white;
            }

            .action-buttons-modern .btn-primary:disabled {
                opacity: 0.7;
                cursor: not-allowed;
                transform: none;
            }

        .action-buttons-modern .btn-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        }

    /* ----- Success Alert ----- */
    .success-alert-modern {
        border: none;
        border-radius: 14px;
        padding: 16px 24px;
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        border-left: 4px solid #22c55e;
        margin-bottom: 24px;
        animation: slideDown 0.5s ease;
    }


    .success-alert-modern h6 {
        color: #065f46;
        font-weight: 600;
        margin: 0;
    }


    /* ----- Loading Spinner ----- */
    .btn-loading {
        pointer-events: none;
        opacity: 0.7;
    }

    /* ----- Character Count ----- */
    .char-count {
        font-size: 0.75rem;
        color: #6c757d;
        text-align: right;
        margin-top: 4px;
    }

        .char-count.warning {
            color: #f59e0b;
        }

        .char-count.danger {
            color: #ef4444;
        }
</style>

<!-- ============================================
     PAGE HEADER
     ============================================ -->
<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <div class="page-header-modern">
        <div class="header-content">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; font-size: 22px;">
                            <i class="fas fa-book"></i>
                        </div>
                        <div>
                            <h2>Create New Course</h2>
                            <p>Add a new course to the curriculum</p>
                        </div>
                    </div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                            <li class="breadcrumb-item"><a asp-action="ViewCourses">Courses</a></li>
                            <li class="breadcrumb-item active">Create</li>
                        </ol>
                    </nav>
                </div>
                <div class="col-md-4 mt-3 mt-md-0">
                    <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                        <a asp-action="ViewCourses" class="btn btn-outline-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Back to Courses
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================
         MAIN FORM
         ============================================ -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="form-card-modern">
                <div class="card-header">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-book text-primary me-2"></i>Course Information
                        <span class="badge bg-primary ms-2">New</span>
                    </h5>
                </div>
                <div class="card-body">

                    <!-- Success Alert -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="success-alert-modern" id="successAlert">
                            <h6><i class="fas fa-check-circle me-2" style="color: #22c55e;"></i>@TempData["Success"]</h6>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" style="position: absolute; top: 12px; right: 16px;"></button>
                        </div>
                    }

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Form -->
                    <form method="post" asp-action="CreateCourse" id="createCourseForm" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Course Code -->
                        <div class="mb-3">
                            <label asp-for="CourseCode" class="form-label-modern">
                                <i class="fas fa-tag me-1 text-primary"></i>Course Code
                            </label>
                            <div class="input-group input-group-modern">
                                <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                <input asp-for="CourseCode" class="form-control form-control-modern" placeholder="e.g., MATH101" required />
                            </div>
                            <span asp-validation-for="CourseCode" class="text-danger small"></span>
                            <div class="form-text text-muted small">
                                <i class="fas fa-info-circle me-1"></i>
                                A unique identifier for the course (e.g., MATH101, ENG201)
                            </div>
                        </div>

                        <!-- Course Name -->
                        <div class="mb-3">
                            <label asp-for="CourseName" class="form-label-modern">
                                <i class="fas fa-book me-1 text-primary"></i>Course Name
                            </label>
                            <div class="input-group input-group-modern">
                                <span class="input-group-text"><i class="fas fa-book"></i></span>
                                <input asp-for="CourseName" class="form-control form-control-modern" placeholder="e.g., Mathematics 101" required />
                            </div>
                            <span asp-validation-for="CourseName" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="CourseDescription" class="form-label-modern">
                                <i class="fas fa-align-left me-1 text-primary"></i>Description
                            </label>
                            <div class="input-group input-group-modern">
                                <span class="input-group-text"><i class="fas fa-align-left"></i></span>
                                <textarea asp-for="CourseDescription" class="form-control form-control-modern" rows="4"
                                          placeholder="Enter course description..." id="courseDescription" maxlength="500"></textarea>
                            </div>
                            <span asp-validation-for="CourseDescription" class="text-danger small"></span>
                            <div class="char-count" id="charCount">0 / 500 characters</div>
                            <div class="form-text text-muted small">
                                <i class="fas fa-info-circle me-1"></i>
                                Optional description of the course content and objectives
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="action-buttons-modern">
                            <a asp-action="ViewCourses" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="fas fa-save me-2"></i>Create Course
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     SCRIPTS
     ============================================ -->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ============================================
        // DOM CONTENT LOADED
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            // ============================================
            // CHARACTER COUNTER FOR DESCRIPTION
            // ============================================
            var descriptionInput = document.getElementById('courseDescription');
            var charCount = document.getElementById('charCount');

            if (descriptionInput && charCount) {
                descriptionInput.addEventListener('input', function() {
                    var length = this.value.length;
                    var maxLength = this.getAttribute('maxlength') || 500;
                    charCount.textContent = length + ' / ' + maxLength + ' characters';

                    charCount.classList.remove('warning', 'danger');
                    if (length > maxLength * 0.8) {
                        charCount.classList.add('warning');
                    }
                    if (length >= maxLength) {
                        charCount.classList.add('danger');
                    }
                });

                // Trigger on load
                descriptionInput.dispatchEvent(new Event('input'));
            }

            // ============================================
            // AUTO-UPPERCASE COURSE CODE
            // ============================================
            var courseCodeInput = document.querySelector('input[asp-for="CourseCode"]');
            if (courseCodeInput) {
                courseCodeInput.addEventListener('blur', function() {
                    this.value = this.value.toUpperCase().trim();
                });

                courseCodeInput.addEventListener('input', function() {
                    this.value = this.value.toUpperCase();
                });
            }

            // ============================================
            // FORM SUBMIT LOADING STATE
            // ============================================
            var form = document.getElementById('createCourseForm');
            var submitBtn = document.getElementById('submitBtn');

            if (form && submitBtn) {
                form.addEventListener('submit', function() {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Creating...';
                });
            }

            // ============================================
            // AUTO-HIDE SUCCESS ALERT
            // ============================================
            var successAlert = document.getElementById('successAlert');
            if (successAlert) {
                setTimeout(function() {
                    var alert = new bootstrap.Alert(successAlert);
                    alert.close();
                }, 6000);
            }

            // ============================================
            // AUTO-FOCUS ON FIRST INPUT
            // ============================================
            var firstInput = document.querySelector('input[asp-for="CourseCode"]');
            if (firstInput) {
                firstInput.focus();
            }

            // ============================================
            // KEYBOARD SHORTCUT: Ctrl+Enter to submit
            // ============================================
            document.addEventListener('keydown', function(e) {
                if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                    var form = document.getElementById('createCourseForm');
                    if (form && document.activeElement && document.activeElement.closest('form') === form) {
                        e.preventDefault();
                        form.submit();
                    }
                }
            });
        });
    </script>
}