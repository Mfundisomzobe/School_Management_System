@model List<Enrollment>
@{
    ViewData["Title"] = "Manage Enrollments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-user-graduate me-2"></i>Manage Enrollments</h2>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Select Class</h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="ManageEnrollments">
                <div class="row">
                    <div class="col-md-8">
                        <select name="classId" class="form-control" asp-items="ViewBag.Classes">
                            <option value="">-- Select a Class --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>View Class
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.SelectedClass != null)
    {
        var selectedClass = ViewBag.SelectedClass;
        var enrollmentCount = Model?.Count ?? 0;
        var availableSpots = selectedClass.Capacity - enrollmentCount;

        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    @selectedClass.ClassName -
                    <small>@selectedClass.Course.CourseName</small>
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="alert alert-info">
                            <strong>Teacher:</strong> @selectedClass.Teacher.User.FullName
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="alert alert-info">
                            <strong>Enrolled:</strong> @enrollmentCount / @selectedClass.Capacity
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="alert @(availableSpots > 0 ? "alert-success" : "alert-danger")">
                            <strong>Available Spots:</strong> @availableSpots
                        </div>
                    </div>
                </div>

                @if (availableSpots > 0)
                {
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <select id="studentSelect" class="form-control" asp-items="ViewBag.Students">
                                <option value="">-- Select Student --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-success w-100" onclick="enrollStudent()">
                                <i class="fas fa-user-plus me-2"></i>Enroll Student
                            </button>
                        </div>
                    </div>
                }

                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="enrollmentTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Student Name</th>
                                <th>Admission Number</th>
                                <th>Enrollment Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int index = 1;
                                foreach (var enrollment in Model)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td>@enrollment.Student.User.FullName</td>
                                        <td>@enrollment.Student.AdmissionNumber</td>
                                        <td>@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <a asp-action="RemoveEnrollment" asp-route-enrollmentId="@enrollment.EnrollmentId"
                                               class="btn btn-danger btn-sm"
                                               onclick="return confirm('Are you sure you want to remove this student from the class?');">
                                                <i class="fas fa-user-minus"></i> Remove
                                            </a>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">No students enrolled in this class.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function enrollStudent() {
            var studentId = $('#studentSelect').val();
            var classId = @(ViewBag.SelectedClass?.ClassId ?? 0);

            if (!studentId) {
                alert('Please select a student.');
                return;
            }

            if (!classId) {
                alert('No class selected.');
                return;
            }

            // Submit via form
            var form = document.createElement('form');
            form.method = 'post';
            form.action = '@Url.Action("EnrollStudent", "Admin")';

            var studentInput = document.createElement('input');
            studentInput.type = 'hidden';
            studentInput.name = 'studentId';
            studentInput.value = studentId;

            var classInput = document.createElement('input');
            classInput.type = 'hidden';
            classInput.name = 'classId';
            classInput.value = classId;

            form.appendChild(studentInput);
            form.appendChild(classInput);
            document.body.appendChild(form);
            form.submit();
        }
    </script>
}