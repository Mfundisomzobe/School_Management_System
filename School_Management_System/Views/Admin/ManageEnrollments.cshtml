@model List<Enrollment>
@{
    ViewData["Title"] = "Manage Enrollments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-user-graduate text-success me-2"></i>Manage Enrollments
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item active">Enrollments</li>
                        </ol>
                    </nav>
                </div>
                <a asp-action="ViewClasses" class="btn btn-secondary btn-sm w-100 w-sm-auto">
                    <i class="fas fa-arrow-left me-1"></i>Back to Classes
                </a>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Select Class -->
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white py-2 py-md-3">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-chalkboard me-2"></i>Select a Class
            </h5>
        </div>
        <div class="card-body">
            <form method="get" asp-action="ManageEnrollments" class="row g-2 g-md-3">
                <div class="col-12 col-md-8 col-lg-9">
                    <select name="classId" class="form-select" asp-items="ViewBag.Classes">
                        <option value="">-- Select a Class --</option>
                    </select>
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-eye me-1"></i>View Class
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.SelectedClass != null)
    {
        var selectedClass = ViewBag.SelectedClass;
        var enrollmentCount = ViewBag.EnrollmentCount;
        var availableSpots = ViewBag.AvailableSpots;
        var isFull = availableSpots <= 0;

        <!-- Class Details -->
        <div class="row g-2 g-sm-3 mb-3 mb-md-4">
            <div class="col-6 col-md-3">
                <div class="info-card-sm border-start border-3 border-primary">
                    <div class="label">Class</div>
                    <div class="value text-primary">@selectedClass.ClassName</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="info-card-sm border-start border-3 border-success">
                    <div class="label">Course</div>
                    <div class="value text-success">@selectedClass.Course?.CourseName</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="info-card-sm border-start border-3 border-info">
                    <div class="label">Teacher</div>
                    <div class="value text-info">@selectedClass.Teacher?.User?.FullName</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="info-card-sm border-start border-3 border-warning">
                    <div class="label">Enrollment</div>
                    <div class="value text-warning">@enrollmentCount / @selectedClass.Capacity</div>
                </div>
            </div>
        </div>

        <!-- Enroll Student -->
        @if (availableSpots > 0)
        {
            <div class="card shadow mb-4">
                <div class="card-header bg-success text-white py-2 py-md-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-user-plus me-2"></i>Enroll Student
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-12 col-md-8 col-lg-9">
                            <select id="studentSelect" class="form-select" asp-items="ViewBag.AvailableStudents">
                                <option value="">-- Select Student --</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4 col-lg-3">
                            <button type="button" class="btn btn-success w-100" onclick="enrollStudent()">
                                <i class="fas fa-user-plus me-1"></i>Enroll
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Class is full!</strong> This class has reached its maximum capacity of @selectedClass.Capacity students.
            </div>
        }

        <!-- Enrolled Students -->
        <div class="card shadow">
            <div class="card-header bg-info text-white py-2 py-md-3">
                <h5 class="mb-0 fw-bold">
                    <i class="fas fa-users me-2"></i>Enrolled Students
                    <span class="badge bg-light text-dark ms-2">@enrollmentCount</span>
                </h5>
            </div>
            <div class="card-body p-2 p-md-3">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0" id="enrollmentTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Student Name</th>
                                    <th>Admission No</th>
                                    <th>Class</th>
                                    <th>Enrolled On</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var enrollment in Model.OrderBy(e => e.Student.User.FullName))
                                {
                                    <tr>
                                        <td>@enrollment.EnrollmentId</td>
                                        <td>
                                            <i class="fas fa-user-circle me-1 me-md-2 text-success"></i>
                                            @enrollment.Student.User.FullName
                                        </td>
                                        <td>@enrollment.Student.AdmissionNumber</td>
                                        <td>@enrollment.Class.ClassName</td>
                                        <td>@enrollment.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <a asp-action="RemoveEnrollment" asp-route-enrollmentId="@enrollment.EnrollmentId"
                                               class="btn btn-danger btn-sm action-btn" title="Remove"
                                               onclick="return confirm('Are you sure you want to remove this student from the class?');">
                                                <i class="fas fa-user-minus"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 py-md-5">
                        <i class="fas fa-users fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No Students Enrolled</h5>
                        <p class="text-muted small">This class has no students enrolled yet.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function enrollStudent() {
            var studentId = $('#studentSelect').val();
            var classId = @(ViewBag.SelectedClass?.ClassId ?? 0);

            if (!studentId) {
                alert('Please select a student.');
                return;
            }

            if (!classId) {
                alert('No class selected.');
                return;
            }

            // Submit via form
            var form = document.createElement('form');
            form.method = 'post';
            form.action = '@Url.Action("EnrollStudent", "Admin")';
            form.style.display = 'none';

            var studentInput = document.createElement('input');
            studentInput.type = 'hidden';
            studentInput.name = 'studentId';
            studentInput.value = studentId;

            var classInput = document.createElement('input');
            classInput.type = 'hidden';
            classInput.name = 'classId';
            classInput.value = classId;

            // Add anti-forgery token
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = $('input[name="__RequestVerificationToken"]').val();

            form.appendChild(studentInput);
            form.appendChild(classInput);
            form.appendChild(tokenInput);
            document.body.appendChild(form);
            form.submit();
        }

        $(document).ready(function() {
            $('#enrollmentTable').DataTable({
                responsive: true,
                paging: true,
                pageLength: 10,
                searching: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search enrolled students..."
                },
                columnDefs: [
                    { orderable: false, targets: [5] }
                ]
            });
        });
    </script>
}