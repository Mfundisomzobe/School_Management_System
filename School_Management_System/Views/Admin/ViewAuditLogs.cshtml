@using School_Management_System.ViewModels
@model AuditLogViewModel
@{
    ViewData["Title"] = "Audit Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .log-action {
        font-weight: 600;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        display: inline-block;
    }

        .log-action.Create {
            background-color: #d4edda;
            color: #155724;
        }

        .log-action.Edit {
            background-color: #fff3cd;
            color: #856404;
        }

        .log-action.Delete {
            background-color: #f8d7da;
            color: #721c24;
        }

        .log-action.Login {
            background-color: #d1ecf1;
            color: #0c5460;
        }

        .log-action.Logout {
            background-color: #e2e3e5;
            color: #383d41;
        }

        .log-action.Mark {
            background-color: #cce5ff;
            color: #004085;
        }

        .log-action.Enter {
            background-color: #d1ecf1;
            color: #0c5460;
        }

        .log-action.Enroll {
            background-color: #d4edda;
            color: #155724;
        }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .filter-section {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

 
</style>

<div class="container-fluid px-3 px-md-4 mt-3 mt-md-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 gap-sm-0">
                <div>
                    <h2 class="fw-bold fs-4 fs-md-3">
                        <i class="fas fa-history text-primary me-2"></i>Audit Logs
                    </h2>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item active">Audit Logs</li>
                        </ol>
                    </nav>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="ClearOldLogs" class="btn btn-warning btn-sm"
                       onclick="return confirm('Are you sure you want to clear old logs?');">
                        <i class="fas fa-trash-alt me-1"></i>Clear Old Logs
                    </a>
                    <a asp-action="ExportAuditLogs" class="btn btn-success btn-sm">
                        <i class="fas fa-file-export me-1"></i>Export
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-2 g-sm-3 mb-3 mb-md-4">
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-primary">
                <div class="label">Total Logs</div>
                <div class="value text-primary">@Model.TotalCount</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-success">
                <div class="label">Page Size</div>
                <div class="value text-success">@Model.PageSize</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-info">
                <div class="label">Current Page</div>
                <div class="value text-info">@Model.CurrentPage of @Model.TotalPages</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="info-card-sm border-start border-3 border-warning">
                <div class="label">Pages</div>
                <div class="value text-warning">@Model.TotalPages</div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filter-section">
        <form method="get" asp-action="ViewAuditLogs" class="row g-2 g-md-3">
            <div class="col-12 col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control"
                           placeholder="Search logs..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <select name="filterAction" class="form-select">
                    <option value="">All Actions</option>
                    @if (ViewBag.Actions != null)
                    {
                        foreach (var action in ViewBag.Actions)
                        {
                            var actionValue = action.ToString();
                            <option value="@actionValue" selected="@(Model.FilterAction == actionValue)">
                                @actionValue
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <input type="date" name="filterDate" class="form-control"
                       value="@Model.FilterDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-6 col-md-2">
                <input type="text" name="filterUser" class="form-control"
                       placeholder="User name" value="@Model.FilterUser" />
            </div>
            <div class="col-6 col-md-2">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-filter me-1"></i>Filter
                    </button>
                    <a asp-action="ViewAuditLogs" class="btn btn-secondary">
                        <i class="fas fa-undo me-1"></i>Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Logs Table -->
    <div class="card shadow">
        <div class="card-header bg-white py-2 py-md-3">
            <h5 class="mb-0 fw-bold fs-6 fs-md-5">
                <i class="fas fa-list text-primary me-2"></i>Audit Log Entries
                <span class="badge bg-secondary ms-2">@Model.TotalCount</span>
            </h5>
        </div>
        <div class="card-body p-2 p-md-3">
            @if (Model.Logs != null && Model.Logs.Any())
            {
                <div class="table-responsive-stack">
                    <table class="table table-striped table-hover mb-0" id="auditTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Action</th>
                                <th>User</th>
                                <th class="d-none d-sm-table-cell">Details</th>
                                <th>Date</th>
                                <th class="d-none d-md-table-cell">IP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Logs)
                            {
                                var actionClass = log.Action.Replace(" ", "");
                                var userName = log.FullName ?? log.User?.FullName ?? "System";
                                <tr>
                                    <td>@log.Id</td>
                                    <td>
                                        <span class="log-action @actionClass">@log.Action</span>
                                    </td>
                                    <td>
                                        <i class="fas fa-user me-1"></i>
                                        @userName
                                    </td>
                                    <td class="d-none d-sm-table-cell">
                                        <span class="small">
                                            @if (log.Details?.Length > 50)
                                            {
                                                @(log.Details.Substring(0, 50) + "...")
                                            }
                                            else
                                            {
                                                @log.Details
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <span class="small" title="@log.ActionDate.ToString("yyyy-MM-dd HH:mm:ss")">
                                            @log.ActionDate.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>
                                    <td class="d-none d-md-table-cell">
                                        <span class="small text-muted">@(log.IpAddress ?? "-")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="pagination-container mt-3">
                    <div class="text-muted small">
                        Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to
                        @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount entries
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="ViewAuditLogs"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-filterAction="@Model.FilterAction"
                                   asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
                                   asp-route-filterUser="@Model.FilterUser">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="ViewAuditLogs"
                                       asp-route-page="@i"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-filterAction="@Model.FilterAction"
                                       asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
                                       asp-route-filterUser="@Model.FilterUser">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="ViewAuditLogs"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-filterAction="@Model.FilterAction"
                                   asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
                                   asp-route-filterUser="@Model.FilterUser">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
            else
            {
                <div class="text-center py-4 py-md-5">
                    <i class="fas fa-info-circle fa-3x fa-md-4x text-muted mb-3"></i>
                    <h5 class="text-muted fs-6 fs-md-5">No Audit Logs Found</h5>
                    <p class="text-muted small">No audit logs match your search criteria.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            if ($('#auditTable').length > 0) {
                $('#auditTable').DataTable({
                    responsive: true,
                    paging: false,
                    searching: false,
                    info: false,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search logs..."
                    },
                    columnDefs: [
                        { orderable: false, targets: [0, 1, 2, 3, 4, 5] }
                    ]
                });
            }
        });
    </script>
}