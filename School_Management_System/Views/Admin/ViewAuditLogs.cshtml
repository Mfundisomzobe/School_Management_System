@using School_Management_System.ViewModels
@model AuditLogViewModel
@{
    ViewData["Title"] = "Audit Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ========================================
           MODERN AUDIT LOGS STYLES
           ======================================== */

    .audit-header {
        background: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #2d1b69 100%);
        border-radius: 16px;
        padding: 25px 30px;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
    }

        .audit-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.08);
            animation: floatOrb 8s ease-in-out infinite;
        }

        .audit-header::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: 10%;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(236, 72, 153, 0.05);
            animation: floatOrb 10s ease-in-out infinite reverse;
        }

  
    .audit-header .header-content {
        position: relative;
        z-index: 1;
    }

    .audit-header h2 {
        color: white;
        font-weight: 700;
        margin: 0;
    }

    .audit-header p {
        color: rgba(255,255,255,0.5);
        margin: 5px 0 0;
        font-size: 0.9rem;
    }

    /* ----- Stat Cards ----- */
    .stat-card-audit {
        padding: 16px 20px;
        border-radius: 12px;
        background: white;
        border-left: 4px solid;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        transition: all 0.3s ease;
        height: 100%;
    }

        .stat-card-audit:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
        }

        .stat-card-audit .label {
            font-size: 0.75rem;
            color: #6c757d;
            text-transform: uppercase;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .stat-card-audit .value {
            font-size: 1.5rem;
            font-weight: 700;
            margin-top: 4px;
        }

        .stat-card-audit .sub {
            font-size: 0.7rem;
            color: #6c757d;
            margin-top: 2px;
        }

        .stat-card-audit.border-primary {
            border-color: #6366f1;
        }

        .stat-card-audit.border-success {
            border-color: #22c55e;
        }

        .stat-card-audit.border-info {
            border-color: #06b6d4;
        }

        .stat-card-audit.border-warning {
            border-color: #f59e0b;
        }

        .stat-card-audit .value.text-primary {
            color: #6366f1;
        }

        .stat-card-audit .value.text-success {
            color: #22c55e;
        }

        .stat-card-audit .value.text-info {
            color: #06b6d4;
        }

        .stat-card-audit .value.text-warning {
            color: #f59e0b;
        }

    /* ----- Log Actions ----- */
    .log-action {
        font-weight: 600;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        display: inline-block;
        white-space: nowrap;
    }

        .log-action.Create {
            background: #d4edda;
            color: #155724;
        }

        .log-action.Edit {
            background: #fff3cd;
            color: #856404;
        }

        .log-action.Delete {
            background: #f8d7da;
            color: #721c24;
        }

        .log-action.Login {
            background: #d1ecf1;
            color: #0c5460;
        }

        .log-action.Logout {
            background: #e2e3e5;
            color: #383d41;
        }

        .log-action.Mark {
            background: #cce5ff;
            color: #004085;
        }

        .log-action.Enter {
            background: #d1ecf1;
            color: #0c5460;
        }

        .log-action.Enroll {
            background: #d4edda;
            color: #155724;
        }

        .log-action.Clear {
            background: #f8d7da;
            color: #721c24;
        }

        .log-action.Export {
            background: #d1ecf1;
            color: #0c5460;
        }

    /* ----- Filter Section ----- */
    .filter-section {
        background: white;
        padding: 20px 24px;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        margin-bottom: 24px;
        border: 1px solid #f0f2f5;
    }

        .filter-section .form-control,
        .filter-section .form-select {
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            padding: 8px 14px;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

            .filter-section .form-control:focus,
            .filter-section .form-select:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            }

        .filter-section .input-group-text {
            background: white;
            border: 1px solid #e5e7eb;
            border-right: none;
            border-radius: 10px 0 0 10px;
            color: #9ca3af;
        }

        .filter-section .input-group .form-control {
            border-radius: 0 10px 10px 0;
        }

        .filter-section .btn {
            border-radius: 10px;
            padding: 8px 18px;
            font-weight: 500;
            font-size: 0.85rem;
        }

    /* ----- Table ----- */
    .card-audit {
        border: none;
        border-radius: 16px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.04);
        overflow: hidden;
    }

        .card-audit .card-header {
            background: white;
            border-bottom: 1px solid #f3f4f6;
            padding: 16px 24px;
        }

        .card-audit .card-body {
            padding: 16px 24px;
        }

    .table-audit {
        margin: 0;
    }

        .table-audit thead th {
            background: #f8fafc;
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6b7280;
            border-bottom: 1px solid #f0f2f5;
            padding: 10px 12px;
        }

        .table-audit tbody td {
            padding: 10px 12px;
            font-size: 0.85rem;
            vertical-align: middle;
        }

        .table-audit tbody tr {
            transition: background 0.2s ease;
        }

            .table-audit tbody tr:hover {
                background: #f8fafc;
            }

    /* ----- Pagination ----- */
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 16px;
        border-top: 1px solid #f3f4f6;
        margin-top: 16px;
    }

        .pagination-container .info-text {
            color: #6c757d;
            font-size: 0.8rem;
        }

    .pagination .page-link {
        border-radius: 8px;
        border: none;
        padding: 6px 14px;
        font-size: 0.8rem;
        color: #6b7280;
        transition: all 0.3s ease;
        margin: 0 2px;
    }

        .pagination .page-link:hover {
            background: rgba(99, 102, 241, 0.08);
            color: #6366f1;
        }

    .pagination .page-item.active .page-link {
        background: #6366f1;
        color: white;
    }

    .pagination .page-item.disabled .page-link {
        color: #d1d5db;
        cursor: not-allowed;
    }

    /* ----- Empty State ----- */
    .empty-state {
        padding: 50px 20px;
        text-align: center;
    }

        .empty-state .icon {
            font-size: 3.5rem;
            color: #d1d5db;
            margin-bottom: 16px;
        }

        .empty-state h5 {
            color: #374151;
            font-weight: 600;
        }

        .empty-state p {
            color: #6c757d;
            font-size: 0.9rem;
            max-width: 400px;
            margin: 0 auto;
        }


    /* ----- Tooltip ----- */
    .detail-tooltip {
        cursor: pointer;
        color: #6366f1;
        font-size: 0.8rem;
        transition: color 0.3s ease;
    }

        .detail-tooltip:hover {
            color: #4f46e5;
        }

    /* ----- Quick Stats Badge ----- */
    .stat-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 500;
    }

        .stat-badge.total {
            background: rgba(99, 102, 241, 0.1);
            color: #6366f1;
        }

        .stat-badge.today {
            background: rgba(34, 197, 94, 0.1);
            color: #22c55e;
        }

        .stat-badge.week {
            background: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
        }
</style>

<!-- ============================================
     HEADER
     ============================================ -->
<div class="audit-header">
    <div class="header-content">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 20px;">
                        <i class="fas fa-history"></i>
                    </div>
                    <div>
                        <h2>Audit Logs</h2>
                        <p>Track all system activities and user actions</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mt-3 mt-md-0">
                <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                    <a asp-action="ClearOldLogs" class="btn btn-outline-danger btn-sm"
                       onclick="return confirm('Are you sure you want to clear old logs?');">
                        <i class="fas fa-trash-alt me-1"></i>Clear Old
                    </a>
                    <a asp-action="ExportAuditLogs" class="btn btn-success btn-sm">
                        <i class="fas fa-file-export me-1"></i>Export
                    </a>
                    <a asp-action="Dashboard" class="btn btn-outline-light btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================
     ALERTS
     ============================================ -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ============================================
     STATS CARDS
     ============================================ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card-audit border-primary">
            <div class="label">Total Logs</div>
            <div class="value text-primary">@Model.TotalCount</div>
            <div class="sub">All time records</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card-audit border-success">
            <div class="label">Page Size</div>
            <div class="value text-success">@Model.PageSize</div>
            <div class="sub">Per page</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card-audit border-info">
            <div class="label">Current Page</div>
            <div class="value text-info">@Model.CurrentPage</div>
            <div class="sub">of @Model.TotalPages pages</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card-audit border-warning">
            <div class="label">Total Pages</div>
            <div class="value text-warning">@Model.TotalPages</div>
            <div class="sub">Available pages</div>
        </div>
    </div>
</div>

<!-- ============================================
     FILTERS
     ============================================ -->
<!-- ============================================
     FILTERS - USING ASP-ITEMS (RECOMMENDED)
     ============================================ -->
<div class="filter-section">
    <form method="get" asp-action="ViewAuditLogs" class="row g-2 g-md-3 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small fw-bold text-muted">Search</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" name="searchTerm" class="form-control"
                       placeholder="Search by action, user, details..." value="@Model.SearchTerm" />
            </div>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-bold text-muted">Action</label>
            <select name="filterAction" class="form-select" asp-items="ViewBag.Actions">
                <option value="">All Actions</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-bold text-muted">Date</label>
            <input type="date" name="filterDate" class="form-control"
                   value="@Model.FilterDate?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small fw-bold text-muted">User</label>
            <input type="text" name="filterUser" class="form-control"
                   placeholder="Username" value="@Model.FilterUser" />
        </div>
        <div class="col-6 col-md-2">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
                <a asp-action="ViewAuditLogs" class="btn btn-secondary">
                    <i class="fas fa-undo me-1"></i>Reset
                </a>
            </div>
        </div>
    </form>
</div>
<!-- ============================================
     LOGS TABLE
     ============================================ -->
<div class="card-audit">
    <div class="card-header">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="fas fa-list text-primary me-2"></i>Audit Log Entries
                <span class="badge bg-secondary ms-2">@Model.TotalCount</span>
            </h5>
            <div class="d-flex gap-2">
                <span class="stat-badge total"><i class="fas fa-database"></i> @Model.TotalCount</span>
                <span class="stat-badge today"><i class="fas fa-calendar-day"></i> Today</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Logs != null && Model.Logs.Any())
        {
            <div class="table-responsive">
                <table class="table table-audit" id="auditTable">
                    <thead>
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Action</th>
                            <th>User</th>
                            <th class="d-none d-sm-table-cell">Details</th>
                            <th style="min-width: 140px;">Date</th>
                           
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            var actionClass = log.Action.Replace(" ", "");
                            var userName = log.FullName ?? log.User?.FullName ?? "System";
                            <tr>
                                <td>@log.Id</td>
                                <td>
                                    <span class="log-action @actionClass">@log.Action</span>
                                </td>
                                <td>
                                    <i class="fas fa-user-circle me-1 text-muted"></i>
                                    @userName
                                </td>
                                <td class="d-none d-sm-table-cell">
                                    <span class="small text-muted" title="@log.Details">
                                        @if (log.Details?.Length > 60)
                                        {
                                            @(log.Details.Substring(0, 60) + "...")
                                        }
                                        else
                                        {
                                            @log.Details
                                        }
                                    </span>
                                </td>
                                <td>
                                    <span class="small" title="@log.ActionDate.ToString("yyyy-MM-dd HH:mm:ss")">
                                        <i class="far fa-clock me-1 text-muted"></i>
                                        @log.ActionDate.ToString("dd MMM yyyy HH:mm")
                                    </span>
                                </td>
                             
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="pagination-container">
                <div class="info-text">
                    Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) to
                    @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount entries
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="ViewAuditLogs"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-filterAction="@Model.FilterAction"
                               asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
                               asp-route-filterUser="@Model.FilterUser">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            var startPage = Math.Max(1, Model.CurrentPage - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="ViewAuditLogs"
                                   asp-route-page="1"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-filterAction="@Model.FilterAction"
                                   asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
                                   asp-route-filterUser="@Model.FilterUser">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="ViewAuditLogs"
                                   asp-route-page="@i"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-filterAction="@Model.FilterAction"
                                   asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
                                   asp-route-filterUser="@Model.FilterUser">
                                    @i
                                </a>
                            </li>
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            @if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="ViewAuditLogs"
                                   asp-route-page="@Model.TotalPages"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-filterAction="@Model.FilterAction"
                                   asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
                                   asp-route-filterUser="@Model.FilterUser">
                                    @Model.TotalPages
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="ViewAuditLogs"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-filterAction="@Model.FilterAction"
                               asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
                               asp-route-filterUser="@Model.FilterUser">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <h5>No Audit Logs Found</h5>
                <p>No audit logs match your search criteria. Try adjusting your filters or search terms.</p>
                <a asp-action="ViewAuditLogs" class="btn btn-primary btn-sm mt-2">
                    <i class="fas fa-undo me-1"></i>Reset Filters
                </a>
            </div>
        }
    </div>
</div>

<!-- ============================================
     SCRIPTS
     ============================================ -->
@section Scripts {
    <script>
        $(document).ready(function() {
            // Initialize DataTable for sorting only
            if ($('#auditTable').length > 0) {
                $('#auditTable').DataTable({
                    responsive: true,
                    paging: false,
                    searching: false,
                    info: false,
                    language: {
                        search: "_INPUT_",
                        searchPlaceholder: "Search logs..."
                    },
                    columnDefs: [
                        { orderable: false, targets: [0, 1, 2, 3, 4] }
                    ]
                });
            }

            // Auto-hide alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut('slow');
            }, 5000);

            // Quick filter chips - click to apply filter
            $('.stat-badge').on('click', function() {
                var filter = $(this).data('filter');
                if (filter) {
                    $('input[name="searchTerm"]').val(filter);
                    $('form').submit();
                }
            });
        });
    </script>
}