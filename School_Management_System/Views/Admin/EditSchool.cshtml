@model School_Management_System.Models.SchoolInfo

@{
    ViewData["Title"] = "Edit School";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h1 class="page-title">@ViewData["Title"]</h1>

    <div class="card glassmorphic">
        <div class="card-header">
            <h4 class="card-title">Edit School Info</h4>
        </div>
        <div class="card-body">
            <form asp-action="EditSchool">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="SchoolInfoId" />

                <div class="form-group">
                    <label asp-for="SchoolName" class="control-label">School Name</label>
                    <input asp-for="SchoolName" class="form-control" placeholder="Enter school name" />
                    <span asp-validation-for="SchoolName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Address" class="control-label">Address</label>
                    <input asp-for="Address" class="form-control" placeholder="Enter address" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber" class="control-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="control-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="Enter email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="WebsiteUrl" class="control-label">Website URL</label>
                    <input asp-for="WebsiteUrl" class="form-control" type="url" placeholder="Enter website URL" />
                    <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="SchoolInfo" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<style>
    :root {
        --primary-blue: #0097f8;
        --secondary-blue: #00b5f8;
        --accent-blue: #60a5fa;
        --light-blue: #dbeafe;
        --dark-blue: #1e3a8a;
        --gradient-primary: linear-gradient(135deg, #0097f8 0%, #3b82f6 100%);
        --gradient-secondary: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
        --gradient-success: linear-gradient(135deg, #059669 0%, #10b981 100%);
        --glass-bg: rgba(255, 255, 255, 0.15);
        --glass-border: rgba(255, 255, 255, 0.2);
        --shadow-blue: 0 8px 32px 0 rgba(30, 64, 175, 0.3);
    }

    body {
        background: linear-gradient(135deg, #0097f8 0%, #0097f8 50%, #00b5f8 100%);
        min-height: 100vh;
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        margin: 0;
        padding: 0;
        .container

    {
        margin-top: 20px;
        padding: 20px;
    }

    .page-title {
        font-size: 2rem;
        margin-bottom: 20px;
        text-align: center;
    }

    .card {
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        margin: 20px auto;
        max-width: 600px; /* Limits the width for better alignment */
    }

    .card-header {
        background: rgba(255, 255, 255, 0.8);
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        padding: 15px;
    }

    .card-title {
        margin: 0;
    }

    .card-body {
        background: rgba(255, 255, 255, 0.6);
        padding: 20px;
        border-bottom-left-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    .form-group {
        margin-bottom: 1.5rem; /* Space between form elements */
    }

    .btn {
        width: 100%; /* Full-width buttons for consistency */
    }

    .glassmorphic {
        background: rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .text-danger {
        font-size: 0.9rem;
        margin-top: 0.25rem;
    }
</style>
