@using School_Management_System.ViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* ===== RESET & BASE ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0a0e27;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        /* ===== ANIMATED BACKGROUND ===== */
        .bg-animation {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 0;
            background: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #2d1b69 100%);
            overflow: hidden;
        }

            .bg-animation .orb {
                position: absolute;
                border-radius: 50%;
                filter: blur(80px);
                animation: orbFloat 20s ease-in-out infinite;
            }

                .bg-animation .orb:nth-child(1) {
                    width: 600px;
                    height: 600px;
                    background: rgba(99, 102, 241, 0.15);
                    top: -200px;
                    right: -100px;
                    animation-delay: 0s;
                }

                .bg-animation .orb:nth-child(2) {
                    width: 400px;
                    height: 400px;
                    background: rgba(236, 72, 153, 0.10);
                    bottom: -100px;
                    left: -100px;
                    animation-delay: -5s;
                }

                .bg-animation .orb:nth-child(3) {
                    width: 300px;
                    height: 300px;
                    background: rgba(56, 189, 248, 0.08);
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                    animation-delay: -10s;
                }

       

        /* ===== GRID LINES ===== */
        .grid-lines {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 0;
            background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
            background-size: 60px 60px;
            opacity: 0.5;
        }

        /* ===== LOGIN CONTAINER ===== */
        .login-wrapper {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 440px;
        }

        /* ===== LOGIN CARD ===== */
        .login-card {
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 48px 40px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .login-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 35px 100px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.08);
            }

        /* ===== BRAND ===== */
        .brand {
            text-align: center;
            margin-bottom: 36px;
        }

            .brand .logo {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 72px;
                height: 72px;
                background: linear-gradient(135deg, #6366f1, #8b5cf6);
                border-radius: 18px;
                font-size: 32px;
                color: white;
                margin-bottom: 16px;
                box-shadow: 0 12px 40px rgba(99, 102, 241, 0.3);
                transition: all 0.3s;
            }

                .brand .logo:hover {
                    transform: scale(1.05) rotate(-5deg);
                    box-shadow: 0 16px 50px rgba(99, 102, 241, 0.4);
                }

            .brand h1 {
                color: white;
                font-size: 26px;
                font-weight: 700;
                letter-spacing: -0.5px;
                margin: 0;
            }

            .brand p {
                color: rgba(255, 255, 255, 0.5);
                font-size: 14px;
                font-weight: 400;
                margin: 6px 0 0;
            }

        /* ===== LOADING OVERLAY ===== */
        #loadingOverlay {
            display: none;
            text-align: center;
            padding: 20px 0;
        }

            #loadingOverlay.active {
                display: block;
                animation: fadeIn 0.4s ease;
            }

     

        .loading-spinner-wrapper {
            position: relative;
            width: 64px;
            height: 64px;
            margin: 0 auto 20px;
        }

            .loading-spinner-wrapper .spinner-ring {
                position: absolute;
                width: 100%;
                height: 100%;
                border: 3px solid transparent;
                border-radius: 50%;
                animation: spin 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
            }

                .loading-spinner-wrapper .spinner-ring:nth-child(1) {
                    border-top-color: #6366f1;
                    animation-delay: 0s;
                }

                .loading-spinner-wrapper .spinner-ring:nth-child(2) {
                    border-right-color: #8b5cf6;
                    animation-delay: 0.2s;
                }

                .loading-spinner-wrapper .spinner-ring:nth-child(3) {
                    border-bottom-color: #ec4899;
                    animation-delay: 0.4s;
                }

       

        .loading-text {
            color: rgba(255, 255, 255, 0.7);
            font-size: 14px;
        }

            .loading-text strong {
                color: white;
                font-weight: 600;
            }

            .loading-text .dots span {
                display: inline-block;
                animation: dotPulse 1.4s infinite;
            }

                .loading-text .dots span:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .loading-text .dots span:nth-child(3) {
                    animation-delay: 0.4s;
                }

      
        /* ===== LOGIN FORM ===== */
        .login-form {
            display: block;
        }

            .login-form.hidden {
                display: none;
            }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                color: rgba(255, 255, 255, 0.7);
                font-size: 13px;
                font-weight: 500;
                margin-bottom: 6px;
                letter-spacing: 0.3px;
            }

            .form-group .input-wrapper {
                position: relative;
                display: flex;
                align-items: center;
                background: rgba(255, 255, 255, 0.06);
                border: 1.5px solid rgba(255, 255, 255, 0.08);
                border-radius: 12px;
                transition: all 0.3s;
            }

                .form-group .input-wrapper:focus-within {
                    border-color: #6366f1;
                    background: rgba(255, 255, 255, 0.08);
                    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
                }

                .form-group .input-wrapper .input-icon {
                    padding: 0 0 0 16px;
                    color: rgba(255, 255, 255, 0.3);
                    font-size: 16px;
                    flex-shrink: 0;
                    transition: color 0.3s;
                }

                .form-group .input-wrapper:focus-within .input-icon {
                    color: #6366f1;
                }

                .form-group .input-wrapper input {
                    width: 100%;
                    padding: 14px 16px;
                    background: transparent;
                    border: none;
                    outline: none;
                    color: white;
                    font-size: 15px;
                    font-family: 'Inter', sans-serif;
                    font-weight: 400;
                    transition: all 0.3s;
                }

                    .form-group .input-wrapper input::placeholder {
                        color: rgba(255, 255, 255, 0.25);
                    }

                .form-group .input-wrapper .toggle-password {
                    padding: 0 16px 0 0;
                    background: transparent;
                    border: none;
                    color: rgba(255, 255, 255, 0.3);
                    cursor: pointer;
                    transition: color 0.3s;
                    flex-shrink: 0;
                }

                    .form-group .input-wrapper .toggle-password:hover {
                        color: rgba(255, 255, 255, 0.6);
                    }

            .form-group .validation-error {
                color: #f87171;
                font-size: 12px;
                margin-top: 4px;
                display: block;
            }

        /* ===== REMEMBER ME ===== */
        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 24px 0 28px;
        }

            .form-options .remember-me {
                display: flex;
                align-items: center;
                gap: 10px;
                cursor: pointer;
            }

                .form-options .remember-me input[type="checkbox"] {
                    display: none;
                }

                .form-options .remember-me .checkmark {
                    width: 20px;
                    height: 20px;
                    border: 2px solid rgba(255, 255, 255, 0.2);
                    border-radius: 6px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    transition: all 0.3s;
                    flex-shrink: 0;
                }

                .form-options .remember-me input:checked + .checkmark {
                    background: linear-gradient(135deg, #6366f1, #8b5cf6);
                    border-color: #6366f1;
                }

                    .form-options .remember-me input:checked + .checkmark::after {
                        content: "✓";
                        color: white;
                        font-size: 12px;
                        font-weight: 700;
                    }

                .form-options .remember-me .label {
                    color: rgba(255, 255, 255, 0.6);
                    font-size: 14px;
                    font-weight: 400;
                }

            .form-options .forgot-link {
                color: rgba(255, 255, 255, 0.4);
                font-size: 14px;
                text-decoration: none;
                transition: color 0.3s;
            }

                .form-options .forgot-link:hover {
                    color: #6366f1;
                }

        /* ===== LOGIN BUTTON ===== */
        .btn-login {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 16px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

            .btn-login::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
                transition: left 0.6s;
            }

            .btn-login:hover::before {
                left: 100%;
            }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 40px rgba(99, 102, 241, 0.35);
            }

            .btn-login:active {
                transform: translateY(0);
            }

            .btn-login:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none !important;
            }

            .btn-login .btn-text {
                display: inline-flex;
                align-items: center;
                gap: 10px;
            }

                .btn-login .btn-text i {
                    font-size: 18px;
                }

            .btn-login .spinner {
                display: none;
                width: 22px;
                height: 22px;
                border: 2.5px solid rgba(255,255,255,0.2);
                border-top-color: white;
                border-radius: 50%;
                animation: spin 0.8s linear infinite;
                margin: 0 auto;
            }

            .btn-login.loading .btn-text {
                display: none;
            }

            .btn-login.loading .spinner {
                display: block;
            }

        /* ===== VALIDATION SUMMARY ===== */
        .validation-summary-errors {
            background: rgba(248, 113, 113, 0.1);
            border: 1px solid rgba(248, 113, 113, 0.2);
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 20px;
            color: #f87171;
            font-size: 14px;
        }

            .validation-summary-errors ul {
                margin: 0;
                padding-left: 20px;
            }

        /* ===== FOOTER ===== */
        .login-footer {
            text-align: center;
            margin-top: 28px;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

            .login-footer .security-badge {
                color: rgba(255, 255, 255, 0.3);
                font-size: 13px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
            }

                .login-footer .security-badge i {
                    font-size: 14px;
                }

            .login-footer .demo-credentials {
                margin-top: 12px;
                color: rgba(255, 255, 255, 0.2);
                font-size: 12px;
            }

                .login-footer .demo-credentials code {
                    background: rgba(255, 255, 255, 0.05);
                    padding: 2px 10px;
                    border-radius: 4px;
                    font-size: 12px;
                    color: rgba(255, 255, 255, 0.4);
                }

     

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: rgba(255, 255, 255, 0.2);
            }
    </style>
</head>
<body>
    <!-- ===== ANIMATED BACKGROUND ===== -->
    <div class="bg-animation">
        <div class="orb"></div>
        <div class="orb"></div>
        <div class="orb"></div>
    </div>
    <div class="grid-lines"></div>

    <!-- ===== LOGIN ===== -->
    <div class="login-wrapper">
        <div class="login-card">
            <!-- Brand -->
            <div class="brand">
                <div class="logo">🏫</div>
                <h1>School Management</h1>
                <p>Secure access to your dashboard</p>
            </div>

            <!-- ===== LOADING OVERLAY ===== -->
            <div id="loadingOverlay">
                <div class="loading-spinner-wrapper">
                    <div class="spinner-ring"></div>
                    <div class="spinner-ring"></div>
                    <div class="spinner-ring"></div>
                </div>
                <div class="loading-text">
                    <strong>Logging you in</strong>
                    <span class="dots">
                        <span>.</span><span>.</span><span>.</span>
                    </span>
                    <p style="margin-top: 6px; font-size: 13px; color: rgba(255,255,255,0.4);">
                        Please wait while we verify your credentials
                    </p>
                </div>
            </div>

            <!-- ===== LOGIN FORM ===== -->
            <div class="login-form" id="loginFormContainer">
                <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <!-- Email -->
                    <div class="form-group">
                        <label asp-for="Email">Email Address</label>
                        <div class="input-wrapper">
                            <span class="input-icon"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Email" placeholder="name@example.com" required id="EmailInput" />
                        </div>
                        <span asp-validation-for="Email" class="validation-error"></span>
                    </div>

                    <!-- Password -->
                    <div class="form-group">
                        <label asp-for="Password">Password</label>
                        <div class="input-wrapper">
                            <span class="input-icon"><i class="fas fa-lock"></i></span>
                            <input asp-for="Password" type="password" placeholder="Enter your password" required id="PasswordInput" />
                            <button type="button" class="toggle-password" id="togglePassword">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="validation-error"></span>
                    </div>

                    <!-- Options -->
                    <div class="form-options">
                        <label class="remember-me">
                            <input asp-for="RememberMe" />
                            <span class="checkmark"></span>
                            <span class="label">Remember me</span>
                        </label>
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="btn-login" id="loginBtn">
                        <span class="btn-text">
                            <i class="fas fa-arrow-right"></i> Sign In
                        </span>
                        <span class="spinner"></span>
                    </button>
                </form>
            </div>

            <!-- Footer -->
            <div class="login-footer">
                <div class="security-badge">
                    <i class="fas fa-shield-alt"></i>
                    <span>256-bit encrypted connection</span>
                    <span style="opacity:0.3;">•</span>
                    <i class="fas fa-lock"></i>
                    <span>Cookie-based authentication</span>
                </div>
                <div class="demo-credentials">
                    <span>Demo: </span>
                    <code>admin@school.com</code>
                    <span style="opacity:0.3; margin: 0 4px;">•</span>
                    <code>Admin@123</code>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== SCRIPTS ===== -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            // Auto-focus on email
            $('#EmailInput').focus();

            // ===== PASSWORD TOGGLE =====
            $('#togglePassword').click(function() {
                const passwordField = $('#PasswordInput');
                const eyeIcon = $('#eyeIcon');

                if (passwordField.attr('type') === 'password') {
                    passwordField.attr('type', 'text');
                    eyeIcon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    passwordField.attr('type', 'password');
                    eyeIcon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // ===== LOADING STATE =====
            $('#loginForm').on('submit', function(e) {
                const email = $('#EmailInput').val().trim();
                const password = $('#PasswordInput').val().trim();

                if (!email || !password) {
                    e.preventDefault();
                    return false;
                }

                // Show loading
                const loginBtn = $('#loginBtn');
                const loadingOverlay = $('#loadingOverlay');
                const loginFormContainer = $('#loginFormContainer');

                loginBtn.prop('disabled', true);
                loginBtn.addClass('loading');
                loginFormContainer.addClass('hidden');
                loadingOverlay.addClass('active');

                return true;
            });

            // ===== RESET ON BACK BUTTON =====
            window.addEventListener('pageshow', function(event) {
                if (event.persisted) {
                    const loginBtn = $('#loginBtn');
                    const loadingOverlay = $('#loadingOverlay');
                    const loginFormContainer = $('#loginFormContainer');

                    loginBtn.prop('disabled', false);
                    loginBtn.removeClass('loading');
                    loadingOverlay.removeClass('active');
                    loginFormContainer.removeClass('hidden');
                }
            });

            // ===== KEYBOARD SHORTCUT: Enter to submit =====
            $('#PasswordInput, #EmailInput').on('keypress', function(e) {
                if (e.which === 13) {
                    $('#loginForm').submit();
                }
            });
        });
    </script>
</body>
</html>