@using School_Management_System.ViewModels
@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ============================================
               MODERN CHANGE PASSWORD STYLES
               ============================================ */

    /* ----- Animations ----- */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes floatOrb {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(30px, -30px) scale(1.1);
        }
    }

    @@keyframes shine {
        0% {
            background-position: -200% center;
        }

        100% {
            background-position: 200% center;
        }
    }

    .animate-in {
        animation: fadeInUp 0.6s ease forwards;
        opacity: 0;
    }

        .animate-in.delay-1 {
            animation-delay: 0.1s;
        }

        .animate-in.delay-2 {
            animation-delay: 0.2s;
        }

        .animate-in.delay-3 {
            animation-delay: 0.3s;
        }

        .animate-in.delay-4 {
            animation-delay: 0.4s;
        }

        .animate-in.delay-5 {
            animation-delay: 0.5s;
        }

    /* ----- Page Container ----- */
    .password-page-wrapper {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
        position: relative;
        overflow: hidden;
    }

        .password-page-wrapper::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.05);
            animation: floatOrb 10s ease-in-out infinite;
        }

        .password-page-wrapper::after {
            content: '';
            position: absolute;
            bottom: -30%;
            left: -10%;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: rgba(236, 72, 153, 0.04);
            animation: floatOrb 12s ease-in-out infinite reverse;
        }

    /* ----- Main Card ----- */
    .password-card-modern {
        position: relative;
        z-index: 1;
        border: none;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        background: white;
        width: 100%;
        max-width: 520px;
        transition: all 0.3s ease;
    }

        .password-card-modern:hover {
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.12);
        }

    /* ----- Card Header ----- */
    .password-card-header {
        background: linear-gradient(135deg, #0a0e27 0%, #1a1a3e 50%, #2d1b69 100%);
        padding: 32px 32px 28px;
        position: relative;
        overflow: hidden;
    }

        .password-card-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.1);
            animation: floatOrb 8s ease-in-out infinite;
        }

        .password-card-header .header-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 16px;
            position: relative;
            z-index: 1;
        }

        .password-card-header h4 {
            color: white;
            font-weight: 700;
            margin: 0;
            font-size: 1.5rem;
            position: relative;
            z-index: 1;
        }

        .password-card-header p {
            color: rgba(255, 255, 255, 0.6);
            margin: 6px 0 0;
            font-size: 0.9rem;
            position: relative;
            z-index: 1;
        }

    /* ----- Card Body ----- */
    .password-card-body {
        padding: 32px 32px 36px;
    }

    /* ----- Form Groups ----- */
    .form-group-modern {
        margin-bottom: 24px;
    }

        .form-group-modern:last-of-type {
            margin-bottom: 28px;
        }

    .form-label-modern {
        display: block;
        font-weight: 600;
        font-size: 0.85rem;
        color: #374151;
        margin-bottom: 8px;
    }

        .form-label-modern .label-icon {
            margin-right: 8px;
            color: #6366f1;
        }

        .form-label-modern .required-star {
            color: #ef4444;
            margin-left: 4px;
        }

    .input-group-modern {
        position: relative;
    }

        .input-group-modern .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 0.9rem;
            z-index: 2;
            transition: all 0.3s ease;
        }

        .input-group-modern .form-control-modern {
            width: 100%;
            padding: 12px 16px 12px 44px;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: #fafbfc;
            color: #1f2937;
            height: 50px;
        }

            .input-group-modern .form-control-modern:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
                background: white;
                outline: none;
            }

                .input-group-modern .form-control-modern:focus + .input-icon {
                    color: #6366f1;
                }

            .input-group-modern .form-control-modern[readonly] {
                background: #f3f4f6;
                color: #6b7280;
                cursor: not-allowed;
                opacity: 0.8;
            }

            .input-group-modern .form-control-modern.is-valid {
                border-color: #22c55e;
                background: #f0fdf4;
            }

            .input-group-modern .form-control-modern.is-invalid {
                border-color: #ef4444;
                background: #fef2f2;
            }

        .input-group-modern .password-toggle {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #9ca3af;
            cursor: pointer;
            font-size: 0.9rem;
            z-index: 2;
            transition: all 0.3s ease;
            padding: 4px 8px;
        }

            .input-group-modern .password-toggle:hover {
                color: #6366f1;
            }

        .input-group-modern .form-control-modern {
            padding-right: 44px;
        }

    /* ----- Validation Messages ----- */
    .validation-message {
        font-size: 0.8rem;
        margin-top: 6px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .validation-message.text-danger {
            color: #ef4444;
        }

        .validation-message.text-success {
            color: #22c55e;
        }

    /* ----- Password Strength Indicator ----- */
    .password-strength {
        margin-top: 10px;
    }

        .password-strength .strength-bar {
            height: 4px;
            border-radius: 4px;
            background: #e5e7eb;
            overflow: hidden;
            margin-top: 8px;
        }

            .password-strength .strength-bar .strength-fill {
                height: 100%;
                border-radius: 4px;
                transition: all 0.5s ease;
                width: 0%;
            }

        .password-strength .strength-text {
            font-size: 0.75rem;
            color: #6b7280;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    .password-requirements {
        margin-top: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
    }

        .password-requirements .requirement {
            font-size: 0.7rem;
            color: #6b7280;
            display: flex;
            align-items: center;
            gap: 4px;
            transition: all 0.3s ease;
        }

            .password-requirements .requirement .req-icon {
                font-size: 0.6rem;
                transition: all 0.3s ease;
            }

            .password-requirements .requirement.met {
                color: #22c55e;
            }

                .password-requirements .requirement.met .req-icon {
                    color: #22c55e;
                }

            .password-requirements .requirement.unmet .req-icon {
                color: #9ca3af;
            }

    /* ----- Buttons ----- */
    .btn-modern {
        padding: 12px 32px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 120px;
    }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        .btn-modern:active {
            transform: translateY(0);
        }

    .btn-primary-modern {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: white;
    }

        .btn-primary-modern:hover {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            box-shadow: 0 8px 25px rgba(99, 102, 241, 0.35);
        }

    .btn-secondary-modern {
        background: #f3f4f6;
        color: #4b5563;
    }

        .btn-secondary-modern:hover {
            background: #e5e7eb;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        }

    .btn-group-modern {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

        .btn-group-modern .btn-modern {
            flex: 1;
            min-width: 100px;
        }

    @@media (max-width: 480px) {
        .btn-group-modern .btn-modern

    {
        flex: 1 1 100%;
    }

    }

    /* ----- Validation Summary ----- */
    .validation-summary-modern {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 20px;
        color: #dc2626;
        font-size: 0.9rem;
    }

        .validation-summary-modern ul {
            margin: 4px 0 0;
            padding-left: 20px;
        }

    /* ----- Success Message ----- */
    .success-message {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 16px 20px;
        color: #16a34a;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        animation: fadeInUp 0.5s ease;
    }

        .success-message i {
            font-size: 1.2rem;
        }

    /* ----- Responsive ----- */
    @@media (max-width: 576px) {
        .password-card-header

    {
        padding: 24px 20px 20px;
    }

    .password-card-header h4 {
        font-size: 1.2rem;
    }

    .password-card-body {
        padding: 24px 20px 28px;
    }

    .input-group-modern .form-control-modern {
        padding: 10px 14px 10px 40px;
        font-size: 0.9rem;
        height: 46px;
    }

    .btn-modern {
        padding: 10px 20px;
        font-size: 0.85rem;
        min-width: 100px;
    }

    .password-requirements {
        flex-direction: column;
        gap: 4px;
    }

    }

    @@media (max-width: 400px) {
        .password-card-body

    {
        padding: 20px 16px 24px;
    }

    .form-group-modern {
        margin-bottom: 18px;
    }

    .input-group-modern .form-control-modern {
        padding: 8px 12px 8px 36px;
        font-size: 0.85rem;
        height: 42px;
    }

    .input-group-modern .input-icon {
        left: 10px;
        font-size: 0.8rem;
    }

    }
</style>

<!-- ============================================
     PAGE WRAPPER
     ============================================ -->
<div class="password-page-wrapper">
    <div class="password-card-modern animate-in">
        <!-- Header -->
        <div class="password-card-header">
            <div class="header-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h4>Change Password</h4>
            <p>Keep your account secure with a strong password</p>
        </div>

        <!-- Body -->
        <div class="password-card-body">
            <form method="post" id="changePasswordForm">
                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary-modern animate-in delay-1">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <span>Please fix the following errors:</span>
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <!-- Email -->
                <div class="form-group-modern animate-in delay-2">
                    <label asp-for="Email" class="form-label-modern">
                        <i class="fas fa-envelope label-icon"></i>Email Address
                    </label>
                    <div class="input-group-modern">
                        <i class="fas fa-envelope input-icon"></i>
                        <input asp-for="Email" class="form-control-modern" readonly />
                    </div>
                    <span asp-validation-for="Email" class="validation-message text-danger"></span>
                </div>

                <!-- Current Password -->
                <div class="form-group-modern animate-in delay-3">
                    <label asp-for="CurrentPassword" class="form-label-modern">
                        <i class="fas fa-key label-icon"></i>Current Password
                        <span class="required-star">*</span>
                    </label>
                    <div class="input-group-modern">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="CurrentPassword" class="form-control-modern" type="password" id="CurrentPassword" placeholder="Enter your current password" />
                        <button type="button" class="password-toggle" onclick="togglePassword('CurrentPassword', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="validation-message text-danger"></span>
                </div>

                <!-- New Password -->
                <div class="form-group-modern animate-in delay-4">
                    <label asp-for="NewPassword" class="form-label-modern">
                        <i class="fas fa-shield-alt label-icon"></i>New Password
                        <span class="required-star">*</span>
                    </label>
                    <div class="input-group-modern">
                        <i class="fas fa-key input-icon"></i>
                        <input asp-for="NewPassword" class="form-control-modern" type="password" id="NewPassword" placeholder="Enter a strong password" />
                        <button type="button" class="password-toggle" onclick="togglePassword('NewPassword', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" class="validation-message text-danger"></span>

                    <!-- Password Strength Indicator -->
                    <div class="password-strength" id="passwordStrength" style="display: none;">
                        <div class="strength-text">
                            <span>Password Strength</span>
                            <span id="strengthLabel">Weak</span>
                        </div>
                        <div class="strength-bar">
                            <div class="strength-fill" id="strengthFill" style="width: 0%;"></div>
                        </div>
                        <div class="password-requirements">
                            <span class="requirement unmet" id="reqLength">
                                <i class="fas fa-circle req-icon"></i> 8+ characters
                            </span>
                            <span class="requirement unmet" id="reqUpper">
                                <i class="fas fa-circle req-icon"></i> Uppercase letter
                            </span>
                            <span class="requirement unmet" id="reqLower">
                                <i class="fas fa-circle req-icon"></i> Lowercase letter
                            </span>
                            <span class="requirement unmet" id="reqNumber">
                                <i class="fas fa-circle req-icon"></i> Number
                            </span>
                            <span class="requirement unmet" id="reqSpecial">
                                <i class="fas fa-circle req-icon"></i> Special character
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="form-group-modern animate-in delay-5">
                    <label asp-for="ConfirmPassword" class="form-label-modern">
                        <i class="fas fa-check-circle label-icon"></i>Confirm Password
                        <span class="required-star">*</span>
                    </label>
                    <div class="input-group-modern">
                        <i class="fas fa-check-circle input-icon"></i>
                        <input asp-for="ConfirmPassword" class="form-control-modern" type="password" id="ConfirmPassword" placeholder="Confirm your new password" />
                        <button type="button" class="password-toggle" onclick="togglePassword('ConfirmPassword', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="validation-message text-danger"></span>
                    <span id="confirmMatch" class="validation-message" style="display: none;"></span>
                </div>

                <!-- Buttons -->
                <div class="btn-group-modern animate-in delay-5">
                    <button type="submit" class="btn-modern btn-primary-modern">
                        <i class="fas fa-save"></i> Update Password
                    </button>
                    <a href="javascript:history.back()" class="btn-modern btn-secondary-modern">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================
     SCRIPTS
     ============================================ -->
@section Scripts {
    <script>
        $(document).ready(function() {
            // ============================================
            // PASSWORD STRENGTH INDICATOR
            // ============================================
            $('#NewPassword').on('keyup', function() {
                var password = $(this).val();
                if (password.length > 0) {
                    $('#passwordStrength').show();
                    checkPasswordStrength(password);
                } else {
                    $('#passwordStrength').hide();
                }
            });

            function checkPasswordStrength(password) {
                var strength = 0;
                var requirements = {
                    length: password.length >= 8,
                    upper: /[A-Z]/.test(password),
                    lower: /[a-z]/.test(password),
                    number: /[0-9]/.test(password),
                    special: /[^A-Za-z0-9]/.test(password)
                };

                // Update requirement indicators
                updateRequirement('reqLength', requirements.length);
                updateRequirement('reqUpper', requirements.upper);
                updateRequirement('reqLower', requirements.lower);
                updateRequirement('reqNumber', requirements.number);
                updateRequirement('reqSpecial', requirements.special);

                // Calculate strength
                Object.values(requirements).forEach(function(met) {
                    if (met) strength++;
                });

                var percentage = (strength / 5) * 100;
                var color, label;

                if (strength <= 1) {
                    color = '#ef4444';
                    label = 'Weak';
                } else if (strength <= 2) {
                    color = '#f59e0b';
                    label = 'Fair';
                } else if (strength <= 3) {
                    color = '#f59e0b';
                    label = 'Good';
                } else if (strength <= 4) {
                    color = '#22c55e';
                    label = 'Strong';
                } else {
                    color = '#22c55e';
                    label = 'Very Strong';
                }

                $('#strengthFill').css({
                    'width': percentage + '%',
                    'background': color
                });

                $('#strengthLabel').text(label).css('color', color);
            }

            function updateRequirement(elementId, met) {
                var element = $('#' + elementId);
                if (met) {
                    element.removeClass('unmet').addClass('met');
                    element.find('.req-icon').removeClass('fa-circle').addClass('fa-check-circle');
                } else {
                    element.removeClass('met').addClass('unmet');
                    element.find('.req-icon').removeClass('fa-check-circle').addClass('fa-circle');
                }
            }

            // ============================================
            // PASSWORD CONFIRMATION MATCH
            // ============================================
            function checkPasswordMatch() {
                var newPassword = $('#NewPassword').val();
                var confirmPassword = $('#ConfirmPassword').val();
                var confirmField = $('#ConfirmPassword');
                var matchMessage = $('#confirmMatch');

                if (confirmPassword.length > 0) {
                    if (newPassword === confirmPassword) {
                        confirmField.removeClass('is-invalid').addClass('is-valid');
                        matchMessage.show()
                            .removeClass('text-danger')
                            .addClass('text-success')
                            .html('<i class="fas fa-check-circle"></i> Passwords match!');
                    } else {
                        confirmField.removeClass('is-valid').addClass('is-invalid');
                        matchMessage.show()
                            .removeClass('text-success')
                            .addClass('text-danger')
                            .html('<i class="fas fa-exclamation-circle"></i> Passwords do not match');
                    }
                } else {
                    confirmField.removeClass('is-valid is-invalid');
                    matchMessage.hide();
                }
            }

            $('#ConfirmPassword').on('keyup', checkPasswordMatch);

            // ============================================
            // TOGGLE PASSWORD VISIBILITY
            // ============================================
            window.togglePassword = function(fieldId, button) {
                var field = document.getElementById(fieldId);
                var icon = button.querySelector('i');

                if (field.type === 'password') {
                    field.type = 'text';
                    icon.className = 'fas fa-eye-slash';
                } else {
                    field.type = 'password';
                    icon.className = 'fas fa-eye';
                }
            };

            // ============================================
            // FORM VALIDATION ON SUBMIT
            // ============================================
            $('#changePasswordForm').on('submit', function(e) {
                var isValid = true;
                var newPassword = $('#NewPassword').val();
                var confirmPassword = $('#ConfirmPassword').val();

                if (newPassword !== confirmPassword) {
                    e.preventDefault();
                    $('#ConfirmPassword').addClass('is-invalid');
                    $('#confirmMatch').show()
                        .removeClass('text-success')
                        .addClass('text-danger')
                        .html('<i class="fas fa-exclamation-circle"></i> Passwords do not match');
                    isValid = false;
                }

                if (!isValid) {
                    // Scroll to the first error
                    $('html, body').animate({
                        scrollTop: $('.is-invalid').first().offset().top - 100
                    }, 300);
                }

                return isValid;
            });

            // ============================================
            // KEYBOARD SHORTCUTS
            // ============================================
            $(document).on('keydown', function(e) {
                // Ctrl+Enter to submit
                if (e.ctrlKey && e.key === 'Enter') {
                    $('#changePasswordForm').submit();
                }
            });
        });
    </script>
}